@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "بازیابی کلمه‌ی عبور فراموش شده";
    Layout = "_LayoutLogin";
}

<!--Forgot Password Starts-->
<section id="forgot-password" class="auth-height">
    <div class="row full-height-vh m-0 d-flex align-items-center justify-content-center">
        <div class="col-md-7 col-12">
            <div class="card overflow-hidden">
                <div class="card-content">
                    <div class="card-body auth-img">
                        <div class="row m-0">
                            <div class="col-lg-6 d-none d-lg-flex justify-content-center align-items-center text-center auth-img-bg py-2">
                                <img src="~/assets/img/gallery/forgot.png" alt="" class="img-fluid" width="260" height="230">
                            </div>
                            <div class="col-lg-6 col-12 px-4 py-3">
                                <form asp-area="@AreaConstants.IdentityArea" asp-controller="ForgotPassword" asp-action="Index" method="post"
                                      autocomplete="off">


                                    @{ await Html.RenderPartialAsync("_CustomValidationSummary").ConfigureAwait(false); }
                                    <h4 class="mb-2 card-title my-font-bold"> @ViewData["Title"]</h4>
                                    <p></p>
                                    <div class="row">
                                        <div class="col-md-12 col-12">
                                            <div class="form-group">
                                                <label asp-for="Email"></label><i class="ft-star danger my-font-bold"></i>
                                                <input asp-for="Email" class="form-control mb-3 my-font ltr "placeholder=" ایمیل" />
                                                <span asp-validation-for="Email" class="danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between flex-sm-row flex-column">
                                        <a asp-area="@AreaConstants.IdentityArea" asp-action="Index" asp-controller="Login" class=" btn btn-secondary bg-light-secondary mb-1 my-font">انصراف</a>
                                        <button type="submit" class="btn btn-info bg-light-info mb-1 my-font">ارسال</button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--Forgot Password Ends-->