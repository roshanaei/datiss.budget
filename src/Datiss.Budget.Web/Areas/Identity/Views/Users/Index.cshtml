@model UsersIndexViewModel
@{
    ViewData["Title"] = "مدیریت کاربران سیستم";
}

<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">

                <div class="card-content">
                    <div class="card-body">
                        <form id="filterForm"
                            asp-controller="@UsersController.Name"
                            asp-action="@UsersController.ACTION_Index"
                            method="POST"
                            asp-asp-antiforgery="true">
                            <input type="hidden" asp-for="Filter.Columns" id="hidColumns">
                            <div class="rowACJSB">
                                <fieldset class="form-group mt-3">
                                    <label asp-for="Filter.OrganizationId" class="my-font">
                                        سازمان:
                                        <select asp-for="Filter.OrganizationId"
                                                asp-items="Model.Filter.OrganizationSource"
                                                class="form-control d-inline-block width-100"
                                                id="organizationId">
                                        </select>
                                    </label>
                                    <label asp-for="Filter.OrganizationId" class="my-font" style="margin-right:20px">
                                        سمت:
                                        <select asp-for="Filter.PositionId"
                                                asp-items="Model.Filter.PositionSource"
                                                class="form-control d-inline-block width-300"
                                                id="positionId">
                                        </select>
                                    </label>
                                    <label asp-for="Filter.OrganizationId" class="my-font" style="margin-right:20px">
                                        وضعیت:
                                        <select asp-for="Filter.Status"
                                                asp-items="Model.Filter.StatusSource"
                                                class="form-control d-inline-block width-300"
                                                id="statusId">
                                        </select>
                                    </label>
                                    <input asp-for="Filter.OrderBy" type="hidden" />
                                    <input asp-for="Filter.OrderDesc" type="hidden" />
                                </fieldset>
                                <fieldset>
                                    <div class="rowACJE">
                                        
                                        <button data-toggle="tooltip" data-placement="top" title="فیلتر" type="submit" name="btnFilter" class="btn btn-info bg-light-info  mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-filter"></i>
                                        </button>
                                        <button id="btnCreate" data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" class="btn btn-success bg-light-success my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
                                        </button>
                                    </div>
                                </fieldset>
                            </div>
                            <hr />
                             <fieldset class="form-group position-relative has-icon-left">
                                <input asp-for="Filter.Search" id="ngx-filter-ref" type="text" placeholder="جستجو..." class="form-control-lg form-control d-inline-block my-custom-input my-font">
                                <div class="form-control-position">
                                    <i class="ft-search font-medium-4"></i>
                                </div>
                            </fieldset>
                            <!--SearchBox-->
                            <div class="rowACJSB">
                                <div class="d-flex flex-row-reverse align-items-center">

                                    <fieldset class="form-group" style="margin-right:20px">
                                        <label class="my-font rowAC">
                                            <span>نمایش</span>

                                            <select asp-for="Filter.PageSize"
                                                    style="margin-right:10px"
                                                    class="form-control"
                                                    onchange="changePageSize();"
                                                    id="ddlPageSize">
                                                <option>10</option>
                                                <option>20</option>
                                                <option>30</option>
                                            </select>
                                            <span style="margin-right:10px">رکورد</span>

                                        </label>

                                    </fieldset>
                                    @* drop down menu *@
                                    <div class="btn-group dropdown form-group">
                                        <button type="button"
                                                class="btn btn-light my-font dropdown-toggle"
                                                data-toggle="dropdown"
                                                aria-haspopup="true"
                                                aria-expanded="false">
                                            ستون ها
                                        </button>
                                        <div class="dropdown-menu" style="width:150%">
                                            <div id="columnSelector">
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-1"
                                                               id="col-1" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-1"><span>نام کاربری</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-2"
                                                               id="col-2" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-2"><span>نام</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-3"
                                                               id="col-3" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-3"><span>نام خانوادگی</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-4"
                                                               id="col-4" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-4"><span>کد ملی</span></label>
                                                    </div>
                                                </div>
                                                 <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-5"
                                                               id="col-5" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-5"><span>سازمان</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-6"
                                                               id="col-6" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-6"><span>شماره تماس</span></label>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <fieldset>
                                    <div class="rowACJE">
                                        <button data-toggle="tooltip" data-placement="top" title="به روز رسانی داده ها" type="submit" name="btnRefreshTable" class="btn btn-info bg-light-info  mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-refresh"></i>
                                        </button>
                                        <a data-toggle="tooltip" data-placement="top" title="دانلود اطلاعات جدول" name="btnExportExcel" asp-action="ExportExcel" asp-route-orgid="@Model.Filter.OrganizationId" asp-route-yearid="@Model.Filter.PositionId" class="btn btn-secondary bg-light-secondary mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa ft-database"></i>
                                        </a>
                                        <a data-toggle="tooltip" data-placement="top" title="دانلود فرمت اکسل" class="btn btn-warning bg-light-warning my-font"
                                            asp-asp-controller="@UsersController.Name"
                                            asp-action="@UsersController.ACTION_Index"
                                            asp-route-yearId="@Model.Filter.PositionId" 
                                            asp-route-orgId="@Model.Filter.OrganizationId">
                                            <i _ngcontent-dpj-c129="" class="fa ft-download-cloud"></i>
                                        </a>
                                    </div>
                                </fieldset>
                            </div>
                        </form>

                        <partial name="_table" model="Model" />

                    </div>
                </div>
            </div>
        </div>
    </div>

</section>



@section headSection {
    <link href="~/assets/vendors/css/select2.min.css" rel="stylesheet" />
    <script type="text/javascript" src="~/assets/vendors/js/select2.full.min.js"></script>
}

@section footSection {
    <div id="divCreate">

    </div>
    
    <script type="text/javascript">
        let allColumns = '1,2,3,4,5,6';
        let columnIndices = allColumns.split(',');
        console.log(columnIndices);
        let showingColmuns = "1,2,3,4,5,6";
    </script>

    @if(Model.Filter.Columns.IsNotNullOrEmpty()) {
        <script type="text/javascript">
            showingColmuns = '@Model.Filter.Columns' ;
        </script>
    }

    <script type="text/javascript">
        $(document).ready(function() {
            //fill input hidden with initial columns showing
            document.getElementById("hidColumns").value = showingColmuns;

            //setDataColumns();

            $('#organizationId').select2({
                dir: 'rtl'
            });

            $('#positionId').select2({
                dir: 'rtl'
            });

            $(".dropdown-menu").click(function (e) {
                e.stopPropagation();
            });

            $("#columnSelector input:checkbox:checked").change(function () {
                let index = parseInt($(this)[0].id.split('-')[1]);
                console.log(`showing or hiding col : ${index}`);
                let checked = $(this)[0].checked;
                if (checked) {
                    $(`th:nth-child(${index}), tr td:nth-child(${index})`).show();
                    showingColmuns = showingColmuns + `${index},`
                    document.getElementById("hidColumns").value = showingColmuns ;
                } else {
                    $(`th:nth-child(${index}), tr td:nth-child(${index})`).hide();
                    showingColmuns = showingColmuns.replace(`${index},`, '');
                    document.getElementById("hidColumns").value = showingColmuns;
                }
            });

            $('#btnCreate').on('click', function() {
                openCreate();
            });

        });


        function setDataColumns() {
            let columnsToShow = document.getElementById("hidColumns").value.split(',');
            console.log('ColumnsToShow ');
            console.log(columnsToShow);
            let checkBoxes = $("#columnSelector input:checkbox");
            for(let i = 0; i < columnIndices.length; i++) {
                let index = parseInt(columnIndices[i]);
                let showColumn = columnsToShow.indexOf(columnIndices[i]) !== -1;
                console.log(`Column : ${index} show = ${showColumn}`);
                checkBoxes[i].checked = showColumn;
                if(showColumn)
                    $(`th:nth-child(${index}), tr td:nth-child(${index})`).show();
                else
                    $(`th:nth-child(${index}), tr td:nth-child(${index})`).hide();
            }
        }

        function resetDataColumns() {
            $('th,tr td').show();
            let inputs = $("#columnSelector input:checkbox");
            for (let i = 0; i < inputs.length; i++) {
                inputs[i].checked = true
            }
        }

        function openCreate() {
            let div = document.getElementById('divCreate');
            console.log(div);
            $.ajax({
                type: 'GET',
                url: '@Url.Action("Create")',
                success: function(data, status, settings) {
                    $(div).html('');
                    $(div).html(data);
                    $('#OrganizationId').select2({
                        dir: 'rtl'
                    });
                    let mymodal = document.getElementById('modalCreateUser');
                    $(mymodal).modal('show');
                    $(mymodal).on('hidden.bs.modal', function() {
                        $(div).html('');
                        $('.modal-backdrop').remove();
                    });
                },
                error: function(request, options, err) {

                }
            })
        }


        function createUser() {
            var model = {};
            model.firstName = $('#FirstName').val();
            model.lastName = $('#LastName').val();
            model.userName = $('#UserName').val();
            model.nationalCode = $('#NationalCode').val();
            model.organizationId = $('#OrganizationId option:selected').val();
            model.positionId = $('#PositionId option:selected').val();
            model.email = $('#Email').val();
            model.phoneNumber = $('#phoneNumber').val();

            console.log(model);

        }

        function numberOnly(id) {
            var element = document.getElementById(id);
            element.value = element.value.replace(/[^0-9]/gi, "");
        }

    </script>


}
