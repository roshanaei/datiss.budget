@inject IOptionsSnapshot<SiteSettings> SiteOptions
<!DOCTYPE html>
<html class="loading" lang="fa">
<!-- BEGIN : Head-->

<head>
    <title>@ViewData["Title"]</title>
    <link rel="shortcut icon"
          type="image/x-icon"
          href="../assets/img/ico/favicon.ico" />
    <link rel="shortcut icon"
          type="image/png"
          href="../assets/img/ico/favicon-32.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,700,900%7CMontserrat:300,400,500,600,700,800,900"
          rel="stylesheet" />

    <link rel="stylesheet"
          type="text/css"
          href="../assets/css-rtl/bootstrap.css" />
    <link rel="stylesheet"
          type="text/css"
          href="../assets/css-rtl/bootstrap-extended.css" />
    <link rel="stylesheet"
          type="text/css"
          href="../assets/css-rtl/colors.css" />
    <link rel="stylesheet"
          type="text/css"
          href="../assets/css-rtl/components.css" />
    <link rel="stylesheet"
          type="text/css"
          href="../assets/css-rtl/custom-rtl.css" />
    <link rel="stylesheet"
          type="text/css"
          href="../assets/css-rtl/custom-fonts.css" />
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v29.1.0/dist/font-face.css"
          rel="stylesheet"
          type="text/css" />

    <link rel="stylesheet" href="../assets/css-rtl/pages/authentication.css" />

    @RenderSection("headSection", false)
</head>
<!-- END : Head-->
<!-- BEGIN : Body-->
<body class="vertical-layout vertical-menu 1-column auth-page navbar-sticky blank-page" data-menu="vertical-menu" data-col="1-column">



    <!-- ////////////////////////////////////////////////////////////////////////////-->
    <div class="wrapper">
        <div class="main-panel">
            <!-- BEGIN : Main Content-->
            <div class="main-content">
                <div class="content-overlay"></div>
                <div class="content-wrapper">
                    @RenderBody()

                </div>
            </div>
            <!-- END : End Main Content-->
        </div>
    </div>
    <!-- ////////////////////////////////////////////////////////////////////////////-->
    <!-- BEGIN VENDOR JS-->
    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <script src="~/assets/vendors/js/switchery.min.js"></script>
    <!-- BEGIN VENDOR JS-->
    <!-- BEGIN PAGE VENDOR JS-->
    <!-- END PAGE VENDOR JS-->
    <!-- BEGIN APEX JS-->
    <!-- END APEX JS-->
    <!-- BEGIN PAGE LEVEL JS-->
    <!-- END PAGE LEVEL JS-->
    @RenderSection("footSection", false)
</body>
<!-- END : Body-->

</html>