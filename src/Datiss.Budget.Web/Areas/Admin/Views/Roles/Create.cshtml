@model CreateRoleViewModel
@{
    ViewData["Title"] = "تعریف نقش جدید";
}

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title my-font">
                        <i class="fa fa-plus"></i> @ViewData["Title"]
                    </h5>
                </div>
                <div class="card-content">
                    <div class="card-body" dir="rtl">
                        @if (Model._HasError) {
                            <div class="alert alert-danger" role="alert">
                                <a href="#" class="close" data-dismiss="alert">×</a>
                                @Html.Raw(Model._ErrorMessage)
                            </div>
                        }
                        <form id="my-form"
                              novalidate
                              asp-controller="@RolesController.Name"
                              asp-action="@RolesController.ACTION_Create"
                              method="POST">
                            
                            <div class="row form-group">
                                        <div class="col-3">
                                            <label class="col-form-label my-font">
                                                عنوان
                                            </label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" asp-for="Title" placeholder="عنوان نقش" class="form-control my-font"/>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-3">
                                            <label class="col-form-label my-font">
                                                نام انگلیسی نقش
                                            </label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" asp-for="Name" dir="ltr" placeholder="نام نقش" class="form-control my-font"/>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-3">
                                            <label class="col-form-label my-font">
                                                وضعیت
                                            </label>
                                        </div>
                                        <div class="col-9">
                                            <input type="checkbox" asp-for="Enabled" class="switchery switchery-default" />
                                        </div>
                                    </div>
                                    <div class="scrollable-container" style="max-height: 500px;">
                                        <table class="table table-striped my-font">
                                            <thead>
                                            <tr>
                                                <th>دسترسی</th>
                                                <th>لیست</th>
                                                <th>ایجاد</th>
                                                <th>ویرایش</th>
                                                <th>حذف</th>
                                            </tr>
                                            </thead>
                                            @foreach (var claimType in Model.ClaimTypeSource) {
                                                <tr>
                                                    <td>
                                                        <span>@claimType.Title</span>
                                                    </td>
                                                    <td>
                                                        @{ var chkListId = $"list_{claimType.Id}"; }
                                                        <input type="checkbox" id="@chkListId" class="switchery switchery-default"/>

                                                    </td>
                                                    <td>
                                                        @{ var chkCreateId = $"create_{claimType.Id}"; }
                                                        <input type="checkbox" id="@chkCreateId" class="switchery switchery-default"/>
                                                    </td>
                                                    <td>
                                                        @{ var chkEditId = $"edit_{claimType.Id}"; }
                                                        <input type="checkbox" id="@chkEditId" class="switchery switchery-default"/>
                                                    </td>
                                                    <td>
                                                        @{ var chkDeleteId = $"delete_{claimType.Id}"; }
                                                        <input type="checkbox" id="@chkDeleteId" class="switchery switchery-default"/>
                                                    </td>
                                                </tr>
                                            }
                                        </table>
                                    </div>

                            <div class="row" style="padding-top: 20px;">
                                <a asp-controller="@UsersController.Name" asp-action="@UsersController.ACTION_Index"
                                   class="btn btn-secondary bg-light-secondary mr-1 my-font"
                                   data-dismiss="modal">
                                    <i class="fa fa-times"></i> انصراف
                                </a>
                                <button type="submit" onclick="return inputIsValid();" class="btn btn-primary my-font">
                                    <i class="fa fa-check"></i> ارسال
                                </button>
                            </div>


                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

@section footSection {
    
    <script type="text/javascript">
        
        $(document).ready(function () {
            $('#Title').focus();
        });

        $('#my-form').submit(function () {
            if ($(this).valid()) {
                $(this).find(':submit').attr('disabled', 'disabled');
            }
        });

    </script>

}
