@model RolesIndexViewModel
@{
    ViewData["Title"] = "مدیریت نقش های سیستم";
}
<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mt-3">
        <button id="btnNewRole" onclick="addNewRole();" type="button" class="btn btn-outline-info mr-1 mb-1 my-font"><i class="fa fa-plus"></i> تعریف تقش جدید</button>
        <hr class="mt-1 mt-sm-2">
        <ul id="listRoles" class="nav flex-column nav-pills" id="tabRoles" role="tablist">
            @{ var activeClass = "active";}
            @foreach (var role in Model.Items) {
                <li class="nav-item">
                    <a class="nav-link @activeClass" id="link_@role.Id" data-toggle="tab" href="#tab_@role.Id" role="tab" aria-controls="tab_@role.Id" aria-selected="true">
                        <span class="align-middle my-font">
                            @role.Title | @role.Name
                        </span>
                        <i class="fa fa-user-alt align-middle"></i>
                    </a>
                </li>
                activeClass = "";
            }
            
        </ul>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-content">
                <div class="card-body">
                    <div class="tab-content" id="divTabs">
                        @{ activeClass = "active";}
                        
                        @foreach (var role in Model.Items) {
                            <div class="tab-pane @activeClass" id="tab_@role.Id" role="tabpanel" aria-labelledby="link_@role.Id">
                                <div class="row toolbar-row">
                                    <div class="col">
                                        <h3>@role.Title</h3>
                                    </div>
                                    <div class="col">
                                        <div style="float: left;">
                                            <button id="edit_@role.Id" type="button" data-id="@role.Id" class="role-btn role-edit-btn btn btn-outline-info mr-1 mb-1 my-font"><i class="fa fa-edit"></i> ویرایش</button>
                                            <button id="delete_@role.Id" type="button" class="role-btn btn btn-outline-danger mr-1 mb-1 my-font"><i class="fa fa-trash"></i> حذف</button>
                                            
                                            <button id="save_@role.Id" type="button" data-id="@role.Id" class="role-btn btn btn-success mr-1 mb-1 my-font" style="display: none;"><i class="fa fa-check"></i> ذخیره</button>
                                            <button id="cancel_@role.Id" type="button" class="role-btn btn btn-danger mr-1 mb-1 my-font" style="display: none;"><i class="fa fa-times"></i> انصراف</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <hr class="mt-1 mt-sm-2">
                                <form novalidate id="form_@role.Id">
                                    <div class="row form-group">
                                        <div class="col-3">
                                            <label class="col-form-label my-font">
                                                عنوان
                                            </label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" value="@role.Title" id="txtTitle_@role.Id" placeholder="عنوان نقش" class="form-control my-font"/>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-3">
                                            <label class="col-form-label my-font">
                                                نام انگلیسی نقش
                                            </label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" value="@role.Name" dir="ltr" id="txtName_@role.Id" placeholder="نام نقش" class="form-control my-font"/>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-3">
                                            <label class="col-form-label my-font">
                                                وضعیت
                                            </label>
                                        </div>
                                        <div class="col-9">
                                            <input id="switch_@role.Id" type="checkbox" class="switchery switchery-default" value="@role.Enabled">
                                        </div>
                                    </div>
                                    <div class="scrollable-container" style="max-height: 500px;">
                                        <table class="table table-striped my-font">
                                            <thead>
                                            <tr>
                                                <th>دسترسی</th>
                                                <th>لیست</th>
                                                <th>ایجاد</th>
                                                <th>ویرایش</th>
                                                <th>حذف</th>
                                            </tr>
                                            </thead>
                                            @foreach (var claimType in Model.ClaimTypeSource) {
                                                <tr>
                                                    <td>
                                                        <span>@claimType.Title</span>
                                                    </td>
                                                    <td>
                                                        @{ var chkListId = $"list_{role.Id}_{claimType.Id}"; }
                                                        <input type="checkbox" id="@chkListId" class="switchery switchery-default"/>
                                                    </td>
                                                    <td>
                                                        @{ var chkCreateId = $"create_{role.Id}_{claimType.Id}"; }
                                                        <input type="checkbox" id="@chkCreateId" class="switchery switchery-default"/>
                                                    </td>
                                                    <td>
                                                        @{ var chkEditId = $"edit_{role.Id}_{claimType.Id}"; }
                                                        <input type="checkbox" id="@chkEditId" class="switchery switchery-default"/>
                                                    </td>
                                                    <td>
                                                        @{ var chkDeleteId = $"delete_{role.Id}_{claimType.Id}"; }
                                                        <input type="checkbox" id="@chkDeleteId" class="switchery switchery-default"/>
                                                    </td>
                                                </tr>
                                            }
                                        </table>
                                    </div>
                                </form>
                            </div>
                            activeClass = "";
                        }
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section headSection {
    <link href="~/assets/vendors/css/switchery.min.css" rel="stylesheet" />
    <style>
        .disabled-div{
            pointer-events: none;
            opacity: 0.4;
        }
    </style>
}

@section footSection {
    <script type="text/javascript" src="~/assets/vendors/js/switchery.min.js"></script>
    
    <partial name="_scripts" />

    <script type="text/javascript">
        $(document).ready(function() {
            console.log('ready');
            $('.role-edit-btn').on('click', function() {
                var id = $(this).data('id');
                console.log(id);
                editRole(id);
            });
            $('.switchery').switchery();
            //$('#btnNewRole').on('click', function() {
            //    addNewRole();
            //});
        });
        
    </script>
    
    @foreach(var role in Model.Items) {
        var formName = $"form_{role.Id}";
        <script type="text/javascript">
            $('#@formName').addClass('disabled-div');
        </script>
    }

}
