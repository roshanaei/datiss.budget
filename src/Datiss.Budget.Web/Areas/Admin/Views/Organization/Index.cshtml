@model OrganizationIndexViewModel
@{ ViewData["Title"] = "سازمان"; }

<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <!--Filters-->
                        <form method="post"
                              id="filterForm"
                              asp-controller="@OrganizationController.Name"
                              asp-action="@OrganizationController.ACTION_Index"
                              asp-antiforgery="true">

                            <div class="rowACJSB">
                                <fieldset class="form-group mt-3">
                                    <label asp-for="Filter.OrganizationId" class="my-font" style="margin-right:20px">
                                        سازمان:
                                        <select asp-for="Filter.OrganizationId"
                                                asp-items="Model.Filter.ParentOrganozationSource"
                                                class="form-control d-inline-block width-300"
                                                id="organizationId">
                                        </select>
                                    </label>
                                    <label asp-for="Filter.Type" class="my-font" style="margin-right:20px">
                                        نوع سازمان:
                                        <select asp-for="Filter.Type"
                                                asp-items="Model.Filter.OrganizationTypeSource"
                                                class="form-control d-inline-block width-100"
                                                id="organizationTypeId">
                                        </select>
                                    </label>
                                    <label class="my-font" style="margin-right:20px">
                                        فاضلاب:
                                        <select asp-for="Filter.SewageStatus" class="form-control d-inline-block width-100" id="sewageStatus">
                                            <option value="">[انتخاب کنید]</option>
                                            <option value="true">دارد</option>
                                            <option value="false">ندارد</option>
                                        </select>
                                    </label>
                                    <label asp-for="Filter.Status" class="my-font" style="margin-right:20px">
                                        وضعیت:
                                        <select asp-for="Filter.Status"
                                                asp-items="Model.Filter.OrganizationStatusSource"
                                                class="form-control d-inline-block width-100"
                                                id="status">
                                        </select>
                                    </label>

                                    <input type="hidden" />
                                    <input type="hidden" />
                                </fieldset>
                                <fieldset>
                                    <div class="rowACJE">
                                        <button data-toggle="tooltip" data-placement="top" title="فیلتر" type="submit" name="btnFilter" class="btn btn-info bg-light-info  mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-filter"></i>
                                        </button>
                                        <span data-toggle="modal" data-target="#CreateModal">
                                            <button data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" name="btnCreate" class="btn btn-success bg-light-success mr-1 my-font modallink" onclick="Create()">
                                                <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
                                            </button>
                                        </span>
                                    </div>
                                </fieldset>
                            </div>

                            <hr />
                            <!--SearchBox-->
                            <fieldset class="form-group position-relative has-icon-left">
                                <input asp-for="Filter.Search" id="ngx-filter-ref" type="text" placeholder="جستجو..." class="form-control-lg form-control d-inline-block my-custom-input my-font">
                                <div class="form-control-position">
                                    <i class="ft-search font-medium-4"></i>
                                </div>
                            </fieldset>
                            <!--SearchBox-->
                            <div class="rowACJSB">
                                <div class="d-flex flex-row-reverse align-items-center">

                                    <fieldset class="form-group" style="margin-right:20px">
                                        <label class="my-font rowAC">
                                            <span>نمایش</span>

                                            <select asp-for="Filter.PageSize"
                                                    style="margin-right:10px"
                                                    class="form-control"
                                                    onchange="changePageSize();"
                                                    id="ddlPageSize">
                                                <option>10</option>
                                                <option>20</option>
                                                <option>30</option>
                                            </select>
                                            <span style="margin-right:10px">رکورد</span>

                                        </label>

                                    </fieldset>
                                </div>
                            </div>
                        </form>
                        <!--DataTable-->
                        <div class="table-responsive">
                            <table id="" class=" table table-hover table-bordered m-0 my-font">
                                <thead class="thead-light">
                                    <tr>
                                        <th>نام سازمان</th>
                                        <th>نوع سازمان</th>
                                        <th>فاضلاب</th>
                                        <th>وضعیت</th>
                                        <th>مدیریت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.Title.ToString()</td>
                                            <td>@item.TypeDisplay </td>
                                            <td>@(item.SewageStatus==true? "دارد" : "ندارد")</td>
                                            <td>@item.StatusDisplay </td>
                                            <td>
                                                <span data-toggle="modal" data-target="#EditModal">
                                                    <button value="@item.Id" data-toggle="tooltip" data-placement="top" title="ویرایش اطلاعات" type="button" name="btnEdit" class="btn bg-light-info btn-info mr-1 my-font modallink" onclick="Edit(@item.Id)">
                                                        <i _ngcontent-dpj-c129="" class="fa fa-edit"></i>
                                                    </button>
                                                </span>
                                                <span data-toggle="modal" data-target="#DeleteModal">
                                                    <button id="btnDelete_@item.Id" data-id="@item.Id" value="@item.Id" data-toggle="tooltip" data-placement="top" title="حذف رکورد" type="button" name="btnDelete" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                                                        <i _ngcontent-dpj-c129="" class="fa fa-trash-o"></i>
                                                    </button>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="rowACJSB" style="margin-top:20px">
                                <div class="rowAC">
                                    <div class="my-font">کل رکوردها: <b class="font-medium-2">@Model.TotalCount</b></div>
                                    <div class="my-font ml-2">
                                        (صفحه <b class="font-medium-2">@Model.PageNumber</b> از
                                        <b class="font-medium-2">
                                            @if (Model.PagesCount == 0)
                                            {<span>1</span>}
                                            else
                                            {<span>@Model.PagesCount</span>}
                                        </b>)
                                    </div>
                                </div>

                                <!--Pagination-->
                                <vc:pager model="Model.ToPager()" controller-name="@OrganizationController.Name" action-name="@OrganizationController.ACTION_Index"></vc:pager>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

@section footSection {

    <div id="modaldiv">

    </div>


    <script>

        function Edit(orgid) {
            let myurl = '@Url.Action(OrganizationController.ACTION_Edit)';
            myurl = myurl + "/" + orgid;

            $.ajax({
                type: 'GET',
                url: myurl,
                success: function (data, status, settings) {
                    $('#modaldiv').html('');
                    $("#modaldiv").html(data);
                    $('#EditModal').modal('show');
                    $('#EditModal').on('hidden.bs.modal', function () {
                        $('#modaldiv').html('');
                        $('.modal-backdrop').remove();
                    });
                },
                error: function (ajaxrequest, ajaxOptions, thrownError) {
                    if (ajaxrequest.status == 401 || ajaxrequest.status == 403) {
                        ShowPermissionErorr();
                        return;
                    }
                    ShowCommonErorr();
                }
            });
        }

        $(document).on('click', '#btnDoEdit', function () {

            $('#spanTitle').text('');
            $('#Title').removeClass("error-border");

            $('#spanDisplayOrder').text('');
            $('#DisplayOrder').removeClass("error-border");

            let model = {};

            model.id = $('#Id').val()
            model.title = $('#Title').val();
            model.parentId = $('#ParentId option:selected').val();
            model.type = $('#Type option:selected').val();
            model.sewageStatus = $('#SewageStatus option:selected').val();
            model.displayOrder = $('#DisplayOrder').val();
            model.enabled = $('input[name="Enabled"]:checked').val();


            if (model.title == '') {
                $('#Title').addClass("error-border");
                $('#divError').show();
                $('#spanTitle').text('لطفا عنوان سازمان را وارد نمایید .');
                return;
            }
            if (model.displayOrder < '0' || model.displayOrder == '') {
                $('#DisplayOrder').addClass("error-border");
                $('#divError').show();
                $('#spanDisplayOrder').text('لطفا ترتیب نمایش را صحیح وارد کنید .');
                return;
            }


            $.ajax({
                type: 'POST',
                url: '@Url.Action(OrganizationController.ACTION_Edit)',
                data: model,
                dataType: 'json',
                success: function (data, status, settings) {
                    if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                    }

                    Swal.fire({
                        title: '<span class="my-font">عملیات موفق</span>',
                        html: '<span class="my-font">عملیات ویرایش سازمان با موفقیت انجام شد.</span>',
                        type: 'success',
                        confirmButtonColor: '#2F8BE6',
                        animation: true,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-secondary mr-1 my-font',
                        buttonsStyling: false,
                    }).then(function(result) {
                        document.location.href = '@Url.Action(OrganizationController.ACTION_Index)';
                    });
                },
                error: function (request, options, err) {
                    console.log(err);
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">عملیات ویرایش سازمان با خطا مواجه شد.</span>`,
                        type: 'error',
                        confirmButtonColor: '#2F8BE6',
                        animation: false,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                }
            });
        });

        function Create() {
            let myurl = '@Url.Action(OrganizationController.ACTION_Create)';
            $.ajax({
                type: 'GET',
                url: myurl,
                success: function (data, status, settings) {
                    $('#modaldiv').html('');
                    $("#modaldiv").html(data);
                    $('#CreateModal').modal('show');
                    $('#CreateModal').on('hidden.bs.modal', function () {
                        $('#modaldiv').html('');
                        $('.modal-backdrop').remove();
                    });
                },
                error: function (ajaxrequest, ajaxOptions, thrownError) {
                    if (ajaxrequest.status == 401 || ajaxrequest.status == 403) {
                        ShowPermissionErorr();
                        return;
                    }
                    ShowCommonErorr();
                }
            });
        }

        $(document).on('click', '#btnDoCreate', function () {
            $('#spanTitle').text('');
            $('#Title').removeClass("error-border");

            let model = {};
            model.title = $('#Title').val();
            model.parentId = $('#ParentId option:selected').val();
            model.type = $('#Type option:selected').val();
            model.sewageStatus = $('#SewageStatus option:selected').val();

            if (model.title == '') {
                $('#Title').addClass("error-border");
                $('#divError').show();
                $('#spanTitle').text('لطفا عنوان سازمان را وارد نمایید .');
                return;
            }

            $.ajax({
                type: 'POST',
                url: '@Url.Action(OrganizationController.ACTION_Create)',
                data: model,
                dataType: 'json',
                success: function (data, status, settings) {
                    if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                    }

                    Swal.fire({
                        title: '<span class="my-font">عملیات موفق</span>',
                        html: '<span class="my-font">عملیات افزودن سازمان جدید با موفقیت انجام شد.</span>',
                        type: 'success',
                        confirmButtonColor: '#2F8BE6',
                        animation: true,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-secondary mr-1 my-font',
                        buttonsStyling: false,
                    }).then(function(result) {
                        document.location.href = '@Url.Action(OrganizationController.ACTION_Index)';
                    });
                },
                error: function (request, options, err) {
                    console.log(err);
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">عملیات افزودن سازمان جدید با خطا مواجه شد.</span>`,
                        type: 'error',
                        confirmButtonColor: '#2F8BE6',
                        animation: false,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                }
            });
        });

        $(document).on('click', '.delete-row', function () {
            let id = $(this).data('id');
            let btn = this;

            Swal.fire({
                title: '<span class="my-font">برای حذف اطمینان دارید ؟</span>',
                text: "",
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#2F8BE6',
                animation: false,
                customClass: 'animated flipInX',
                cancelButtonColor: '#F55252',
                cancelButtonText: 'انصراف',
                confirmButtonText: 'حذف اطلاعات!',

                confirmButtonClass: 'btn btn-warning my-font',
                cancelButtonClass: 'btn btn-danger  my-font ml-1',
                buttonsStyling: false,
            }).then(function (result) {
                if (result.value) {
                    deleteRow(btn, id);
                    return true;
                }
                else {
                    return false;
                }
            });
        });

        function deleteRow(e, id) {

            $.ajax({
                url: '@Url.Action(OrganizationController.ACTION_Delete)' + '/' + id,
                type: 'POST',
                success: function (data, status, settings) {
                    if (data.hasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data.message}</span>`,
                            type: 'error',
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                    }

                    $(e).closest('tr').remove();
                },
                error: function (request, options, err) {
                    if (request.status == 401 || request.status == 403) {
                        ShowPermissionErorr();
                        return;
                    }
                    ShowCommonErorr();
                }
            });
        }

        function changePageSize() {
            let pageSize = $('#ddlPageSize').attr('value');
            console.log(pageSize);
            $('#filterForm').submit();
        };

    </script>

}

