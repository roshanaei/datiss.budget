@model CreateOrganizationViewModel

<!--Modals-->
<div class="modal fade text-left" id="CreateModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel2" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title my-font" id="myModalLabel2">سازمان جدید</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                </button>
            </div>
            <form id="OrganizationForm">
                <div class="modal-body">

                    <div class="rowAC">

                        <div class="my-font" style="flex:1">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-left:5px;width:90px;position:center">عنوان :</span>
                                    <input asp-for="Title" type="text" class="form-control d-inline-block" />
                                </label>
                            </fieldset>
                        </div>

                    </div>

                    <div class="rowAC">

                        <div class="my-font" style="flex:1">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-left:5px;width:90px">سازمان پدر :</span>
                                    <select asp-for="ParentId" 
                                            asp-items="@Model.ParentList" 
                                            class="form-control d-inline-block">
                                    </select>
                                </label>
                            </fieldset>
                        </div>

                    </div>

                    <div class="rowAC">

                        <div class="my-font" style="flex:1">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-left:5px;width:115px">نوع :</span>
                                    <select asp-for="Type"
                                            asp-items="@Model.OrganizationTypeSource"
                                            class="form-control d-inline-block">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                        <div class="my-font" style="flex:1">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-left:5px;margin-right:15px;width:90px">فاضلاب :</span>
                                    <select asp-for="SewageStatus" class="form-control d-inline-block">
                                        <option value="true">دارد</option>
                                        <option value="false">ندارد</option>
                                    </select>
                                </label>
                            </fieldset>
                        </div>


                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                    <button id="btnDoCreate" type="button" class="btn btn-warning bg-light-warning mr-1 my-font">ثبت</button>
                </div>
            </form>

        </div>
    </div>
</div>
<!--Modals-->