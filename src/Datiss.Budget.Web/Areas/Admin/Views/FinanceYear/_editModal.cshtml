@model UpdateFinanceYearViewModel
<!--Modals-->

<div class="modal fade text-left" id="EditModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel2" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title my-font" id="myModalLabel2">ویرایش سال مالی</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                </button>
            </div>
            <form id="FinanceYearForm">
                <div class="modal-body">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="_CurrentPage" />

                    <div class="rowAC">

                        <div class="my-font" style="flex:1.5">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-left:5px;width:90px">نام سال:</span>
                                    <input asp-for="Title" type="text" class="form-control form-control-sm d-inline-block" />
                                </label>
                            </fieldset>
                        </div>

                        <div class="my-font" style="flex:0.5">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-right:10px;width:140px">سال به عدد:</span>
                                    <input asp-for="Year" type="number" class="form-control form-control-sm d-inline-block" />
                                </label>
                            </fieldset>
                        </div>

                        <div class="custom-control custom-checkbox form-group" style="flex:1.2;margin-right:20px">
                            <input class="custom-control-input" type="checkbox" asp-for="Enable" id="auth-ligin" onchange="change(this)" />
                            <label class="custom-control-label" for="auth-ligin">
                                <span class="my-font">وضعیت :</span>
                                <span class="my-font" id="statustext"></span>
                            </label>
                        </div>

                    </div>
                    <div class="rowAC">
                        <div class="my-font" style="flex:1">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="width:95px">شروع سال:</span>
                                    <input asp-for="StartPersianDate" class="form-control form-control-sm d-inline-block" style="margin-left:10px" autocomplete="off" datepicker="datepicker" />
                                </label>
                            </fieldset>
                        </div>
                        <div class="my-font" style="flex:1">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="width:85px">پایان سال:</span>
                                    <input asp-for="EndPrsianDate" class="form-control form-control-sm d-inline-block" autocomplete="off" datepicker="datepicker" />
                                </label>
                            </fieldset>
                        </div>
                    </div>

                    <div id="divError" style="display: none">
                        <span id="spanTitle" class="my-font error-text"></span>
                        <span id="spanYear" class="my-font error-text"></span>
                        <span id="spanStartPersianDate" class="my-font error-text"></span>
                        <span id="spanEndPrsianDate" class="my-font error-text"></span>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                    <button id="btnDoEdit" type="button" class="btn btn-warning bg-light-warning mr-1 my-font">ثبت</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {
        $("#FinanceYearForm [datepicker]").datepicker({
            isRTL: true,
            dateFormat: "yy/m/d"
        });

        if ($('input[name="Enable"]').is(":checked")) {
            $('#statustext').text('فعال');
        }
        else {
            $('#statustext').text('غیرفعال');
        }

    });
    function change() {
        if ($('input[name="Enable"]').is(":checked")) {
            $('#statustext').text('فعال');
        }
        else {

            $('#statustext').text('غیرفعال');
        }
    }
</script>
