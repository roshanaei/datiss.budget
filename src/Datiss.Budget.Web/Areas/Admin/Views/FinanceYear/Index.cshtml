@model FinanceYearIndexViewModel
@{ ViewData["Title"] = "سال مالی"; }



<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <!--Filters-->
                        <form method="post" class="" asp-controller="FinanceYear" asp-action="Index" asp-antiforgery="true" id="">
                            <div class="class=" rowACJSB"">
                                <fieldset class="">
                                    <input asp-for="Filter.OrderBy" type="hidden" />
                                    <input asp-for="Filter.OrderDesc" type="hidden" />
                                </fieldset>
                                <fieldset>
                                    <div class="rowACJE">
                                        <a asp-controller="FinanceYear" asp-action="Deleted" data-toggle="tooltip" data-placement="top" title="سال های حذف شده" type="button" name="btnCreate" class="btn btn-danger bg-light-danger mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa ft-archive"></i>
                                        </a>
                                        <span data-toggle="modal" data-target="#CreateModal">
                                            <button data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" name="btnCreate" class="btn btn-success bg-light-success mr-1 my-font modallink openCreate">
                                                <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
                                            </button>
                                        </span>
                                    </div>
                                </fieldset>
                            </div>
                        </form>
                        <hr />
                        <!--SearchBox-->
                        <!--DataTable-->
                        <div class="table-responsive">
                            <table id="" class=" table table-hover table-bordered m-0 my-font">
                                <thead class="thead-light">
                                    <tr>
                                        <th>نام</th>
                                        <th>وضعیت</th>
                                        <th>مدیریت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.Title</td>
                                            <td>@item.StatusDisplay</td>
                                            <td>
                                                <span data-toggle="modal" data-target="#EditModal">
                                                    <button value="@item.Id" data-toggle="tooltip" data-placement="top" title="ویرایش اطلاعات" type="button" name="btnEdit" class="btn bg-light-info btn-info mr-1 my-font modallink" onclick="Edit(@item.Id)">
                                                        <i _ngcontent-dpj-c129="" class="fa fa-edit"></i>
                                                    </button>
                                                </span>
                                                <span data-toggle="modal" data-target="#DeleteModal">
                                                    <button id="btnDelete_@item.Id" data-id="@item.Id" value="@item.Id" data-toggle="tooltip" data-placement="top" title="حذف رکورد" type="button" name="btnDelete" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                                                        <i _ngcontent-dpj-c129="" class="fa fa-trash-o"></i>
                                                    </button>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="rowACJSB" style="margin-top:20px">
                                <!--Tools-->
                                <!--Pagination-->
                                <vc:pager model="Model.ToPager()" controller-name="@FinanceYearController.Name" action-name="@FinanceYearController.ACTION_Index"></vc:pager>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

@section headSection{

    <link rel="stylesheet" type="text/css" href="~/css/plugin/persian-datepicker-cheerup.min.css">
}

@section footSection {
    <script src="~/js/plugin/waitMe.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/js/plugin/persian-date.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/js/plugin/persian-datepicker.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/js/plugin/myDatepicker.js" type="text/javascript" asp-append-version="true"></script>

    <div id="modaldiv">

    </div>

    <partial name="_createModal" model="new CreateFinanceYearViewModel()" />


    <script>

        function Edit(yearid) {
            let myurl = '@Url.Action("Edit")';
            myurl = myurl + "/" + yearid;
            $.ajax({
                type: 'GET',
                url: myurl,
                success: function (data, status, settings) {
                    $('#modaldiv').html('');
                    $("#modaldiv").html(data);
                    $('#EditModal').modal('show');
                    $('#EditModal').on('hidden.bs.modal', function () {
                        $('#modaldiv').html('');
                        $('.modal-backdrop').remove();
                    });
                },
                error: function (ajaxrequest, ajaxOptions, thrownError) {
                    if (ajaxrequest.status == 401 || ajaxrequest.status == 403) {
                        ShowPermissionErorr();
                        return;
                    }
                    ShowCommonErorr();
                }
            });
        }

        $(document).on('click', '#btnDoEdit', function () {
            $('#spanTitle').text('');
            $('#Title').removeClass("error-border");

            $('#spanYear').text('');
            $('#Year').removeClass("error-border");

            $('#spanStartPersianDate').text('');
            $('#StartPersianDate').removeClass("error-border");

            $('#spanEndPrsianDate').text('');
            $('#EndPrsianDate').removeClass("error-border");

            $('#divError').hide();

            let model = {};

            model.id = $('#Id').val();
            model.title = $('#Title').val();
            model.year = $('#Year').val();
            model.enable = $('input[name="Enable"]:checked').val();
            model.startPersianDate = $('#StartPersianDate').val();
            model.endPrsianDate = $('#EndPrsianDate').val();

            if (model.title == '') {
                $('#Title').addClass("error-border");
                $('#divError').show();
                $('#spanTitle').text('لطفا عنوان سال را وارد نمایید .');
                return;
            }
            if (model.year == '0' || model.year == '') {
                $('#Year').addClass("error-border");
                $('#divError').show();
                $('#spanYear').text('لطفا عدد سال را وارد نمایید .');
                return;
            }
            if (model.startPersianDate == '') {
                $('#StartPersianDate').addClass("error-border");
                $('#divError').show();
                $('#spanStartPersianDate').text('لطفا شروع سال را انتخاب کنید.');
                return;
            }
            if (model.endPrsianDate == '') {
                $('#EndPrsianDate').addClass("error-border");
                $('#divError').show();
                $('#spanEndPrsianDate').text('لطفا پایان سال را انتخاب کنید.');
                return;
            }


            $.ajax({
                type: 'POST',
                url: '@Url.Action(FinanceYearController.ACTION_Edit)',
                data: model,
                dataType: 'json',
                success: function (data, status, settings) {
                    if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                    }

                    Swal.fire({
                        title: '<span class="my-font">عملیات موفق</span>',
                        html: '<span class="my-font">عملیات ویرایش سال مالی با موفقیت انجام شد.</span>',
                        type: 'success',
                        confirmButtonColor: '#2F8BE6',
                        animation: true,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-secondary mr-1 my-font',
                        buttonsStyling: false,
                    }).then(function(result) {
                        document.location.href = '@Url.Action(FinanceYearController.ACTION_Index)';
                    });
                },
                error: function (request, options, err) {
                    console.log(err);
                    alert('عملیات ویرایش سال مالی با خطا مواجه شد.');
                }
            });
        });

        $(document).on('click', '.openCreate', function () {

            $('#CreateModal').modal('show');
            $('#CreateModal').on('hidden.bs.modal', function () {
                $('#modaldiv').html('');
                $('.modal-backdrop').remove();
            });
        });

        $(document).on('click', '#btnDoCreate', function () {

            $('#spanYear').text('');
            $('#Year').removeClass("error-border");
            $('#spanStartPersianDate').text('');
            $('#StartPersianDate').removeClass("error-border");
            $('#spanEndPrsianDate').text('');
            $('#EndPrsianDate').removeClass("error-border");
            $('#divError').hide();

            let model = {};
            model.year = $('#Year').val();
            model.startPersianDate = $('#StartPersianDate').val();
            model.endPrsianDate = $('#EndPrsianDate').val();

            if (model.year == '0' || model.year == '') {
                $('#Year').addClass("error-border");
                $('#divError').show();
                $('#spanYear').text('لطفا عدد سال را وارد نمایید .');
                return;
            }
            if (model.startPersianDate == '') {
                $('#StartPersianDate').addClass("error-border");
                $('#divError').show();
                $('#spanStartPersianDate').text('لطفا شروع سال را انتخاب کنید.');
                return;
            }
            if (model.endPrsianDate == '') {
                $('#EndPrsianDate').addClass("error-border");
                $('#divError').show();
                $('#spanEndPrsianDate').text('لطفا پایان سال را انتخاب کنید.');
                return;
            }


            $.ajax({
                type: 'POST',
                url: '@Url.Action(FinanceYearController.ACTION_Create)',
                data: model,
                dataType: 'json',
                success: function (data, status, settings) {
                    if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                    }

                    Swal.fire({
                        title: '<span class="my-font">عملیات موفق</span>',
                        html: '<span class="my-font">عملیات افزودن سال مالی جدید با موفقیت انجام شد.</span>',
                        type: 'success',
                        confirmButtonColor: '#2F8BE6',
                        animation: true,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-secondary mr-1 my-font',
                        buttonsStyling: false,
                    }).then(function(result) {
                        document.location.href = '@Url.Action(FinanceYearController.ACTION_Index)';
                    });
                },
                error: function (request, options, err) {
                    if (request.status == 401 || request.status == 403) {
                        ShowPermissionErorr();
                        return;
                    }
                    ShowCommonErorr();
                }
            });
        });

        $(document).on('click', '.delete-row', function () {
            let id = $(this).data('id');
            let btn = this;
            Swal.fire({
                title: '<span class="my-font">برای حذف اطمینان دارید ؟</span>',
                text: "",
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#2F8BE6',
                animation: false,
                customClass: 'animated flipInX',
                cancelButtonColor: '#F55252',
                cancelButtonText: 'انصراف',
                confirmButtonText: 'حذف اطلاعات!',

                confirmButtonClass: 'btn btn-warning my-font',
                cancelButtonClass: 'btn btn-danger  my-font ml-1',
                buttonsStyling: false,
            }).then(function (result) {
                if (result.value) {
                    deleteRow(btn, id);

                    return true;
                }
                else {

                    return false;
                }
            });
        });
        function deleteRow(e, id) {
        $.ajax({
            url: '@Url.Action(FinanceYearController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
                if (data.hasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data.message}</span>`,
                        type: 'error',
                        confirmButtonColor: '#2F8BE6',
                        animation: false,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                $(e).closest('tr').remove();
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    </script>

}