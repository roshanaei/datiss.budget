@model ConstantIndexViewModel
@{ ViewData["Title"] = "ثابت ها"; }

<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            @*<i class="ft-settings mr-1"></i>*@
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <!--Filters-->
                        <form method="post"
                              id="filterForm"
                              asp-controller="Constant"
                              asp-action="Index"
                              asp-antiforgery="true">

                            <div class="rowACJSB">
                                <fieldset class="form-group mt-3">
                                    <label asp-for="Filter.ParentId" class="my-font">
                                        آیتم های:
                                        <select asp-for="Filter.ParentId"
                                                asp-items="Model.Filter.ParentSource"
                                                class="form-control d-inline-block width-300"
                                                id="parentId">
                                        </select>
                                    </label>
                                    <input asp-for="Filter.OrderBy" type="hidden" />
                                    <input asp-for="Filter.OrderDesc" type="hidden" />
                                </fieldset>
                                <fieldset>
                                    <div class="rowACJE">
                                        <button data-toggle="tooltip" data-placement="top" title="فیلتر" type="submit" name="btnFilter" class="btn btn-info bg-light-info  mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-filter"></i>
                                        </button>
                                        <button data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" name="btnCreate" class="btn btn-success bg-light-success my-font" onclick="Create()">
                                            <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
                                        </button>
                                    </div>
                                </fieldset>
                            </div>
                            <hr />
                            <!--SearchBox-->
                            <div class="rowACJSB">
                                <div class="rowAC" style="flex:1">
                                    <fieldset class="form-group">
                                        <label for="ngx-filter-ref" class="my-font">
                                            جستجو:
                                            <input id="ngx-filter-ref" type="text" placeholder="..." class="form-control form-control-sm d-inline-block width-200">
                                        </label>
                                    </fieldset>
                                    <fieldset class="form-group" style="margin-right:10px">
                                        <label class="my-font rowAC">
                                            <span>نمایش</span>

                                            <select style="margin-right:10px" class="form-control" id="basicSelect">
                                                <option>10</option>
                                                <option>20</option>
                                                <option>30</option>
                                            </select>
                                            <span style="margin-right:10px">رکورد</span>

                                        </label>
                                    </fieldset>
                                </div>
                            </div>
                        </form>

                        <!--DataTable-->
                        <div class="table-responsive">
                            <table id="" class=" table table-hover table-bordered m-0 my-font">
                                <thead class="thead-light">
                                    <tr>
                                        <th>ترتیب نمایش</th>
                                        <th>عنوان</th>
                                        <th>کلید</th>
                                        <th>وضعیت</th>
                                        <th>مدیریت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.DisplayOrder.ToString()</td>
                                            <td>@item.Title </td>
                                            <td>@item.ConstantKey </td>
                                            <td>@item.Status.ToString() </td>
                                            <td>
                                                <button value="@item.Id" data-toggle="tooltip" data-placement="top" title="ویرایش اطلاعات" type="button" name="btnEdit" class="btn btn-primary bg-light-primary mr-1 my-font modallink" onclick="Edit(@item.Id)">
                                                    <i _ngcontent-dpj-c129="" class="fa fa-edit"></i>
                                                </button>
                                                <button value="@item.Id" data-toggle="tooltip" data-placement="top" title="حذف اطلاعات" type="button" name="btnDelete" class="btn btn-primary bg-light-primary mr-1 my-font modallink" onclick="Delete(@item.Id)">
                                                    <i _ngcontent-dpj-c129="" class="fa fa-edit"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="rowACJE" style="margin-top:20px">
                                <!--Pagination-->
                                <vc:pager model="Model.ToPager()" controller-name="Constant" action-name="Index"></vc:pager>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>



@section footSection {

    <div id="modaldiv">

    </div>
    <script>

        function Edit(id) {
            let myurl = '@Url.Action(ConstantController.ACTION_Edit)';
            myurl = myurl + "/" + id;
            $.ajax({
                type: 'GET',
                url: myurl,
                success: function (data, status, settings) {

                    $("#modaldiv").html(data);
                    $('#EditModal').modal('show');
                    $('#EditModal').on('hidden.bs.modal', function () {
                        $('#modaldiv').html('');
                        $('.modal-backdrop').remove();
                    });
                },
                error: function (ajaxrequest, ajaxOptions, thrownError) {

                    $("#modaldiv").html('Failed to load more content');
                }
            });
        }

        function Create() {

            let myurl = '@Url.Action("Create")';

            $.ajax({
                type: 'GET',
                url: myurl,
                success: function (data, status, settings) {

                    $("#modaldiv").html(data);
                    $('#CreateModal').modal('show');
                    $('#CreateModal').on('hidden.bs.modal', function () {
                        $('#modaldiv').html('');
                        $('.modal-backdrop').remove();
                    });
                },
                error: function (ajaxrequest, ajaxOptions, thrownError) {

                    $("#modaldiv").html('Failed to load more content');
                }
            });
        }

        function Delete(id) {
            let myurl = '@Url.Action("Delete")';
            myurl = myurl + "/" + id;
            $.ajax({
                type: 'GET',
                url: myurl,
                success: function (data, status, settings) {

                    $("#modaldiv").html(data);
                    $('#DeleteModal').modal('show');
                    $('#DeleteModal').on('hidden.bs.modal', function () {
                        $('#modaldiv').html('');
                        $('.modal-backdrop').remove();
                    });
                },
                error: function (ajaxrequest, ajaxOptions, thrownError) {

                    $("#modaldiv").html('Failed to load more content');
                }
            });
        }

        $(document).on('click', '.delete-row', function () {
            let id = $(this).data('id');
            let btn = this;

            Swal.fire({
                title: 'برای حذف اطمینان دارید؟',
                text: "",
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#2F8BE6',
                animation: false,
                customClass: 'animated flipInX',
                cancelButtonColor: '#F55252',
                cancelButtonText: 'انصراف',
                confirmButtonText: 'حذف اطلاعات!',

                confirmButtonClass: 'btn btn-warning my-font',
                cancelButtonClass: 'btn btn-danger  my-font ml-1',
                buttonsStyling: false,
            }).then(function (result) {
                if (result.value) {
                    deleteRow(btn, id);

                    return true;
                }
                else {

                    return false;
                }
            });
        });
        @*function deleteRow(e, id) {
        console.log(e);

        $.ajax({
            url: '@Url.Action(ConstantController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
