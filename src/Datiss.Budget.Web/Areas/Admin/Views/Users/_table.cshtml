@using Datiss.Budget.Web.Admin.Controllers
@model UsersIndexViewModel

<div class="table-responsive">
    <table style="width:100%" id="my-table" class="table table-hover table-bordered m-0 my-font">
        <thead class="thead-light">
            <tr>
                <th>نام</th>
                <th>نام خانوادگی</th>
                <th>نام کاربری</th>
                <th>سازمان</th>
                <th>سمت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <span>@item.FirstName</span>
                    </td>
                    <td>
                        <span>@item.LastName</span>
                    </td>
                    <td>
                        <span>@item.UserName</span>
                    </td>
                    <td>
                        <span>@item.OrganizationTitle</span>
                    </td>
                    <td>
                        <span>@item.PositionTitle</span>
                    </td>
                    <td>
                        <a id="btnEdit_@item.Id" data-id="@item.Id" class="edit-row btn bg-light-info btn-info mr-1 my-font"
                           asp-controller="@UsersController.Name"
                           asp-action="@UsersController.ACTION_Edit"
                           asp-route-id="@item.Id">
                            <i class="fa ft-edit fa-1x"></i>
                        </a>

                        <button id="btnSetUserPassword_@item.Id" onclick="openSetPassword(@item.Id);" type="button" data-id="@item.Id" class="set-password btn btn-secondary bg-light-secondary mr-1 myfont">
                            <i class="fa fa-lock"></i>
                        </button>

                        <a id="btnDelete_@item.Id" data-id="@item.Id" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                            <i class="fa ft-trash-2"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="rowACJSB" style="margin-top:20px">
        <!--Tools-->
        <div class="rowAC">
            <div class="my-font">کل رکوردها: <b class="font-medium-2">@Model.TotalCount</b></div>
            <div class="my-font ml-2">
                (صفحه <b class="font-medium-2">@Model.PageNumber</b> از
                <b class="font-medium-2">
                    @if (Model.PagesCount == 0)
                    {<span>1</span>}
                    else
                    {<span>@Model.PagesCount</span>}
                </b>)
            </div>
        </div>

        <!--Pagination-->
        <vc:pager model="Model.ToPager()" controller-name="@UsersController.Name" action-name="@UsersController.ACTION_Index"></vc:pager>

    </div>

</div>
