@model AdminSetUserPasswordViewModel

<div id="modalSetUserPassword" class="modal fade text-left" role="dialog" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title my-font" id="modalTitle">
                    <i class="fa fa-lock"></i> تنظیم کلمه عبور کاربر
                </h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                </button>
            </div>
            <form novalidate
                  id="set-password-form"
                  class="form-horizontal">
                <div class="modal-content">
                    <input type="hidden" asp-for="UserId" id="SetPassword_UserId" />
                    <div class="modal-body">
                        <partial name="_CustomValidationSummary"/>
                        <div class="form-group row">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="col-md-4 col-form-label text-md-left my-font">نام کاربری</label>
                                <div class="col-md-10">
                                    <input asp-for="UserName" id="SetPassword_UserName" class="form-control my-font" readonly="readonly"/>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserDisplayName" class="col-md-4 col-form-label text-md-left my-font">نام و نام خانوادگی</label>
                                <div class="col-md-10">
                                    <input dir="rtl" asp-for="UserDisplayName" class="form-control my-font" readonly="readonly"/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="col-md-4 col-form-label text-md-left my-font">کلمه عبور</label>
                                <div class="col-md-10">
                                    <input dir="ltr" type="password" asp-for="NewPassword" id="SetPassword_NewPassword" maxlength="30" class="form-control my-font" />
                                    <span asp-validation-for="NewPassword" id="validateNewPassword" class="text-danger my-font"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="VerifyNewPassword" class="col-md-4 col-form-label text-md-left my-font">تایید کلمه عبور</label>
                                <div class="col-md-10">
                                    <input dir="ltr" type="password" asp-for="VerifyNewPassword" id="SetPassword_VerifyNewPassword" maxlength="30" class="form-control my-font" />
                                    <span asp-validation-for="VerifyNewPassword" id="validateVerifyNewPassword" class="text-danger my-font"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" id="btnSetUserPassword" class="btn btn-success mr-1 my-font">
                            <i class="fa fa-check"></i> ذخیره
                        </button>
                        <button type="button"
                                class="btn btn-secondary bg-light-secondary mr-1 my-font"
                                data-dismiss="modal">
                            <i class="fa fa-times"></i> بستن
                        </button>
                    </div>
                </div>
            </form>
        </div>

    </div>

</div>