@model UpdateReportViewModel
@{
    ViewData["Title"] = $"ویرایش گزارش {Model.Title}";
}

<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                         @if (Model._HasError)
                        {
                            <div class="alert alert-danger" role="alert">
                                <a href="#" class="close" data-dismiss="alert">×</a>
                                @Html.Raw(Model._ErrorMessage)
                            </div>
                        }
                        <form id="my-form"
                              asp-controller="@ReportsController.Name" 
                              asp-action="@ReportsController.ACTION_Edit" 
                              asp-antiforgery="true"
                              enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" />
                            <div class="row">
                                <div class="col-md-6 col-12">
                                    <div class="form-group row">
                                        <label asp-for="Title" class="col-md-3 col-form-label my-font">
                                            عنوان گزارش
                                        </label>
                                        <div class="col-md-9">
                                            <input asp-for="Title" type="text" class="form-control my-font" />
                                            <span asp-validation-for="Title"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <div class="form-group row">
                                        <label asp-for="Name" class="col-md-3 col-form-label my-font">
                                            نام گزارش
                                        </label>
                                        <div class="col-md-9">
                                            <input asp-for="Name" type="text" class="form-control my-font" style="direction: ltr" />
                                            <span asp-validation-for="Name"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-12">
                                    <label asp-for="Name" class="col-md-3 col-form-label my-font">
                                        توضیحات
                                    </label>
                                    <div class="form-group">
                                        <textarea asp-for="Description" rows="5" class="form-control my-font"
                                            placeholder="توضیحات را کاربر در هنگام نمایش گزارش مشاهده خواهد کرد.">
                                        </textarea>
                                        <span asp-validation-for="Description"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-12">
                                    <label asp-for="Enabled" class="col-md-3 col-form-label my-font">
                                        وضعیت نمایش گزارش
                                    </label>
                                    <div class="form-group">
                                        <input asp-for="Enabled" class="switchery switchery-default" type="checkbox" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" style="padding-bottom: 20px;">
                                <label asp-for="ReportFile" class="control-label my-font">
                                    انتخاب فایل گزارش
                                </label>
                                <input asp-for="ReportFile" class="form-control-file my-font" value="انتخاب فایل" />
                                <span asp-validation-for="ReportFile"></span>
                            </div>

                            <div style="padding-bottom: 40px;">
                                <h5>پارامترهای گزارش</h5>
                                <a data-toggle="tooltip" data-placement="top" title="رکورد جدید" 
                                    class="btn btn-success bg-light-success my-font"
                                    onclick="addParam();">
                                    <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
                                </a>
                                <div id="divParams" style="padding-top: 20px;">
                                    <div class="form-row" id="tempParam" style="display: none;">
                                        <div class="col-md-3 mb-3">
                                            <input name="ParamTitles" type="text" class="form-control my-font paramTitle" placeholder="عنوان پارامتر" required />
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <input name="ParamNames" type="text" class="form-control my-font paramName" style="direction: ltr;" placeholder="نام پارامتر" required />
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <select name="ParamTypes" asp-items="Model.ParamTypeSource" class="form-control my-font paramType">
                                            </select>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="my-font"></label>
                                            <button id="btnDeleteParam" onclick="return deleteParam(this);" class="btn btn-danger my-font" style="max-width: 50px;">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                    </div>
                                    @{
                                        int i = 0;
                                        foreach(var p in Model.Params) {
                                            <div class="form-row" id="p_@i">
                                                
                                                <div class="col-md-3 mb-3">
                                                    @*<label class="my-font">نام</label>*@
                                                    <input name="ParamTitles" value="@Model.ParamTitles[i]" type="text" class="form-control my-font paramTitle" placeholder="عنوان پارامتر" required />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    @*<label class="my-font">نام</label>*@
                                                    <input name="ParamNames" value="@Model.ParamNames[i]" type="text" class="form-control my-font paramName" style="direction: ltr;" placeholder="نام پارامتر" required />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    @*<label class="my-font">نوع</label>*@
                                                    <select id="ParamTypes_@i" name="ParamTypes" asp-items="Model.ParamTypeSource" class="form-control my-font paramType">
                                                    </select>
                                                    <script type="text/javascript">
                                                        $('#ParamTypes_' + @i + ' option[value=' + @Model.ParamTypes[i] + ']').attr('selected', true);
                                                    </script>
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="my-font"></label>
                                                    <button id="btnDeleteParam" onclick="return deleteParam(this);" class="btn btn-danger my-font" style="max-width: 50px;">
                                                        <i class="fa fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            i++;
                                        }
                                    }
                                    
                                </div>
                            </div>

                            <div class="row" style="direction:ltr; margin-left: 30px;">
                                <button type="submit" class="btn btn-warning bg-light-warning mr-1 my-font">
                                    <i class="fa fa-check"></i> ثبت
                                </button>
                                <a asp-controller="@ReportsController.Name" asp-action="@ReportsController.ACTION_Index"
                                   class="btn btn-secondary bg-light-secondary mr-1 my-font">
                                    <i class="fa fa-times"></i> انصراف
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            
        </div>
    </div>

</section>

@section footSection 
{
    <partial name="_sharedScripts" />  
}