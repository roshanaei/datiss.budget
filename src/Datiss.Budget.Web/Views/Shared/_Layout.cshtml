@{
    var pageTitle = ViewData["Title"] ?? "سیستم جامع بودجه داتیس";
}
<!DOCTYPE html>
<html>
<head>
    <title>سیستم جامع بودجه - @ViewData["Title"]</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/images/favicon/Datiss - favicon.ico" />
    <link rel="shortcut icon" type="image/png" href="~/images/favicon/Datiss - favicon.ico" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,700,900%7CMontserrat:300,400,500,600,700,800,900" rel="stylesheet" />
    <!-- BEGIN VENDOR CSS-->
    <!-- font icons-->
    <link rel="stylesheet" type="text/css" href="~/assets/fonts/feather/style.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/fonts/simple-line-icons/style.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/fonts/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/perfect-scrollbar.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/prism.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/switchery.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/chartist.min.css" />
    <!-- END VENDOR CSS-->
    <!-- BEGIN APEX CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/bootstrap.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/table.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/bootstrap-extended.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/colors.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/components.css" />
    <link rel="stylesheet" href="~/assets/css-rtl/plugins/switchery.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/custom-rtl.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/custom-fonts.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/pages/dashboard.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/custom-layout.css" />
    <link href="https://unpkg.com/tabulator-tables@4.9.3/dist/css/tabulator.min.css" rel="stylesheet">
    <script type="text/javascript" src="https://unpkg.com/tabulator-tables@4.9.3/dist/js/tabulator.min.js"></script>
    <link href="https://unpkg.com/tabulator-tables@4.9.3/dist/css/semantic-ui/tabulator_semantic-ui.min.css" rel="stylesheet">
    @RenderSection("headSection", required: false)

</head>
<body class="vertical-layout vertical-menu 2-columns navbar-sticky"
      data-menu="vertical-menu"
      data-col="2-columns">

    @{ await Html.RenderPartialAsync("_Navbar").ConfigureAwait(false); }
    <div class="wrapper">

        <div class="main-panel">
            <!-- BEGIN : Main Content-->
            <div class="main-content">
                <div class="content-wrapper">
                    <div class="row" style="display:contents">
                        <div class="col-lg-12 col-md-12 col-12">
                            <div id="Breadcrumb1">
                                <breadcrumb asp-homepage-title="خانه"
                                            asp-homepage-url="@Url.Action("Index", "Home", values: new { area = AreaConstants.IdentityArea })"
                                            asp-homepage-glyphicon="ft-home" style="background-color: #fff;"></breadcrumb>
                            </div>
                        </div>
                    </div>
                    @RenderBody()
                </div>
            </div>

            <!-- END : End Main Content-->
            <!-- BEGIN : Footer-->
            <footer class="footer footer-static footer-light">
                <div class="container">
                    <div class="text-center footer-text">
                        <span class="copyright-text">
                            <span style="color:DarkRed" aria-hidden="true"></span>
                            <a href="http://www.datiss.net/" target="_blank">Datiss.net</a>
                            <img src="~/images/favicon/footer-favicon.ico" width="16" height="16" />
                            <br />
                            <span class="d-none d-inline-block  my-font">Copyright @DateTime.Now.Year, All Rights Reserved</span>
                            <strong>©</strong>
                        </span>
                    </div>
                </div>
            </footer>
            <!-- End : Footer-->

        </div>
    </div>

    <!-- main menu-->

    @{ await Html.RenderPartialAsync("_Menu").ConfigureAwait(false); }

    <!-- main menu-->


    <div class="sidenav-overlay"></div>
    <div class="drag-target"></div>
    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <script src="~/assets/vendors/js/switchery.min.js"></script>

    <script src="~/assets/vendors/js/chartist.min.js"></script>
    <script src="~/assets/js/core/app-menu.js"></script>
    <script src="~/assets/js/core/app.js"></script>
    <script src="~/assets/js/scroll-top.js"></script>
    <script src="~/assets/js/dashboard.js"></script>
    <script src="~/assets/js/table.js"></script>


    <!--Modals-->
        <div class="modal fade text-left" id="ExcellModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel1" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title my-font" id="myModalLabel1">ورود اطلاعات اکسل</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="col-md-12 col-12">
                            <fieldset class="form-group">
                                <label for="inputGroupFile01" class="my-font">فایل مورد نظر را انتخاب کنید ...</label>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="inputGroupFile01">
                                    <label class="custom-file-label" for="inputGroupFile01">...</label>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                        <button type="button" class="btn btn-info bg-light-info mr-1 my-font">بارگزاری</button>
                    </div>
                </div>
            </div>
        </div>
    <!--Modals-->
    <!--Modals-->
        <div class="modal fade text-left" id="CopyModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel2" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title my-font" id="myModalLabel2">کپی اطلاعات</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <p class="my-font-bold">انتخاب اطلاعات مبدا</p>
                        <div class="my-font col-md-6 col-12">
                            <fieldset class="form-group">
                                <label class="my-font">
                                    سال مبدا:
                                    <select class="form-control form-control-sm d-inline-block width-100" id="yearId">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                        <div class="my-font col-md-6 col-12">
                            <fieldset class="form-group">
                                <label>
                                   سازمان مبدا:
                                    <select class="form-control form-control-sm d-inline-block width-100" id="organizationId">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                        <hr>
                        <p class="my-font-bold">انتخاب اطلاعات مقصد</p>
                        <div class="my-font col-md-6 col-12">
                            <fieldset class="form-group">
                                <label class="my-font">
                                     سال مقصد:
                                    <select class="form-control form-control-sm d-inline-block width-100" id="yearId">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                        <div class="my-font col-md-6 col-12">
                            <fieldset class="form-group">
                                <label>
                                    سازمان مقصد:
                                    <select class="form-control form-control-sm d-inline-block width-100" id="organizationId">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                    </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                            <button type="button" class="btn btn-warning bg-light-warning mr-1 my-font">ثبت</button>
                        </div>
                    </div>
            </div>
        </div>
    <!--Modals-->
    <!--Modals-->
        <div class="modal fade text-left" id="DeleteModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel3" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title my-font" id="myModalLabel3">حذف اطلاعات</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="my-font col-md-6 col-12">
                            <fieldset class="form-group">
                                <label class="my-font">
                                    سال:
                                    <select class="form-control form-control-sm d-inline-block width-100" id="yearId">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                        <div class="my-font col-md-6 col-12">
                            <fieldset class="form-group">
                                <label>
                                    سازمان:
                                    <select class="form-control form-control-sm d-inline-block width-100" id="organizationId">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                        <button type="button" class="btn btn-danger bg-light-danger mr-1 my-font">حذف اطلاعات</button>
                    </div>
                </div>
            </div>
        </div>
    <!--Modals-->
    <!--Modals-->
        <div class="modal fade text-left" id="CalculationModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel4" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="myModalLabel4">اطلاعات محاسبات</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                        </button>
                    </div>
                    <div class="modal-body my-font ">
                        <!--Striped rows Light Starts-->
                        <section id="striped-light">
                            <div class="row">
                                <div class="col-12">
                                    <div class="card-content">
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table class="table table-striped m-0">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>عنوان</th>
                                                            <th>مقدار</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <th scope="row">1</th>
                                                            <td>Mark</td>
                                                            <td>Otto</td>
                                                        </tr>
                                                        <tr>
                                                            <th scope="row">2</th>
                                                            <td>Jacob</td>
                                                            <td>Thornton</td>
                                                        </tr>
                                                        <tr>
                                                            <th scope="row">3</th>
                                                            <td>Larry</td>
                                                            <td>the Bird</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!--Striped rows Light Ends-->
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                    </div>
                </div>
            </div>
        </div>
    <!--Modals-->


    @RenderSection("footSection", required: false)


</body>

</html>