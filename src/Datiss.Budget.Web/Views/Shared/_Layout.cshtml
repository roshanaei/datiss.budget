@{
    var pageTitle = ViewData["Title"] ?? "سیستم جامع بودجه داتیس";
}
<!DOCTYPE html>
<html>
<head>
    <title>سیستم جامع بودجه - @ViewData["Title"]</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/images/favicon/Datiss - favicon.ico" />
    <link rel="shortcut icon" type="image/png"    href="~/images/favicon/Datiss - favicon.ico" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,700,900%7CMontserrat:300,400,500,600,700,800,900"  rel="stylesheet" />
    <!-- BEGIN VENDOR CSS-->
    <!-- font icons-->
    <link rel="stylesheet" type="text/css" href="~/assets/fonts/feather/style.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/fonts/simple-line-icons/style.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/fonts/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/perfect-scrollbar.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/prism.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/switchery.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/chartist.min.css" />
    <!-- END VENDOR CSS-->
    <!-- BEGIN APEX CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/bootstrap.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/table.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/bootstrap-extended.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/colors.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/components.css" />
    <link rel="stylesheet" href="~/assets/css-rtl/plugins/switchery.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/custom-rtl.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/custom-fonts.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css-rtl/pages/dashboard.css" />

    @RenderSection("headSection", required: false)

</head>
<body class="vertical-layout vertical-menu 2-columns navbar-sticky"
      data-menu="vertical-menu"
      data-col="2-columns">

    @{ await Html.RenderPartialAsync("_Navbar").ConfigureAwait(false); }
    <div class="wrapper">

        <div class="main-panel">
            <!-- BEGIN : Main Content-->
            <div class="main-content">
                <div class="content-wrapper">
                    <div class="row" style="display:contents">
                        <div class="col-lg-12 col-md-12 col-12">
                            <div id="Breadcrumb1">
                                <breadcrumb asp-homepage-title="خانه"
                                            asp-homepage-url="@Url.Action("Index", "Home", values: new { area = AreaConstants.IdentityArea })"
                                            asp-homepage-glyphicon="ft-home" style="background-color: #fff;"></breadcrumb>
                            </div>
                        </div>
                    </div>
                    @RenderBody()
                </div>
            </div>

            <!-- END : End Main Content-->
            <!-- BEGIN : Footer-->
            <footer class="footer footer-static footer-light">
                <div class="container">
                    <div class="text-center footer-text">
                        <span class="copyright-text">
                            <span style="color:DarkRed" aria-hidden="true"></span>
                            <a href="http://www.datiss.net/" target="_blank">Datiss.net</a>
                            <img src="~/images/favicon/footer-favicon.ico" width="16" height="16" />
                            <br />
                            <span class="d-none d-inline-block  my-font">Copyright @DateTime.Now.Year, All Rights Reserved</span>
                            <strong>©</strong>
                        </span>
                    </div>
                </div>
            </footer>
            <!-- End : Footer-->

        </div>
    </div>

    <!-- main menu-->
    <!--.main-menu(class="#{menuColor} #{menuOpenType}", class=(menuShadow == true ? 'menu-shadow' : ''))-->
    <div class="app-sidebar menu-fixed" data-background-color="purple-bliss" data-image="~/assets/img/sidebar-bg/01.jpg" data-scroll-to-active="true">
        <!-- main menu header-->
        <!-- Sidebar Header starts-->
        <div class="sidebar-header">
            <div class="logo clearfix">
                <a class="logo-text float-left">
                    <div class="logo-img"><img src="~/images/logo/DATISS.png" alt="" height="30"></div>
                    <span class="text my-font-bold">سیستم بودجه</span>
                </a>
                <a class="nav-toggle d-none d-lg-none d-xl-block" id="sidebarToggle" href="javascript:;">
                    <i class="toggle-icon ft-toggle-right" data-toggle="expanded"></i>
                </a>
                <a class="nav-close d-block d-lg-block d-xl-none" id="sidebarClose" href="@Url.Action("Index", "Home", values: new { area = AreaConstants.IdentityArea }, protocol: this.Context.Request.Scheme)" @*href="/"*@>
                    <i class="ft-x"></i>
                </a>
            </div>
        </div>
        <!-- Sidebar Header Ends-->
        <!-- main menu content-->
        <div class="sidebar-content main-menu-content">
            <div class="nav-container">
                <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">
                    <!-- مدیریت  سامانه-->
                    <li class="has-sub nav-item ">
                        <a class="CollapseBase" href="#">
                            <div>
                                <i class="ft-help-circle"></i>
                                <span data-i18n="" class="menu-title">مدیریت سامانه</span>
                            </div>
                        </a>
                        <ul class="menu-content" id="CollapseBase" parent="CollapseBase">
                            <li class="nav-item">
                                <a href="#">
                                    <i class="ft-refresh-cw"></i>
                                    <span data-i18n="سال" class="menu-title my-font"> سال </span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#">
                                    <i class="ft-refresh-cw"></i>
                                    <span data-i18n="سازمان" class="menu-title my-font"> سازمان </span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#">
                                    <i class="ft-refresh-cw"></i>
                                    <span data-i18n="ثابت ها" class="menu-title my-font"> ثابت ها </span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <!-- مدیریت کاربران-->
                    <li class="has-sub nav-item">
                        <a class="CollapseAccount" href="#">
                            <div>
                                <i class="ft-users"></i>
                                <span data-i18n="مدیریت کاربران" class="menu-title">مدیریت کاربران</span>
                            </div>
                        </a>
                        <ul class="menu-content" id="CollapseAccount" parent="CollapseAccount">

                            <li class="">
                                <a class="menu-item" asp-area="" asp-controller="" asp-action="">
                                    <i class="ft-arrow-right submenu-icon"></i>
                                    <span class="menu-item" data-i18n="کاربران"> کاربران</span>
                                </a>
                            </li>

                            <li class="">
                                <a class="menu-item" asp-area="" asp-controller="" asp-action="">
                                    <i class="ft-arrow-right submenu-icon"></i>
                                    <span class="menu-item" data-i18n="دسترسی ها">دسترسی ها</span>
                                </a>
                            </li>

                        </ul>
                    </li>
                    <!--  پیش بینی بودجه-->
                    <li class="has-sub nav-item">
                        <a class="CollapseForcastManagment" href="#">
                            <div>
                                <i class="ft-arrow-right"></i>
                                <span data-i18n="" class="menu-title">پیش بینی بودجه</span>
                            </div>
                        </a>
                        <ul class="has-sub" id="CurrentCost" parent="CollapseForcastManagment">
                            <li class="has-sub">
                                <a href="#">
                                    <i class="ft-refresh-cw"></i>
                                    <span data-i18n="درآمد جاری" class="menu-title my-font"> درآمد جاری </span>
                                </a>
                                <ul class="menu-content" id="CurrentCost" parent="CollapseForcastManagment">
                                    <li class="nav-item">
                                        <a href="#">
                                            <i class="ft-refresh-cw"></i>
                                            <span data-i18n="تعرفه نصب انشعاب آب" class="menu-title my-font"> تعرفه نصب انشعاب آب </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="#">
                                            <i class="ft-refresh-cw"></i>
                                            <span data-i18n="تعرفه نصب انشعاب فاضلاب" class="menu-title my-font"> تعرفه نصب انشعاب فاضلاب </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="#">
                                            <i class="ft-refresh-cw"></i>
                                            <span data-i18n=" فروش انشعاب آب" class="menu-title my-font"> فروش انشعاب آب </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="#">
                                            <i class="ft-refresh-cw"></i>
                                            <span data-i18n=" فروش انشعاب فاضلاب" class="menu-title my-font"> فروش انشعاب فاضلاب </span>
                                        </a>
                                    </li>
                                </ul>
                            </li>

                        </ul>
                    </li>
                    <!-- کنترل بودجه-->
                    <li class="nav-item">
                        <a href="#">
                            <i class="ft-refresh-cw"></i>
                            <span data-i18n="کنترل بودجه" class="menu-title my-font"> کنترل بودجه </span>
                        </a>
                    </li>
                    <!--  ارزیابی بودجه-->
                    <li class="nav-item">
                        <a href="#">
                            <i class="ft-refresh-cw"></i>
                            <span data-i18n="ارزیابی بودجه" class="menu-title my-font"> ارزیابی بودجه </span>
                        </a>
                    </li>
                    <!--  گزارش-->
                    <li class="nav-item">
                        <a href="#">
                            <i class="ft-refresh-cw"></i>
                            <span data-i18n="گزارش" class="menu-title my-font"> گزارش </span>
                        </a>
                    </li>
                    <!-- تنظیمات نرم افزار-->
                    <li class="has-sub nav-item">
                        <a href="#">
                            <i class="ft-refresh-cw"></i>
                            <span data-i18n="تنظیمات نرم افزار" class="menu-title my-font">تنظیمات نرم افزار</span>
                        </a>
                        <ul class="menu-content" id="AppLogCollapse" parent="AppConfigCollapse">
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString()=="SystemLog" ? "active" : "")">
                                <a class="menu-item" asp-area="@AreaConstants.IdentityArea" asp-controller="SystemLog" asp-action="Index">
                                    <i class="ft-arrow-right submenu-icon"></i><span class="menu-item" data-i18n="گزارش رخ‌ دادهای سیستم">
                                        گزارش رخ‌ دادهای سیستم
                                    </span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
        <!-- main menu content-->
        <!-- / main menu header-->

        <div class="sidebar-background"></div>
        <!-- main menu footer-->
        <!-- include includes/menu-footer-->
        <!-- main menu footer-->
    </div>

    <!-- / main menu-->
    <!-- ////////////////////////////////////////////////////////////////////////////-->

    <div class="sidenav-overlay"></div>
    <div class="drag-target"></div>
    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <script src="~/assets/vendors/js/switchery.min.js"></script>

    <script src="~/assets/vendors/js/chartist.min.js"></script>
    <script src="~/assets/js/core/app-menu.js"></script>
    <script src="~/assets/js/core/app.js"></script>
    <script src="~/assets/js/scroll-top.js"></script>
    <script src="~/assets/js/dashboard.js"></script>
    <script src="~/assets/js/table.js"></script>

    @RenderSection("footSection", required: false)

</body>

</html>