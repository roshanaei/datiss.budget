@model PagerViewModel

@if (Model.PagesCount > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.PageNumber > 1)
            {
                @if (Model.LimitNumber > 1 && Model.TotalLimit > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.ControllerName"
                           asp-action="@Model.ActionName"
                           asp-route-page="@Model.StartPage"
                           asp-route-group = "@Model.GroupName" >
                            <i _ngcontent-dpj-c129="" class="ft ft-chevrons-right"></i>
                        </a>
                    </li>
                }
                <li class="page-item">
                    <a class="page-link"
                       asp-controller="@Model.ControllerName"
                       asp-action="@Model.ActionName"
                       asp-route-page="@Model.PreviousPage"
                       asp-route-group = "@Model.GroupName"
                       aria-label="Previous">
                        <i _ngcontent-dpj-c129="" class="ft ft-arrow-right"></i>
                    </a>
                </li>

            }
            @if (Model.LimitNumber == Model.TotalLimit && Model.TotalLimit > 1)
            {
                @for (int j = Model.PageLimit - 1; j >= 0; j--)
                {
                    if (Model.PagesCount - j == Model.PageNumber)
                    {
                        <li class="page-item active"><a class="page-link" href="#">@((Model.PagesCount - j).ToString()) </a></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="@Model.ControllerName"
                               asp-action="@Model.ActionName"
                               asp-route-group = "@Model.GroupName"
                               asp-route-page="@(Model.PagesCount - j)">@((Model.PagesCount - j).ToString()) </a>
                        </li>
                    }

                }
            }
            else
            {
                @for (int i = ((Model.LimitNumber - 1) * Model.PageLimit) + 1; i <= (Model.LimitNumber * Model.PageLimit) && i <= Model.PagesCount; i++)
                {

                    if (i == Model.PageNumber)
                    {
                        <li class="page-item active"><a class="page-link" href="#">@i.ToString() </a></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="@Model.ControllerName"
                               asp-action="@Model.ActionName"
                               asp-route-group = "@Model.GroupName"
                               asp-route-page="@i">@i.ToString() </a>
                        </li>
                    }

                }
            }

            @if (Model.PageNumber < Model.PagesCount)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-controller="@Model.ControllerName"
                       asp-action="@Model.ActionName"
                       asp-route-page="@Model.NextPage"
                       asp-route-group = "@Model.GroupName"
                       aria-label="Next">
                        <i _ngcontent-dpj-c129="" class="ft ft-arrow-left"></i>
                    </a>
                </li>
                @if (Model.LimitNumber < Model.TotalLimit && Model.TotalLimit > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.ControllerName"
                           asp-action="@Model.ActionName"
                           asp-route-page="@Model.PagesCount"
                            asp-route-group = "@Model.GroupName">
                            <i _ngcontent-dpj-c129="" class="ft ft-chevrons-left"></i>
                        </a>
                    </li>
                }
            }

        </ul>
    </nav>
}