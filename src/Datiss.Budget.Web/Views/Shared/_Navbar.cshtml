@inject IUserContext userContext

<nav class="navbar navbar-expand-lg navbar-light header-navbar navbar-fixed">
    <div class="container-fluid navbar-wrapper">
        <div class="navbar-header d-flex">
            <div id="btnBar" class="navbar-toggle menu-toggle d-xl-none d-block float-left align-items-center justify-content-center" data-toggle="collapse"><i class="ft-menu font-medium-1"></i></div>
            <ul class="navbar-nav">
                <li class="nav-item mr-2 d-none d-lg-block">
                    <a class="nav-link apptogglefullscreen" id="navbar-fullscreen" href="javascript:;"><i class="ft-maximize font-medium-1"></i></a>
                </li>
                <li class="nav-item mr-2 d-none d-lg-block">
                    <img src="~/images/logo/logo.png" alt="" style="height:20px">
                    <span class="my-font font-medium-1 ml-1">
                        شرکت آب و فاضلاب استان مرکزی
                    </span>
                </li>
            </ul>
        </div>

        <div class="navbar-container">
            <div class="collapse navbar-collapse d-block" id="navbarSupportedContent">
                <ul class="navbar-nav">
                    <li class="dropdown nav-item mr-1">
                        <a class="nav-link dropdown-toggle user-dropdown d-flex align-items-end p-1" id="profile" data-toggle="dropdown" data-placement="bottom">
                            <div class="user d-md-flex d-none mr-2">
                                <span class="my-font text-right">
                                    @userContext.DisplayFirstName @userContext.DisplayLastName                                    
                                </span>
                                <span class=" my-font text-right font-small-3">@userContext.OrganizationTitle</span>
                            </div>

                            <img class="mr-3 avatar" src="~/avatars/1.png" height="35" width="35">
                        </a>
                        <div class="dropdown-menu text-left dropdown-menu-right m-0 pb-0" aria-labelledby="profile">
                            <a class="dropdown-item" href="/Identity/UserProfile">
                                <div class="d-flex align-items-center"><i class="ft-user mr-2"></i><span class="my-font">پروفایل کاربر</span></div>
                            </a>

                            <a class="dropdown-item" href="/Identity/ChangePassword">
                                <div class="d-flex align-items-center"><i class="ft-lock mr-2"></i><span class="my-font">تغییر رمز عبور</span></div>
                            </a>

                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="/Identity/LogOff">
                                <div class="d-flex align-items-center"><i class="ft-power mr-2"></i><span class="my-font">خروج</span></div>
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>
<!-- Navbar (Header) Ends-->
