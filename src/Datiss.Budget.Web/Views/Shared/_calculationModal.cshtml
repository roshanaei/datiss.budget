@model CalculationResultViewModel
<!--Modals-->
<div class="modal fade text-left" id="CalculationModal" role="dialog" aria-labelledby="myModalLabel9" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title my-font" id="myModalLabel2">
                    محاسبات
                </h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                </button>
            </div>
            <div class="modal-content">
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table">
                            <tr>
                                <th>عنوان</th>
                                <th>مقدار</th>
                            </tr>
                            <tbody>
                                <tr>
                                    <td>
                                        @Model.Title
                                    </td>
                                    <td>
                                        @Model.Result
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <p>
                        مقدار محاسبه شده : @Model.Result
                    </p>
                    <div>
                        
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary bg-light-secondary mr-1 my-font"
                            data-dismiss="modal">
                        انصراف
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Modals-->