<script type="text/javascript">

    let isNewRow = false;

    function editRow(id) {
        let row = $('#row_' + id);
        //row.css('background-color', '#7598f3');

        //Hide output elements
        $('#divOutput_Year_' + id).hide();
        $('#divOutput_Org_' + id).hide();
        $('#divOutput_DWasteType_' + id).hide();
        $('#divOutput_WsInstallFee_' + id).hide();

        //show input elements
        $('#divInput_Year_' + id).show();
        $('#divInput_Org_' + id).show();
        $('#divInput_DWasteType_' + id).show();
        $('#divInput_WsInstallFee_' + id).show();

        $('#btnEdit_' + id).hide();
        $('#btnDelete_' + id).hide();
        $('#btnSaveEdit_' + id).show();
        $('#btnCancelEdit_' + id).show();
    }

    function cancelEditRow(id) {
        let row = $('#row_' + id);
        //row.css('background-color', '');

        //Hide input elements
        $('#divInput_Year_' + id).hide();
        $('#divInput_Org_' + id).hide();
        $('#divInput_DWasteType_' + id).hide();
        $('#divInput_WsInstallFee_' + id).hide();

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_Org_' + id).show();
        $('#divOutput_DWasteType_' + id).show();
        $('#divOutput_WsInstallFee_' + id).show();

        $('#btnEdit_' + id).show();
        $('#btnDelete_' + id).show();
        $('#btnSaveEdit_' + id).hide();
        $('#btnCancelEdit_' + id).hide();
    }

    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.dWasteTypeId = $('#inputDWasteType_' + id).val();
        model.WsInstallFee = $('#inputWsInstallFee_' + id).val();

        $.ajax({
            url: '@Url.Action(WasteInstallFeeController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                    alert(data._ErrorMessage);
                    return;
                }

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanDWasteType_' + id).text(data.dWasteTypeDisplay);
                $('#spanWsInstallFee_' + id).text(data.WsInstallFee);

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                alert('خطا در بروز رسانی اطلاعات. لطفاً دوباره سعی نمایید!');
            }
        });
    }

    function saveNewRow(e) {
        console.log(e);

        var model = {};
        model.yearId = $(e).find('#inputYear_').val();
        model.organizationId = $(e).find('#inputOrg_').val();
        model.dWasteTypeId = $(e).find('#inputDWasteType_').val();
        model.wsInstallFee = $(e).find('#inputWsInstallFee_').val();

        $.ajax({
            url: '@Url.Action(WasteInstallFeeController.ACTION_Create)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data._ErrorMessage}</span>`,
                        type: 'error',
                        animation: false,
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }
                //Year
                $(e).find('#divInput_Year_').attr('id', 'divInput_Year_' + data.id);
                $(e).find('#hidYearId_').attr('id', 'hidYearId_' + data.id);
                $(e).find('#inputYear_').attr('id', 'inputYear_' + data.id);
                $(e).find('#divOutput_Year_').attr('id', 'divOutput_Year_' + data.id);
                $(e).find('#spanYear_').attr('id', 'spanYear_' + data.id);

                $('#divInput_Year_' + data.id).hide();
                $('#spanYear_' + data.id).text(data.year);
                $('#divOutput_Year_' + data.id).show();

                //Organization
                $(e).find('#divInput_Org_').attr('id', 'divInput_Org_' + data.id);
                $(e).find('#hidOrgId_').attr('id', 'hidOrgId_' + data.id);
                $(e).find('#inputOrg_').attr('id', 'inputOrg_' + data.id);
                $(e).find('#divOutput_Org_').attr('id', 'divOutput_Org_' + data.id);
                $(e).find('#spanOrg_').attr('id', 'spanOrg_' + data.id);

                $('#divInput_Org_' + data.id).hide();
                $('#spanOrg_' + data.id).text(data.organizationDisplay);
                $('#divOutput_Org_' + data.id).show();

                //DWasteType
                $(e).find('#divInput_DWasteType_').attr('id', 'divInput_DWasteType_' + data.id);
                $(e).find('#hidDWasteTypeId_').attr('id', 'hidDWasteTypeId_' + data.id);
                $(e).find('#inputDWasteType_').attr('id', 'inputDWasteType_' + data.id);
                $(e).find('#divOutput_DWasteType_').attr('id', 'divOutput_DWasteType_' + data.id);
                $(e).find('#spanDWasteType_').attr('id', 'spanDWasteType_' + data.id);

                $('#divInput_DWasteType_' + data.id).hide();
                $('#spanDWasteType_' + data.id).text(data.dWasteTypeDisplay);
                $('#divOutput_DWasteType_' + data.id).show();

                //WsInstallFee
                $(e).find('#divInput_WsInstallFee_').attr('id', 'divInput_WsInstallFee_' + data.id);
                $(e).find('#inputWsInstallFee_').attr('id', 'inputWsInstallFee_' + data.id);
                $(e).find('#divOutput_WsInstallFee_').attr('id', 'divOutput_WsInstallFee_' + data.id);
                $(e).find('#spanWsInstallFee_').attr('id', 'spanWsInstallFee_' + data.id);

                $('#divInput_WsInstallFee_' + data.id).hide();
                $('#spanWsInstallFee_' + data.id).text(data.wsInstallFee);
                $('#divOutput_WsInstallFee_' + data.id).show();

                //Buttons
                $(e).find('#btnEdit_').data('id', data.id);
                $(e).find('#btnDelete_').data('id', data.id);
                $(e).find('#btnSaveEdit_').data('id', data.id);
                $(e).find('#btnCancelEdit_').data('id', data.id);
                $(e).find('#btnSaveCreate_').data('id', data.id);
                $(e).find('#btnCancelCreate_').data('id', data.id);

                $(e).find('#btnEdit_').attr('id', 'btnEdit_' + data.id);
                $(e).find('#btnDelete_').attr('id', 'btnDelete_' + data.id);
                $(e).find('#btnSaveEdit_').attr('id', 'btnSaveEdit_' + data.id);
                $(e).find('#btnCancelEdit_').attr('id', 'btnCancelEdit_' + data.id);
                $(e).find('#btnSaveCreate_').attr('id', 'btnSaveCreate_' + data.id);
                $(e).find('#btnCancelCreate_').attr('id', 'btnCancelCreate_' + data.id);

                $('#btnSaveCreate_' + data.id).hide();
                $('#btnCancelCreate_' + data.id).hide();
                $('#btnEdit_' + data.id).show();
                $('#btnDelete_' + data.id).show();

                $(e).css('background-color', '');
                isNewRow = false;
            },
            error: function (request, options, err) {
                alert('خطا در بروز رسانی اطلاعات. لطفاً دوباره سعی نمایید!');
            }
        });
    }

    function addNewRow() {
        if (isNewRow) return;

        var template = $('#rowTemplate').clone()
            .appendTo($('#my-table tbody'))
            .attr('id', 'newRow')
            .css('background-color', 'rgb(230 247 228)')
            .show();

        $('.selectOrganization:last').select2({
            dir: 'rtl'
        });

        $('.selectDWaterType:last').select2({
            dir: 'rtl'
        });

        isNewRow = true;
    }

    function cancelNewRow(e) {
        $(e).closest('tr').remove();
        isNewRow = false;
    }

    function deleteRow(e, id) {
        console.log(e);

        $.ajax({
            url: '@Url.Action(WasteInstallFeeController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
                if (data.hasError) {
                    alert(data.message);
                    return;
                }

                $(e).closest('tr').remove();
            },
            error: function (request, options, err) {
                console.log(err);
                alert('خطا در بروز رسانی اطلاعات. لطفاً دوباره سعی نمایید!');
            }
        });
    }

</script>