@model CopyViewModel
 <!--Modals-->
<div class="modal fade text-left" id="CopyModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel2" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title my-font" id="myModalLabel2">کپی اطلاعات</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                </button>
            </div>
            <form asp-controller="@WaterSalesSplitController.Name"
                  asp-action="@WaterSalesSplitController.ACTION_Copy"
                  method="post"
                  asp-antiforgery="true">
                <div class="modal-body">
                    <p class="my-font-bold">انتخاب اطلاعات مبدا</p>

                    <div class="rowACJSB">
                        <div class="my-font" style="flex:1">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-left:5px">سال:</span>
                                    <select asp-for="SourceYearId"
                                            style="flex:1"
                                            asp-items="Model.YearSource"
                                            class="form-control form-control-sm d-inline-block">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                        <div class="my-font" style="flex:1.5">
                            <fieldset class="form-group">
                                <label class="rowAC">
                                    <span style="margin-right:10px;margin-left:5px">سازمان:</span>
                                    <select asp-for="SourceOrgId"
                                            style="flex:1"
                                            asp-items="Model.OrganizationSource"
                                            class="form-control form-control-sm d-inline-block">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                    </div>


                    <hr>
                    <p class="my-font-bold">انتخاب اطلاعات مقصد</p>
                    <div class="rowAC">
                        <div style="flex:1">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-left:5px">سال:</span>
                                    <select asp-for="TargetYearId"
                                            asp-items="Model.YearSource"
                                            style="flex:1"
                                            class="form-control form-control-sm d-inline-block width-100">
                                    </select>
                                </label>
                            </fieldset>
                        </div>
                        <div style="flex:1.5" />
                    </div>


                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-warning bg-light-warning mr-1 my-font">ثبت</button>
                </div>
            </form>

        </div>
    </div>
</div>
<!--Modals-->