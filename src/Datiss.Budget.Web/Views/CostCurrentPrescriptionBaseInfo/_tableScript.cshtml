    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.fixSalary = $('#inputFixSalary_' + id).val();
        model.houseRt = $('#inputHouseRt_' + id).val();
        model.employRight = $('#inputEmployRight_' + id).val();
        model.regionRight = $('#inputRegionRight_' + id).val();
        model.copun = $('#inputCopun_' + id).val();
        model.childRt = $('#inputChildRt_' + id).val();
        model.stuffRt = $('#inputStuffRt_' + id).val();
        model.hardWorkingRt = $('#inputHardWorkingRt_' + id).val();
        model.healths = $('#inputHealths_' + id).val();
        model.newFixSalary = $('#inputNewFixSalary_' + id).val();

        $.ajax({
            url: '@Url.Action(CostCurrentPrescriptionBaseInfoController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.fixSalary = model.fixSalary;
                rowData.houseRt = model.houseRt;
                rowData.employRight = model.employRight;
                rowData.regionRight = model.regionRight;
                rowData.copun = model.copun;
                rowData.childRt = model.childRt;
                rowData.stuffRt = model.stuffRt;
                rowData.hardWorkingRt = model.hardWorkingRt;
                rowData.healths = model.healths;
                rowData.newFixSalary = model.newFixSalary;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidFIxSalary_' + id).attr('value', model.fixSalary);
                $('#spanYear_' + id).text(data.year);
                $('#spanFixSalary_' + id).text(data.fixSalaryDisplay);
                $('#spanHouseRt_' + id).text(data.houseRt);
                $('#spanEmployRight_' + id).text(data.employRight);
                $('#spanRegionRight_' + id).text(data.regionRight);
                $('#spanCopun_' + id).text(data.copun);
                $('#spanChildRt_' + id).text(data.childRt);
                $('#spanStuffRt_' + id).text(data.stuffRt);
                $('#spanHardWorkingRt_' + id).text(data.hardWorkingRt);
                $('#spanHealths_' + id).text(data.healths);
                $('#spanNewFixSalary_' + id).text(data.newFixSalary);
                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

