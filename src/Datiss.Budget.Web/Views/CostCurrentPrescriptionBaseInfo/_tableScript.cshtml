            $('#inputStuffRt_' + id).val(rowData.stuffRt);
            $('#inputHardWorkingRt_' + id).val(rowData.hardWorkingRt);
            $('#inputHealths_' + id).val(rowData.healths);
            $('#inputNewFixSalary_' + id).val(rowData.newFixSalary);
        }

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_FixSalary_' + id).show();
        $('#divOutput_HouseRt_' + id).show();
