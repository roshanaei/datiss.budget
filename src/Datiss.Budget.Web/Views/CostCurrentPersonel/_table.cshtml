@model CostCurrentPersonelIndexViewModel
<div class="table-responsive">
    <table style="width:100%" id="my-table" class="table table-hover table-bordered m-0 my-font table-overflow">
        <thead class="thead-light">
            <tr>

                <th style="min-width:180px ; font-size:smaller">سازمان</th>
                <th style="min-width:210px; font-size:smaller">نام</th>
                <th style="min-width:150px; font-size:smaller">مرکزهزینه</th>
                <th style="min-width:150px; font-size:smaller">کد پرسنلی</th>
                <th style="min-width:150px; font-size:smaller">نوع قرارداد</th>
                <th style="min-width:150px; font-size:smaller">مزد ثابت</th>
                <th style="min-width:150px; font-size:smaller">حق جذب</th>
                <th style="min-width:150px; font-size:smaller">فوق العاده منطقه</th>
                <th width="10%">مدیریت</th>

            </tr>
        </thead>
        <tbody>
            <tr id="rowTemplate" style="display: none">
            </tr>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.OrganizationDisplay</td>
                    <td>@item.FirstName @item.LastName </td>
                    <td>@item.CostCenterTypeDisplay</td>
                    <td>@item.PersonelCode</td>
                    <td>@item.ContractTypeDisplay</td>
                    <td>@item.FixSalaryDisplay</td>
                    <td>@item.EmployRightDisplay</td>
                    <td>@item.RegionRightDisplay</td>
                    <td>
                        <span data-toggle="modal" data-target="#EditModal">
                            <button value="@item.Id" data-toggle="tooltip" data-placement="top" title="ویرایش اطلاعات" type="button" name="btnEdit" class="btn bg-light-info btn-info mr-1 my-font modallink" onclick="Edit(@item.Id)">
                                <i _ngcontent-dpj-c129="" class="fa fa-edit"></i>
                            </button>
                        </span>
                        <span>
                            <button id="btnDelete_@item.Id" data-id="@item.Id" value="@item.Id" data-toggle="tooltip" data-placement="top" title="حذف رکورد" type="button" name="btnDelete" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                                <i _ngcontent-dpj-c129="" class="fa fa-trash-o"></i>
                            </button>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="rowACJSB" style="margin-top:20px">
    <!--Tools-->
    <div class="rowACJS">
        <form id="toolForm"
              enctype="multipart/form-data"
              method="post"
              asp-antiforgery="true">
            <input name="filterYearId" type="hidden" value="@Model.Filter.YearId" />
            <input name="filterOrganizationId" type="hidden" value="@Model.Filter.OrganizationId" />

            <span data-toggle="modal" data-target="#backdrop">
                <button data-toggle="" data-placement="top" title="" type="button" name="btnExcelImport" onclick="openImportExcelForm();" class="btn btn-secondary bg-light-secondary mr-1 my-font">
                    <i _ngcontent-dpj-c129="" class="fa fa-cloud-upload"><span class="my-font" style="font-size:small">   ورود اطلاعات پایه</span></i>
                </button>
            </span>
            <span data-toggle="modal" data-target="#CopyModal">
                <button data-toggle="" data-placement="top" title="" type="button" id="btnDoCopy" name="btnCopy" class="btn btn-warning bg-light-warning mr-1 my-font openCopy">
                    <i _ngcontent-dpj-c129="" class="fa fa-copy"><span class="my-font" style="font-size:small">   ایجاد پیش بینی</span></i>
                </button>
            </span>
            <button data-toggle="" data-placement="top" title="" type="button" onclick="return hardDelete(this.click);" name="btnDelete" class="btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                <i _ngcontent-dpj-c129="" class="fa fa-trash"><span class="my-font" style="font-size:small">   حذف اطلاعات</span></i>
            </button>
            <span data-toggle="modal" data-target="#CalculationModal">
                <button data-toggle="" data-placement="top" title="" type="button" name="btnCalculaton" class="btn btn-info calculation-button bg-light-info mr-1 my-font">
                    <i _ngcontent-dpj-c129="" class="fa fa-calculator"><span class="my-font" style="font-size:small">   ثبت اطلاعات پیش بینی</span></i>
                </button>
            </span>
        </form>

    </div>
    <div class="rowAC">
        <div class="my-font">کل رکوردها: <b class="font-medium-2">@Model.TotalCount</b></div>
        <div class="my-font ml-2">(صفحه <b class="font-medium-2">@Model.PageNumber</b> از <b class="font-medium-2">@Model.PagesCount</b>)</div>
    </div>
    <!--Pagination-->
    <vc:pager model="Model.ToPager()" controller-name="@CostCurrentPersonelController.Name" action-name="@CostCurrentPersonelController.ACTION_Index"></vc:pager>
</div>