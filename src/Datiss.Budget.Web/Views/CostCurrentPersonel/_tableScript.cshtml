        $('#divInput_Year_' + id).show();
        $('#divInput_Org_' + id).show();
        $('#divInput_ExtensionType_' + id).show();
        $('#divInput_SuggestedBudgetTopicType_' + id).show();
        $('#divInput_ProjectDescription_' + id).show();
        $('#divInput_WasteInvestorsType_' + id).show();
        $('#divInput_CostCenterType_' + id).show();
        $('#divInput_ExploitationAreaType_' + id).show();
        $('#divInput_ProgressPercent_' + id).show();
        $('#divInput_CostDone_' + id).show();
        $('#divInput_Amount_' + id).show();
        $('#divInput_MeasurementType_' + id).show();
        $('#divInput_UnitPrice_' + id).show();
        $('#divInput_TotalCost_' + id).show();
