    function RelatedDropDown(e, event) {
        let jobStatusTypeid = event.target.value;
        FillDropDown(jobStatusTypeid);
    }

    function FillDropDown(id, selectval = null) {

        let key = jobStatusType_source[id];

        $.ajax({
            url: '@Url.Action("GetJobStatusDetailType")',
            type: 'POST',
            dataType: 'json',
            data: {
                'key': key
                }
        }).done(function (data) {
            var options = $('.selectJobStatusDetailType');
            options.empty();
            $.each(data,
                function (i, item) {
                    options.append($('<option />')
                        .val(item.id)
                        .text(item.title));
                });
            if (selectval != null) {
                options.val(selectval);
            }
        }).fail(function (error) {
            alert(error);
        });
    }


