        $(document).on('click', '#btnDoEdit', function () {

            $('#spanTitle').text('');
            $('#Title').removeClass("error-border");

            $('#spanDisplayOrder').text('');
            $('#DisplayOrder').removeClass("error-border");

            let model = {};

            model.id = $('#Id').val()
            model.title = $('#Title').val();
            model.parentId = $('#ParentId option:selected').val();
            model.type = $('#Type option:selected').val();
            model.sewageStatus = $('#SewageStatus option:selected').val();
            model.displayOrder = $('#DisplayOrder').val();
            model.enabled = $('input[name="Enabled"]:checked').val();


            if (model.title == '') {
                $('#Title').addClass("error-border");
                $('#divError').show();
                $('#spanTitle').text('لطفا عنوان سازمان را وارد نمایید .');
                return;
            }
            if (model.displayOrder < '0' || model.displayOrder == '') {
                $('#DisplayOrder').addClass("error-border");
                $('#divError').show();
                $('#spanDisplayOrder').text('لطفا ترتیب نمایش را صحیح وارد کنید .');
                return;
            }


            $.ajax({
                type: 'POST',
                url: '@Url.Action(CostCurrentPersonelController.ACTION_Edit)',
                data: model,
                dataType: 'json',
                success: function (data, status, settings) {
                    if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                    }

                    Swal.fire({
                        title: '<span class="my-font">عملیات موفق</span>',
                        html: '<span class="my-font">عملیات ویرایش سازمان با موفقیت انجام شد.</span>',
                        type: 'success',
                        confirmButtonColor: '#2F8BE6',
                        animation: true,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-secondary mr-1 my-font',
                        buttonsStyling: false,
                    }).then(function(result) {
                        document.location.href = '@Url.Action(CostCurrentPersonelController.ACTION_Index)';
                    });
                },
                error: function (request, options, err) {
                    console.log(err);
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">عملیات ویرایش سازمان با خطا مواجه شد.</span>`,
                        type: 'error',
                        confirmButtonColor: '#2F8BE6',
                        animation: false,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                }
            });
        });



    function resetTableBackColor(id) {
        var table = document.getElementById(id);
        var rows = table.getElementsByTagName("tr");
        for (i = 2; i < rows.length - 1; i++) {
            rows[i].style = "";
        }
    }

    function RelatedDropDown(e, event) {
        let extensionTypeid = event.target.value;
        FillDropDown(extensionTypeid);
    }

    function FillDropDown(id, selectval = null) {

        let key = extensionType_source[id];

        if (key != 'Extension.Yes') {
            key = 'Extension.NO';
        }

        $.ajax({
            url: '@Url.Action("GetSuggestedBudgetTopicAsync")',
            type: 'POST',
            dataType: 'json',
            data: {
                'key': key
                }
        }).done(function (data) {
            var options = $('.selectSuggestedBudgetTopicType');
            options.empty();
            $.each(data,
                function (i, item) {
                    options.append($('<option />')
                        .val(item.id)
                        .text(item.title));
                });
            if (selectval != null) {
                options.val(selectval);
            }
        }).fail(function (error) {
            alert(error);
        });
    }


</script>