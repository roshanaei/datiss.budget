<script type="text/javascript">

    let isNewRow = false;
    let rowData = {};

    function editRow(id) {

        let activityType = $('#inputActivityType_' + id).val();
        let ccInstallationTypeId = $('#inputCCInstallationType_' + id).val();
        FillDropDown(activityType, ccInstallationTypeId);

        resetTableBackColor("my-table");

        let row = $('#row_' + id);

        //Hide output elements
        $('#divOutput_Year_' + id).hide();
        $('#divOutput_Org_' + id).hide();
        $('#divOutput_ActivityType_' + id).hide();
        $('#divOutput_CCInstallationType_' + id).hide();
        $('#divOutput_NumberUser_' + id).hide();
        $('#divOutput_Cost_' + id).hide();
        $('#divOutput_Income_' + id).hide();

        //show input elements
        $('#divInput_Year_' + id).show();
        $('#divInput_Org_' + id).show();
        $('#divInput_ActivityType_' + id).show();
        $('#divInput_CCInstallationType_' + id).show();
        $('#divInput_NumberUser_' + id).show();
        $('#divInput_Cost_' + id).show();
        $('#divInput_Income_' + id).show();

        $('#btnEdit_' + id).hide();
        $('#btnDelete_' + id).hide();
        $('#btnSaveEdit_' + id).show();
        $('#btnCancelEdit_' + id).show();

        rowData = {};
        rowData.yearId = $('#inputYear_' + id).val();
        rowData.organizationId = $('#inputOrg_' + id).val();
        rowData.activityType = $('#inputActivityType_' + id).val();
        rowData.ccInstallationTypeId = $('#inputCCInstallationType_' + id).val();
        rowData.numberUser = $('#inputNumberUser_' + id).val();
        rowData.cost = $('#inputCost_' + id).val();
        rowData.income = $('#inputIncome_' + id).val();
    }

    function cancelEditRow(id) {
        let row = $('#row_' + id);
        //row.css('background-color', '');

        //Hide input elements
        $('#divInput_Year_' + id).hide();
        $('#divInput_Org_' + id).hide();
        $('#divInput_ActivityType_' + id).hide();
        $('#divInput_CCInstallationType_' + id).hide();
        $('#divInput_NumberUser_' + id).hide();
        $('#divInput_Cost_' + id).hide();
        $('#divInput_Income_' + id).hide();

        //Retriving to OrginalData
        if (rowData != null) {
            $('#inputYear_' + id).val(rowData.yearId);
            $('#inputOrg_' + id).val(rowData.organizationId);
            $('#inputActivityType_' + id).val(rowData.activityType);
            $('#inputCCInstallationType_' + id).val(rowData.ccInstallationTypeId);
            $('#inputNumberUser_' + id).val(rowData.numberUser);
            $('#inputCost_' + id).val(rowData.cost);
            $('#inputIncome_' + id).val(rowData.income);
        }

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_Org_' + id).show();
        $('#divOutput_ActivityType_' + id).show();
        $('#divOutput_CCInstallationType_' + id).show();
        $('#divOutput_NumberUser_' + id).show();
        $('#divOutput_Cost_' + id).show();
        $('#divOutput_Income_' + id).show();

        $('#btnEdit_' + id).show();
        $('#btnDelete_' + id).show();
        $('#btnSaveEdit_' + id).hide();
        $('#btnCancelEdit_' + id).hide();
        $('th,tr td').hide();
        showingColmuns.split(',').forEach((value, index) => {
            if (value !== '') {
                $(`th:nth-child(${value}), tr td:nth-child(${value})`).show();
            }
        })
        $(`th:last-child, tr td:last-child`).show();

    }

    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.activityType = $('#inputActivityType_' + id).val();
        model.ccInstallationTypeId = $('#inputCCInstallationType_' + id).val();
        model.numberUser = $('#inputNumberUser_' + id).val();
        model.cost = $('#inputCost_' + id).val();
        model.income = $('#inputIncome_' + id).val();

        $.ajax({
            url: '@Url.Action(ConsumeForcastController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.activityType = model.activityType;
                rowData.ccInstallationTypeId = model.ccInstallationTypeId;
                rowData.numberUser = model.numberUser;
                rowData.cost = model.cost;
                rowData.income = model.income;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanActivityType_' + id).text(data.activityTypeDisplay);
                $('#spanCCInstalationType_' + id).text(data.ccInstalationTypeDisplay);
                $('#spanNumberUser_' + id).text(data.numberUser);
                $('#spanCost_' + id).text(data.cost);
                $('#spanIncome_' + id).text(data.income);
                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function saveNewRow(e) {

        resetTableBackColor("my-table");

        var model = {};
        model.yearId = $(e).find('#inputYear_').val();
        model.organizationId = $(e).find('#inputOrg_').val();
        model.activityType = $(e).find('#inputActivityType_').val();
        model.ccInstallationTypeId = $(e).find('#inputCCInstalationType_').val();
        model.numberUser = $(e).find('#inputNumberUser_').val();
        if (model.numberUser == "") {
            model.numberUser = 0;
        }
        model.cost = $(e).find('#inputCost_').val();
        if (model.cost == "") {
            model.cost = 0;
        }
        model.income = $(e).find('#inputIncome_').val();
        if (model.income == "") {
            model.income = 0;
        }

        $.ajax({
            url: '@Url.Action(ConsumeForcastController.ACTION_Create)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data._ErrorMessage}</span>`,
                        type: 'error',
                        animation: false,
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                console.log(data);

                //Year
                $(e).find('#divInput_Year_').attr('id', 'divInput_Year_' + data.id);
                $(e).find('#hidYearId_').attr('id', 'hidYearId_' + data.id);
                $(e).find('#inputYear_').attr('id', 'inputYear_' + data.id);
                $(e).find('#divOutput_Year_').attr('id', 'divOutput_Year_' + data.id);
                $(e).find('#spanYear_').attr('id', 'spanYear_' + data.id);

                $('#divInput_Year_' + data.id).hide();
                $('#spanYear_' + data.id).text(data.year);
                $('#divOutput_Year_' + data.id).show();

                //Organization
                $(e).find('#divInput_Org_').attr('id', 'divInput_Org_' + data.id);
                $(e).find('#hidOrgId_').attr('id', 'hidOrgId_' + data.id);
                $(e).find('#inputOrg_').attr('id', 'inputOrg_' + data.id);
                $(e).find('#divOutput_Org_').attr('id', 'divOutput_Org_' + data.id);
                $(e).find('#spanOrg_').attr('id', 'spanOrg_' + data.id);

                $('#divInput_Org_' + data.id).hide();
                $('#spanOrg_' + data.id).text(data.organizationDisplay);
                $('#divOutput_Org_' + data.id).show();

                //ActivityType
                $(e).find('#divInput_ActivityType_').attr('id', 'divInput_ActivityType_' + data.id);
                $(e).find('#inputActivityType_').attr('id', 'inputActivityType_' + data.id);
                $(e).find('#divOutput_ActivityType_').attr('id', 'divOutput_ActivityType_' + data.id);
                $(e).find('#spanActivityType_').attr('id', 'spanActivityType_' + data.id);

                $('#divInput_ActivityType_' + data.id).hide();
                $('#spanActivityType_' + data.id).text(data.activityTypeDisplay);
                $('#divOutput_ActivityType_' + data.id).show();


                //CCInstalationType
                $(e).find('#divInput_CCInstalationType_').attr('id', 'divInput_CCInstalationType_' + data.id);
                $(e).find('#hidCCInstalationTypeId_').attr('id', 'hidCCInstalationTypeId_' + data.id);
                $(e).find('#inputCCInstalationType_').attr('id', 'inputCCInstalationType_' + data.id);
                $(e).find('#divOutput_CCInstalationType_').attr('id', 'divOutput_CCInstalationType_' + data.id);
                $(e).find('#spanCCInstalationType_').attr('id', 'spanCCInstalationType_' + data.id);

                $('#divInput_CCInstalationType_' + data.id).hide();
                $('#spanCCInstalationType_' + data.id).text(data.ccInstalationTypeDisplay);
                $('#divOutput_CCInstalationType_' + data.id).show();

                //NumberUser
                $(e).find('#divInput_NumberUser_').attr('id', 'divInput_NumberUser_' + data.id);
                $(e).find('#inputNumberUser_').attr('id', 'inputNumberUser_' + data.id);
                $(e).find('#divOutput_NumberUser_').attr('id', 'divOutput_NumberUser_' + data.id);
                $(e).find('#spanNumberUser_').attr('id', 'spanNumberUser_' + data.id);

                $('#divInput_NumberUser_' + data.id).hide();
                $('#spanNumberUser_' + data.id).text(data.numberUser);
                $('#divOutput_NumberUser_' + data.id).show();

                //Cost
                $(e).find('#divInput_Cost_').attr('id', 'divInput_Cost_' + data.id);
                $(e).find('#inputCost_').attr('id', 'inputCost_' + data.id);
                $(e).find('#divOutput_Cost_').attr('id', 'divOutput_Cost_' + data.id);
                $(e).find('#spanCost_').attr('id', 'spanCost_' + data.id);

                $('#divInput_Cost_' + data.id).hide();
                $('#spanCost_' + data.id).text(data.cost);
                $('#divOutput_Cost_' + data.id).show();

                //Income
                $(e).find('#divInput_Income_').attr('id', 'divInput_Income_' + data.id);
                $(e).find('#inputIncome_').attr('id', 'inputIncome_' + data.id);
                $(e).find('#divOutput_Income_').attr('id', 'divOutput_Income_' + data.id);
                $(e).find('#spanIncome_').attr('id', 'spanIncome_' + data.id);

                $('#divInput_Income_' + data.id).hide();
                $('#spanIncome_' + data.id).text(data.income);
                $('#divOutput_Income_' + data.id).show();

                //Buttons
                $(e).find('#btnEdit_').data('id', data.id);
                $(e).find('#btnDelete_').data('id', data.id);
                $(e).find('#btnSaveEdit_').data('id', data.id);
                $(e).find('#btnCancelEdit_').data('id', data.id);
                $(e).find('#btnSaveCreate_').data('id', data.id);
                $(e).find('#btnCancelCreate_').data('id', data.id);

                $(e).find('#btnEdit_').attr('id', 'btnEdit_' + data.id);
                $(e).find('#btnDelete_').attr('id', 'btnDelete_' + data.id);
                $(e).find('#btnSaveEdit_').attr('id', 'btnSaveEdit_' + data.id);
                $(e).find('#btnCancelEdit_').attr('id', 'btnCancelEdit_' + data.id);
                $(e).find('#btnSaveCreate_').attr('id', 'btnSaveCreate_' + data.id);
                $(e).find('#btnCancelCreate_').attr('id', 'btnCancelCreate_' + data.id);

                $('#btnSaveCreate_' + data.id).hide();
                $('#btnCancelCreate_' + data.id).hide();
                $('#btnEdit_' + data.id).show();
                $('#btnDelete_' + data.id).show();

                $('#inputOrg_' + data.id).select2();
                $(e).css('background-color', 'rgb(245 245 246)');
                isNewRow = false;
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function addNewRow() {
        if (isNewRow) return;

        resetTableBackColor("my-table");

        let activityType = $('#inputActivityType_').val();
        FillDropDown(activityType);


        var template = $('#rowTemplate').clone()
            .appendTo($('#my-table tbody'))
            .attr('id', 'newRow')
            .css('background-color', 'rgb(230 247 228)')
            .show();

        $('.selectOrganization:last').select2({
            dir: 'rtl'
        });

        $('.input-keyup').keyup(function (event) {
            event.preventDefault();
            if (event.keyCode === 13) {
                let row = $(this).closest('tr');
                saveNewRow(row);
            }
        });

        let newRowElement = document.getElementById('newRow');
        newRowElement.scrollIntoView();
        $('.default-input:last').focus();

        isNewRow = true;
    }

    function cancelNewRow(e) {
        $(e).closest('tr').remove();
        isNewRow = false;
    }

    function deleteRow(e, id) {
        console.log(e);

        $.ajax({
            url: '@Url.Action(ConsumeForcastController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
                if (data.hasError) {
                    alert(data.message);
                    return;
                }

                $(e).closest('tr').remove();
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function resetTableBackColor(id) {
        var table = document.getElementById(id);
        var rows = table.getElementsByTagName("tr");
        for (i = 2; i < rows.length - 1; i++) {
            rows[i].style = "";
        }
    }

    function RelatedDropDown(e, event) {
        let activityType = event.target.value;
        FillDropDown(activityType);
    }

    function FillDropDown(actype, selectval = null) {

        let key;
        if (actype == 0) {
            key = 0;
        }
        else {
            key = 1;
        }

        $.ajax({
            url: '@Url.Action("GetCCIAsync")',
            type: 'POST',
            dataType: 'json',
            data: {
                'key': key
                }
        }).done(function (data) {
            var options = $('.selectCCInstallationType');
            options.empty();
            $.each(data,
                function (i, item) {
                    options.append($('<option />')
                        .val(item.id)
                        .text(item.title));
                });
            if (selectval != null) {
                options.val(selectval);
            }
        }).fail(function (error) {
            alert(error);
        });
    }

</script>