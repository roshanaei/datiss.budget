    function saveEditRow(id) {

        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#yearId option:selected').val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.assetTypeId = $('#inputAssetType_' + id).val();
        model.assetDetailTypeId = $('#inputAssetDetailType_' + id).val();
        model.buyDescription = $('#inputBuyDescription_' + id).val();
        model.buyDepartmentId = $('#inputBuyDepartmentType_' + id).val();
        model.costCenterTypeId = $('#inputCostCenterType_' + id).val();
        model.measurementTypeId = $('#inputMeasurementType_' + id).val();
        model.amount = $('#inputAmount_' + id).val();
        model.unitPrice = $('#inputUnitPrice_' + id).val();
        model.proposedCost = $('#inputProposedCost_' + id).val();
        model.creditTypeId = $('#inputCreditType_' + id).val();
        model.locationId = $('#inputLocationType_' + id).val();
        
        console.log(model);

        $.ajax({
            url: '@Url.Action(CostForcastBuyController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }


                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.assetTypeId = model.assetTypeId;
                rowData.assetDetailTypeId = model.assetDetailId;
                rowData.buyDescription = model.buyDescription;
                rowData.buyDepartmentType = model.buyDepartmentId;
                rowData.costCenterType = model.costCenterTypeId;
                rowData.measurementType = model.measurementTypeId;
                rowData.amount = model.amount;
                rowData.unitPrice = model.unitPrice;
                rowData.proposedCost = model.proposedCost;
                rowData.locationType = model.locationId;
                rowData.creditType = model.creditTypeId;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
