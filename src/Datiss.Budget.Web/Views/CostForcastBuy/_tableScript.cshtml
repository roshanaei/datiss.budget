                $('#spanAmount_' + id).text(data.amount);
                $('#spanUnitPrice_' + id).text(data.unitPrice);
                $('#spanProposedCost_' + id).text(data.proposedCost);
                $('#spanCreditType_' + id).text(data.creditTypeDisplay);
                $('#spanLocationType_' + id).text(data.locationDisplay);

                $('#row_' + id).css('background-color', 'rgb(245 245 246)');
