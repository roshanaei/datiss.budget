        model.fixCostNote11HWs = $('#inputFixCostNote11HWs_' + id).val();
        model.fixCostNote11NHWs = $('#inputFixCostNote11NHWs_' + id).val();
        model.wsTubingCost = $('#inputWsTubingCost_' + id).val();


        $.ajax({
            url: '@Url.Action(BranchFeeAmountController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.urbanAdjustmentFactor = model.urbanAdjustmentFactor;
                rowData.wasteRateInWater = model.wasteRateInWater;
                rowData.waterBranchingPerHousing = model.waterBranchingPerHousing;
                rowData.tubingCost = model.tubingCost;
                rowData.waterPartnershipAmountDomestic = model.waterPartnershipAmountDomestic;
                rowData.waterPartnershipAmountNDomestic = model.waterPartnershipAmountNDomestic;
                rowData.wastePartnershipAmountDomestic = model.wastePartnershipAmountDomestic;
                rowData.wastePartnershipAmountNDomestic = model.wastePartnershipAmountNDomestic;
                rowData.fixCostNote11H = model.fixCostNote11H;
                rowData.fixCostNote11NH = model.fixCostNote11NH;
                rowData.fixCostNote11HWs = model.fixCostNote11HWs;
                rowData.fixCostNote11NHWs = model.fixCostNote11NHWs;
                rowData.wsTubingCost = model.fixCostNote11NHWs;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanUrbanAdjustmentFactor_' + id).text(data.urbanAdjustmentFactor);
                $('#spanWasteRateInWater_' + id).text(data.wasteRateInWater);
                $('#spanWaterBranchingPerHousing_' + id).text(data.waterBranchingPerHousing);
                $('#spanTubingCost_' + id).text(data.tubingCost);
                $('#spanWaterPartnershipAmountDomestic_' + id).text(data.waterPartnershipAmountDomestic);
                $('#spanWaterPartnershipAmountNDomestic_' + id).text(data.waterPartnershipAmountNDomestic);
                $('#spanWastePartnershipAmountDomestic_' + id).text(data.wastePartnershipAmountDomestic);
                $('#spanWastePartnershipAmountNDomestic_' + id).text(data.wastePartnershipAmountNDomestic);
                $('#spanFixCostNote11H_' + id).text(data.fixCostNote11H);
                $('#spanFixCostNote11NH_' + id).text(data.fixCostNote11NH);
                $('#spanFixCostNote11HWs_' + id).text(data.fixCostNote11HWs);
                $('#spanFixCostNote11NHWs_' + id).text(data.fixCostNote11NHWs);
                $('#spanWsTubingCost_' + id).text(data.wsTubingCost);

                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
