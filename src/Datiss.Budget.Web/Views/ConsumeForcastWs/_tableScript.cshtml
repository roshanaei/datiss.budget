    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.userTypeId = $('#inputUserType_' + id).val();
        model.usageLayerId = $('#inputUsageLayerType_' + id).val();
        model.countUser = $('#inputCountUser_' + id).val();
        model.unitUser = $('#inputUnitUser_' + id).val();
        model.consumeUser = $('#inputConsumeUser_' + id).val();
        model.avgConsumeUser = $('#inputAvgConsumeUser_' + id).val();
        model.consumeUserForcast = $('#inputConsumeUserForcast_' + id).val();


        $.ajax({
            url: '@Url.Action(ConsumeForcastWsController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.userTypeId = model.userTypeId;
                rowData.usageLayerTypeId = model.usageLayerId;
                rowData.countUser = model.countUser;
                rowData.unitUser = model.unitUser;
                rowData.consumeUser = model.consumeUser;
                rowData.avgConsumeUser = model.avgConsumeUser;
                rowData.consumeUserForcast = model.consumeUserForcast;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#hidUsageLayerTypeId_' + id).attr('value', model.usageLayerId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanUserType_' + id).text(data.userTypeTitle);
                $('#spanUsageLayerType_' + id).text(data.usageLayerTitle);
                $('#spanCountUser_' + id).text(data.countUser);
                $('#spanUnitUser_' + id).text(data.unitUser);
                $('#spanConsumeUser_' + id).text(data.consumeUser);
                $('#spanAvgConsumeUser_' + id).text(data.avgConsumeUser);
                $('#spanConsumeUserForcast_' + id).text(data.consumeUserForcast);
                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

