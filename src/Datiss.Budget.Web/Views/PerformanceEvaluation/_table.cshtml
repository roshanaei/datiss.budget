@model PerformanceEvaluationIndexViewModel
<div class="table-responsive">
    <table style="width:100%" id="my-table" class="table table-hover table-bordered m-0 my-font">
        <thead class="thead-light">
            <tr>
                <th>سال</th>
                <th>سازمان</th>
                <th>عنوان</th>
                <th>هدف سالیانه</th>
                <th>بودجه</th>
                <th>عملکرد</th>
                <th>درصد تحقق</th>
                <th>مدیریت</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr id="row_@item.Id">
                    <td>
                        <div id="divInput_Year_@item.Id" style="display: none">
                            <input id="hidYearId_@item.Id" type="hidden" value="@item.YearId" />
                            <select class="form-control selectYear" id="inputYear_@item.Id" asp-items="Model.YearSource">
                            </select>
                            <script>
                                $('select#inputYear_' + @item.Id + ' option[value=' + @item.YearId + ']').attr('selected', true);
                                $('#inputYear_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_Year_@item.Id">
                            <span id="spanYear_@item.Id">@item.Year.ToString()</span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_Org_@item.Id" style="display: none">
                            <input id="hidOrgId_@item.Id" type="hidden" value="@item.OrganizationId" />
                            <select class="form-control selectOrganization" id="inputOrg_@item.Id" asp-items="Model.OrganizationSource">
                            </select>
                            <script>
                                $('select#inputOrg_' + @item.Id + ' option[value=' + @item.OrganizationId + ']').attr('selected', true);
                                $('#inputOrg_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_Org_@item.Id">
                            <span id="spanOrg_@item.Id">@item.OrganizationDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_TableField_@item.Id" style="display: none">
                            <input class="form-control" id="inputTableField_@item.Id" value="@item.TableFieldId" type="number" />
                        </div>
                        <div id="divInput_TableFieldDisplay_@item.Id" style="display: none">
                            <input class="form-control" id="inputTableFieldDisplay_@item.Id" value="@item.TableFieldDisplay" />
                            <script>
                                $('#inputTableFieldDisplay_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_TableField_@item.Id">
                            <span id="spanTableField_@item.Id">@item.TableFieldDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_Target_@item.Id" style="display: none">
                            <input class="form-control" id="inputTarget_@item.Id" value="@item.Target" type="number" />
                            <script>
                                $('#inputTarget_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_Target_@item.Id">
                            <span id="spanTarget_@item.Id">@item.TargetDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_Budget_@item.Id" style="display: none">
                            <input class="form-control" id="inputBudget_@item.Id" value="@item.Budget" type="number" />
                            <script>
                                $('#inputBudget_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_Budget_@item.Id">
                            <span id="spanBudget_@item.Id">@item.BudgetDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_Operation_@item.Id" style="display: none">
                            <input class="form-control" id="inputOperation_@item.Id" value="@item.Operation" type="number" />
                        </div>
                        <div id="divOutput_Operation_@item.Id">
                            <span id="spanOperation_@item.Id">@item.OperationDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_PercentRealization_@item.Id" style="display: none">
                            <input class="form-control" id="inputPercentRealization_@item.Id" value="@item.PercentRealization" type="number" />
                            <script>
                                $('#inputPercentRealization_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_PercentRealization_@item.Id">
                            <span id="spanPercentRealization_@item.Id">@item.PercentRealizationDisplay </span>
                        </div>
                    </td>
                    <td>
                        <a id="btnEdit_@item.Id" data-id="@item.Id" class="edit-row btn bg-light-info btn-info mr-1 my-font">
                            <i class="fa ft-edit fa-1x"></i>
                        </a>

                        <a id="btnDelete_@item.Id" data-id="@item.Id" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                            <i class="fa ft-trash-2"></i>
                        </a>

                        <a id="btnSaveEdit_@item.Id" data-id="@item.Id" class="save-edit-row btn btn-success my-font mr-1" style="display: none">
                            <i class="fa ft-check-square"></i>
                        </a>

                        <a id="btnCancelEdit_@item.Id" data-id="@item.Id" class="cancel-edit-row btn btn-secondary my-font" style="display: none">
                            <i class="fa ft-x-square"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="rowACJSB" style="margin-top:20px">
        <!--Tools-->
        <div class="rowACJS">
            <form id="toolForm"
                  enctype="multipart/form-data"
                  method="post"
                  asp-antiforgery="true">
                <input name="filterYearId" type="hidden" value="@Model.Filter.YearId" />
                <input name="filterOrganizationId" type="hidden" value="@Model.Filter.OrganizationId" />

                <span data-toggle="modal" data-target="#backdrop">
                    <button data-toggle="tooltip" data-placement="top" title="ورود اطلاعات از اکسل" type="button" name="btnExcelImport" onclick="openImportExcelForm();" class="btn btn-secondary bg-light-secondary mr-1 my-font">
                        <i _ngcontent-dpj-c129="" class="fa fa-cloud-upload"></i>
                    </button>
                </span>
                <span data-toggle="modal" data-target="#CopyModal">
                    <button data-toggle="tooltip" data-placement="top" title="کپی اطلاعات" type="button" name="btnCopy" class="btn btn-warning bg-light-warning mr-1 my-font openCopy">
                        <i _ngcontent-dpj-c129="" class="fa fa-copy"></i>
                    </button>
                </span>
                <button data-toggle="tooltip" data-placement="top" title="حذف اطلاعات" type="button" onclick="return softDelete(this.click);" name="btnDelete" class="btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                    <i _ngcontent-dpj-c129="" class="fa fa-trash"></i>
                </button>
                <span data-toggle="modal" data-target="#CalculationModal">
                    <button data-toggle="tooltip" data-placement="top" title="اطلاعات محاسبات" type="button" name="btnCalculaton" class="btn btn-info calculation-button bg-light-info mr-1 my-font">
                        <i _ngcontent-dpj-c129="" class="fa fa-calculator"></i>
                    </button>
                </span>
            </form>

        </div>

        <div class="rowAC">
            <div class="my-font">کل رکوردها: <b class="font-medium-2">@Model.TotalCount</b></div>
            <div class="my-font ml-2">
                (صفحه <b class="font-medium-2">@Model.PageNumber</b> از
                <b class="font-medium-2">
                    @if (Model.PagesCount == 0)
                    {<span>1</span>}
                    else
                    {<span>@Model.PagesCount</span>}
                </b>)
            </div>
        </div>
        @if (Model.PagesCount > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @if (Model.PageNumber > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="@PerformanceEvaluationController.Name"
                               asp-action="@PerformanceEvaluationController.ACTION_Index"
                               asp-route-page="@Model.PreviousPage"
                               aria-label="Previous">«</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.PagesCount; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <li class="page-item active"><a class="page-link" href="#">@i.ToString() </a></li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="@PerformanceEvaluationController.Name"
                                   asp-action="@PerformanceEvaluationController.ACTION_Index"
                                   asp-route-page="@i">@i.ToString() </a>
                            </li>
                        }
                    }

                    @if (Model.PageNumber < Model.PagesCount)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="@PerformanceEvaluationController.Name"
                               asp-action="@PerformanceEvaluationController.ACTION_Index"
                               asp-route-page="@Model.NextPage"
                               aria-label="Next">»</a>
                        </li>
                    }

                </ul>
            </nav>
        }
    </div>
</div>