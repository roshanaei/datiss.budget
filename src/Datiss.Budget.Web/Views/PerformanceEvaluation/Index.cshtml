@model PerformanceEvaluationIndexViewModel
@{ ViewData["Title"] = "ارزیابی عملکرد"; }

<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            <span class="my-font-bold">@ViewData["Title"] @ViewData["Month"] ماهه @ViewData["TablesName"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <!--Filters-->
                        <form method="post"
                              id="filterForm"
                              asp-controller="@PerformanceEvaluationController.Name"
                              asp-action="@PerformanceEvaluationController.ACTION_Index"
                              asp-route-tableName="@Model.Filter.TableName"
                              asp-antiforgery="true">
                            <input type="hidden" asp-for="Filter.Columns" id="hidColumns">
                            <div class="rowACJSB">
                                <fieldset class="form-group mt-3">
                                    <label asp-for="Filter.YearId" class="my-font">
                                        سال:
                                        <select asp-for="Filter.YearId"
                                                asp-items="Model.Filter.YearSource"
                                                class="form-control d-inline-block width-100"
                                                id="yearId">
                                        </select>
                                    </label>
                                    @*<label asp-for="Filter.SectionName" class="my-font">
                                        بخش :
                                        <select asp-for="Filter.SectionName"
                                                asp-items="Model.Filter.SectionNameSource"
                                                class="form-control d-inline-block width-150"
                                                id="sectionNameId">
                                        </select>
                                    </label>*@
                                    <label asp-for="Filter.OrganizationId" class="my-font" style="margin-right:20px">
                                        سازمان:
                                        <select asp-for="Filter.OrganizationId"
                                                asp-items="Model.Filter.OrganizationSource"
                                                class="form-control d-inline-block width-300"
                                                id="organizationId">
                                        </select>
                                    </label>
                                    <input asp-for="Filter.OrderBy" type="hidden" />
                                    <input asp-for="Filter.OrderDesc" type="hidden" />
                                    <input asp-for="@Model.Filter.TableName" type="hidden" id="TableName" />

                                </fieldset>
                                <fieldset>
                                    <div class="rowACJE">

                                        <button data-toggle="tooltip" data-placement="top" title="فیلتر" type="submit" name="btnFilter" class="btn btn-info bg-light-info  mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-filter"></i>
                                        </button>
                                        <button id="btnCreate" data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" class="btn btn-success bg-light-success my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
                                        </button>
                                    </div>
                                </fieldset>
                            </div>
                            <hr />
                            <fieldset class="form-group position-relative has-icon-left">
                                <input asp-for="Filter.Search" id="ngx-filter-ref" type="text" placeholder="جستجو..." class="form-control-lg form-control d-inline-block my-custom-input my-font">
                                <div class="form-control-position">
                                    <i class="ft-search font-medium-4"></i>
                                </div>
                            </fieldset>
                            <!--SearchBox-->
                            <div class="rowACJSB">
                                <div class="d-flex flex-row-reverse align-items-center">

                                    <fieldset class="form-group" style="margin-right:20px">
                                        <label class="my-font rowAC">
                                            <span>نمایش</span>

                                            <select asp-for="Filter.PageSize"
                                                    style="margin-right:10px"
                                                    class="form-control"
                                                    onchange="changePageSize();"
                                                    id="ddlPageSize">
                                                <option>25</option>
                                                <option>50</option>
                                            </select>
                                            <span style="margin-right:10px">رکورد</span>

                                        </label>

                                    </fieldset>
                                    @* drop down menu *@

                                    <div class="btn-group dropdown form-group">
                                        <button type="button"
                                                class="btn btn-light my-font dropdown-toggle"
                                                data-toggle="dropdown"
                                                aria-haspopup="true"
                                                aria-expanded="false">
                                            ستون ها
                                        </button>
                                        <div class="dropdown-menu" style="width:150%">
                                            <div id="columnSelector">
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-1"
                                                               id="col-1" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-1"><span>سال</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-2"
                                                               id="col-2" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-2"><span>سازمان</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-3"
                                                               id="col-3" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-3"><span>عنوان</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-4"
                                                               id="col-4" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-4"><span>هدف سالیانه</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-5"
                                                               id="col-5" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-5"><span>بودجه</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-6"
                                                               id="col-6" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-6"><span>عملکرد</span></label>
                                                    </div>
                                                </div>
                                                <div class="dropdown-item">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input"
                                                               checked
                                                               name="col-7"
                                                               id="col-7" />
                                                        <label class="custom-control-label my-font"
                                                               for="col-7"><span>درصد تحقق</span></label>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <fieldset>
                                    <div class="rowACJE">
                                        <button data-toggle="tooltip" data-placement="top" title="به روز رسانی داده ها" type="submit" name="btnRefreshTable" class="btn btn-info bg-light-info  mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-refresh"></i>
                                        </button>
                                        <a data-toggle="tooltip" data-placement="top" title="دانلود اطلاعات جدول" name="btnExportExcel" asp-action="@PerformanceEvaluationController.ACTION_ExportExcel"
                                           asp-route-orgid="@Model.Filter.OrganizationId"
                                           asp-route-yearid="@Model.Filter.YearId"
                                           asp-route-tablesname="@Model.Filter.TableName" class="btn btn-secondary bg-light-secondary mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa ft-database"></i>
                                        </a>
                                        <a data-toggle="tooltip" data-placement="top" title="دانلود فرمت اکسل" class="btn btn-warning bg-light-warning my-font"
                                           asp-asp-controller="@PerformanceEvaluationController.Name"
                                           asp-action="@PerformanceEvaluationController.ACTION_GetExcelTemplate"
                                           asp-route-yearId="@Model.Filter.YearId"
                                           asp-route-orgId="@Model.Filter.OrganizationId"
                                           asp-route-tablesname="@Model.Filter.TableName">
                                            <i _ngcontent-dpj-c129="" class="fa ft-download-cloud"></i>
                                        </a>
                                    </div>
                                </fieldset>
                            </div>

                        </form>
                        <!--DataTable-->
                        <partial name="_table" model="Model" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section headSection {
    <link href="~/assets/vendors/css/select2.min.css" rel="stylesheet" />
    <script type="text/javascript" src="~/assets/vendors/js/select2.full.min.js"></script>
}

@section footSection {

    <div id="divCopy">

    </div>

    <partial name="_excelModal" model="new ImportExcelViewModel()" />


    <div id="divCalc">

    </div>

    <partial name="_tableScript" />

    <script type="text/javascript">
        let allColumns = '1,2,3,4,5,6,7';
        let columnIndices = allColumns.split(',');
        console.log(columnIndices);
        let showingColmuns = "1,2,3,4,5,6,7,";
    </script>

    @if (Model.Filter.Columns.IsNotNullOrEmpty())
    {
        <script type="text/javascript">
            showingColmuns = '@Model.Filter.Columns' ;
        </script>
    }

    <script type="text/javascript">

        $(document).ready(function () {
            console.log('ready');
            document.getElementById("hidColumns").value = showingColmuns;

            setDataColumns();

            $(".dropdown-menu").click(function (e) {
                e.stopPropagation();
            });

            $("#columnSelector input:checkbox:checked").change(function () {
                let index = parseInt($(this)[0].id.split('-')[1]);
                console.log(`showing or hiding col : ${index}`);
                let checked = $(this)[0].checked;
                if (checked) {
                    $(`th:nth-child(${index}), tr td:nth-child(${index})`).show();
                    showingColmuns = showingColmuns + `${index},`
                    document.getElementById("hidColumns").value = showingColmuns ;
                } else {
                    $(`th:nth-child(${index}), tr td:nth-child(${index})`).hide();
                    showingColmuns = showingColmuns.replace(`${index},`, '');
                    document.getElementById("hidColumns").value = showingColmuns;
                }
            });

            $('#organizationId').select2({
                dir: 'rtl'
            });
        });

        function resetDataColumns() {
            $('th,tr td').show();
            let inputs = $("#columnSelector input:checkbox");
            for (let i = 0; i < inputs.length; i++) {
                inputs[i].checked = true
            }
        }

        function setDataColumns() {
            let columnsToShow = document.getElementById("hidColumns").value.split(',');
            console.log('ColumnsToShow ');
            console.log(columnsToShow);
            let checkBoxes = $("#columnSelector input:checkbox");
            for(let i = 0; i < columnIndices.length; i++) {
                let index = parseInt(columnIndices[i]);
                let showColumn = columnsToShow.indexOf(columnIndices[i]) !== -1;
                console.log(`Column : ${index} show = ${showColumn}`);
                checkBoxes[i].checked = showColumn;
                if(showColumn)
                    $(`th:nth-child(${index}), tr td:nth-child(${index})`).show();
                else
                    $(`th:nth-child(${index}), tr td:nth-child(${index})`).hide();
            }

        }

        function softDelete(e) {
            Swal.fire({
                title: '<span class="my-font">برای حذف اطمینان دارید؟</span>',
                html: '<span class="my-font">توجه داشته باشید که این عملیات قابل برگشت نیست!</span>',
                type: 'error',
                showCancelButton: true,
                //confirmButtonColor: '#2F8BE6',
                animation: false,
                customClass: 'animated flipInX',
                //cancelButtonColor: '#F55252',
                cancelButtonText: 'انصراف',
                confirmButtonText: 'حذف اطلاعات!',
                confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                cancelButtonClass:  'btn btn-outline-secondary mr-1 my-font',
                buttonsStyling: false,
            }).then(function (result) {
                if (result.value) {
                    let params = {};
                    params.yearId = $('#yearId option:selected').val();
                    params.orgId = $('#organizationId option:selected').val();
                    params.tablesName = $('#TableName').val();

                    console.log(params);
                    let deleteUrl = '@Url.Action(PerformanceEvaluationController.ACTION_DeleteRecords)';
                    console.log(deleteUrl);

                    $.ajax({
                        url: deleteUrl,
                        type: 'POST',
                        data: params,
                        success: function(data, status, settings) {
                            console.log(status);
                            if(data.hasError) {
                                Swal.fire({
                                    title: '<span class="my-font">خطا</span>',
                                    html: `<span class="my-font">${data.message}</span>`,
                                    type: 'error',
                                    confirmButtonColor: '#2F8BE6',
                                    animation: false,
                                    customClass: 'animated flipInX',
                                    confirmButtonText: 'بستن',
                                    confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                                    buttonsStyling: false,
                                });
                                return;
                            }

                            Swal.fire({
                                title: '<span class="my-font">عملیات موفق</span>',
                                html: `<span class="my-font">${data.message}</span>`,
                                type: 'success',
                                confirmButtonColor: '#2F8BE6',
                                animation: true,
                                customClass: 'animated flipInX',
                                confirmButtonText: 'بستن',
                                confirmButtonClass: 'btn btn-secondary mr-1 my-font',
                                buttonsStyling: false,
                            }).then(function(result) {
                                document.location.href = '@Url.Action(PerformanceEvaluationController.ACTION_Index, new {page = 1 , tableName = Model.Filter.TableName })';
                            });
                        },
                        error: function(request, option, err) {
                            console.log(err);
                        }
                    });

                    return true;
                }
                else {

                    return false;
                }
            });

        }

        function openImportExcelForm() {
            $('#ExcellModal').modal('show');
        }

        $(document).on('click', '.edit-row', function () {
            resetDataColumns()
            let id = $(this).data('id');

            let input = document.getElementById('inputOperation_' + id);

            let btnSaveEdit = document.getElementById('btnSaveEdit_' + id);

            btnSaveEdit.addEventListener('click', function (event) {
                event.preventDefault();
                $(btnSaveEdit).attr('disabled', true);
                $(btnSaveEdit).unbind('keyup');
            });

            input.addEventListener('keyup', function (event) {
                event.preventDefault();
                if (event.keyCode === 13) {
                    btnSaveEdit.click();
                }
            });

            editRow(id);
        });

        $(document).on('click', '.cancel-edit-row', function () {
            let id = $(this).data('id');
            cancelEditRow(id);
        });

        $(document).on('click', '.save-edit-row', function () {
            let id = $(this).data('id');
            $(this).prop('disabled', true);
            saveEditRow(id);
            $(this).prop('disabled', false);
        });


        $(document).ready(function() {
            $('.modal').on('hidden.bs.modal', function() {
                $('.modal-backdrop').remove();
            });
        });

        $(document).on('click', '#btnDoImportExcel', function () {

            var fdata = new FormData();
            var fileInput = $('#ExcelFile')[0];
            var file = fileInput.files[0];
            var yearId = $('#yearId').val();
            var tablesName = $('#TableName').val();

            fdata.append('ExcelFile', file);
            fdata.append('yearId', yearId);
            fdata.append('tablesName', tablesName);

            $.ajax({
                url: '@Url.Action(PerformanceEvaluationController.ACTION_ImportExcel)',
                type: 'POST',
                data: fdata,
                processData: false,
                contentType: false,
                success: function (data, status, settings) {
                    console.log(data);
                    if (data.hasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data.message}</span>`,
                            type: 'error',
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                    }

                    if (data.ask) {
                        Swal.fire({
                            html: `<span class="my-font">سازمان های :<br>${data.message} در فایل اکسل شما اطلاعاتی ندارند. آیا مایل به ادامه هستید؟</span>`,
                            type: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            cancelButtonColor: '#F55252',
                            cancelButtonText: 'خیر',
                            confirmButtonText: 'بله',
                            confirmButtonClass: 'btn btn-warning my-font',
                            cancelButtonClass: 'btn btn-danger  my-font ml-1',
                            buttonsStyling: false,
                        }).then(function (result) {

                            if (result.value) {
                                fdata.append('ContinueIfAnyOrgMissing', true);
                                console.log(fdata);

                                $.ajax({
                                    url: '@Url.Action(PerformanceEvaluationController.ACTION_ImportExcel)',
                                    type: 'POST',
                                    data: fdata,
                                    processData: false,
                                    contentType: false,
                                    success: function (data, status, settings) {
                                        if (data.hasError) {
                                            Swal.fire({
                                                title: '<span class="my-font">خطا</span>',
                                                html: `<span class="my-font">${data.message}</span>`,
                                                type: 'error',
                                                confirmButtonColor: '#2F8BE6',
                                                animation: false,
                                                customClass: 'animated flipInX',
                                                confirmButtonText: 'بستن',
                                                confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                                                buttonsStyling: false,
                                            });
                                            return;
                                        }

                                        if (!data.hasError) {
                                            Swal.fire({
                                                title: '<span class="my-font">عملیات موفق</span>',
                                                html: '<span class="my-font">عملیات ورود اطلاعات با موفقیت انجام شد.</span>',
                                                type: 'success',
                                                confirmButtonColor: '#2F8BE6',
                                                animation: true,
                                                customClass: 'animated flipInX',
                                                confirmButtonText: 'بستن',
                                                confirmButtonClass: 'btn btn-secondary mr-1 my-font',
                                                buttonsStyling: false,
                                            }).then(function (result) {
                                                document.location.href = '@Url.Action(PerformanceEvaluationController.ACTION_Index , new { page = 1, tableName = Model.Filter.TableName })';
                                            });
                                        }

                                        if (data.ask) {
                                            alert('dont ask again');
                                        }
                                    },
                                    error: function (request, options, err) {
                                        console.log(err);
                                    }
                                });

                                return true;
                            }
                            else {
                                return false;
                            }
                        });
                    }

                    if (!data.hasError && !data.ask) {
                        Swal.fire({
                            title: '<span class="my-font">عملیات موفق</span>',
                            html: '<span class="my-font">عملیات ورود اطلاعات با موفقیت انجام شد.</span>',
                            type: 'success',
                            confirmButtonColor: '#2F8BE6',
                            animation: true,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-secondary mr-1 my-font',
                            buttonsStyling: false,
                        }).then(function (result) {
                            document.location.href = '@Url.Action(PerformanceEvaluationController.ACTION_Index , new { page = 1, tableName = Model.Filter.TableName })';
                        });
                    }

                },
                error: function(request, options, err) {
                    console.log(err);
                    alert('مشکلی پیش آمده است ، کمی بعد سعی کنید . با تشکر');
                }
            });

        });

        function changePageSize() {
            let pageSize = $('#ddlPageSize').attr('value');
            console.log(pageSize);
            $('#filterForm').submit();
        };

    </script>

}