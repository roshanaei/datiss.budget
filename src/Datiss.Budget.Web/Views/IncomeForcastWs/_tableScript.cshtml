<script type="text/javascript">

    let isNewRow = false;
    function editRow(id) {

        resetTableBackColor("my-table");

        let row = $('#row_' + id);

        //Hide output elements
        $('#divOutput_Year_' + id).hide();
        $('#divOutput_Org_' + id).hide();
        $('#divOutput_UserType_' + id).hide();
        $('#divOutput_NumberUser_' + id).hide();
        $('#divOutput_UnitUser_' + id).hide();
        $('#divOutput_WasteInstallIncome_' + id).hide();
        $('#divOutput_WasteBranchIncome_' + id).hide();
        $('#divOutput_WasteNote3Income_' + id).hide();
        $('#divOutput_WsNote11Income_' + id).hide();

        //show input elements
        $('#divInput_Year_' + id).show();
        $('#divInput_Org_' + id).show();
        $('#divInput_UserType_' + id).show();
        $('#divInput_NumberUser_' + id).show();
        $('#divInput_UnitUser_' + id).show();
        $('#divInput_WasteInstallIncome_' + id).show();
        $('#divInput_WasteBranchIncome_' + id).show();
        $('#divInput_WasteNote3Income_' + id).show();
        $('#divInput_WsNote11Income_' + id).show();

        $('#btnEdit_' + id).hide();
        $('#btnDelete_' + id).hide();
        $('#btnSaveEdit_' + id).show();
        $('#btnCancelEdit_' + id).show();
    }

    function cancelEditRow(id) {
        let row = $('#row_' + id);
        //row.css('background-color', '');

        //Hide input elements
        $('#divInput_Year_' + id).hide();
        $('#divInput_Org_' + id).hide();
        $('#divInput_UserType_' + id).hide();
        $('#divInput_NumberUser_' + id).hide();
        $('#divInput_UnitUser_' + id).hide();
        $('#divInput_WasteInstallIncome_' + id).hide();
        $('#divInput_WasteBranchIncome_' + id).hide();
        $('#divInput_WasteNote3Income_' + id).hide();
        $('#divInput_WsNote11Income_' + id).hide();

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_Org_' + id).show();
        $('#divOutput_UserType_' + id).show();
        $('#divOutput_NumberUser_' + id).show();
        $('#divOutput_UnitUser_' + id).show();
        $('#divOutput_WasteInstallIncome_' + id).show();
        $('#divOutput_WasteBranchIncome_' + id).show();
        $('#divOutput_WasteNote3Income_' + id).show();
        $('#divOutput_WsNote11Income_' + id).show();

        $('#btnEdit_' + id).show();
        $('#btnDelete_' + id).show();
        $('#btnSaveEdit_' + id).hide();
        $('#btnCancelEdit_' + id).hide();
        $('th,tr td').hide();
        showingColmuns.split(',').forEach((value, index) => {
            if (value !== '') {
                $(`th:nth-child(${value}), tr td:nth-child(${value})`).show();
            }
        })
        $(`th:last-child, tr td:last-child`).show();

    }

    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.userTypeId = $('#inputUserType_' + id).val();
        model.numberUser = $('#inputNumberUser_' + id).val();
        model.unitUser = $('#inputUnitUser_' + id).val();
        model.wasteInstallIncome = $('#inputWasteInstallIncome_' + id).val();
        model.wasteBranchIncome = $('#inputWasteBranchIncome_' + id).val();
        model.wasteNote3Income = $('#inputWasteNote3Income_' + id).val();
        model.wsNote11Income = $('#inputWsNote11Income_' + id).val();

        $.ajax({
            url: '@Url.Action(IncomeForcastController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanUserType_' + id).text(data.userTypeDisplay);
                $('#spanNumberUser_' + id).text(data.numberUser);
                $('#spanUnitUser_' + id).text(data.unitUser);
                $('#spanWasteInstallIncome_' + id).text(data.wasteInstallIncome);
                $('#spanWasteBranchIncome_' + id).text(data.wasteBranchIncome);
                $('#spanWasteNote3Income_' + id).text(data.wasteNote3Income);
                $('#spanWsNote11Income_' + id).text(data.wsNote11Income);
                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                alert('خطا در بروز رسانی اطلاعات. لطفاً دوباره سعی نمایید!');
            }
        });
    }

    function saveNewRow(e) {

        resetTableBackColor("my-table");

        var model = {};
        model.yearId = $(e).find('#inputYear_').val();
        model.organizationId = $(e).find('#inputOrg_').val();
        model.userTypeId = $(e).find('#inputUserType_').val();
        model.numberUser = $(e).find('#inputNumberUser_').val();
        if (model.numberUser == "") {
            model.numberUser = 0;
        }
        model.unitUser = $(e).find('#inputUnitUser_').val();
        if (model.unitUser == "") {
            model.unitUser = 0;
        }
        model.wasteInstallIncome = $(e).find('#inputWasteInstallIncome_').val();
        if (model.wasteInstallIncome == "") {
            model.wasteInstallIncome = 0;
        }
        model.wasteBranchIncome = $(e).find('#inputWasteBranchIncome_').val();
        if (model.wasteBranchIncome == "") {
            model.wasteBranchIncome = 0;
        }
        model.wasteNote3Income = $(e).find('#inputWasteNote3Income_').val();
        if (model.wasteNote3Income == "") {
            model.wasteNote3Income = 0;
        }
        model.wsNote11Income = $(e).find('#inputWsNote11Income_').val();
        if (model.wsNote11Income == "") {
            model.wsNote11Income = 0;
        }

        console.log(model);

        $.ajax({
            url: '@Url.Action(IncomeForcastController.ACTION_Create)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data._ErrorMessage}</span>`,
                        type: 'error',
                        animation: false,
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                //Year
                $(e).find('#divInput_Year_').attr('id', 'divInput_Year_' + data.id);
                $(e).find('#hidYearId_').attr('id', 'hidYearId_' + data.id);
                $(e).find('#inputYear_').attr('id', 'inputYear_' + data.id);
                $(e).find('#divOutput_Year_').attr('id', 'divOutput_Year_' + data.id);
                $(e).find('#spanYear_').attr('id', 'spanYear_' + data.id);

                $('#divInput_Year_' + data.id).hide();
                $('#spanYear_' + data.id).text(data.year);
                $('#divOutput_Year_' + data.id).show();

                //Organization
                $(e).find('#divInput_Org_').attr('id', 'divInput_Org_' + data.id);
                $(e).find('#hidOrgId_').attr('id', 'hidOrgId_' + data.id);
                $(e).find('#inputOrg_').attr('id', 'inputOrg_' + data.id);
                $(e).find('#divOutput_Org_').attr('id', 'divOutput_Org_' + data.id);
                $(e).find('#spanOrg_').attr('id', 'spanOrg_' + data.id);

                $('#divInput_Org_' + data.id).hide();
                $('#spanOrg_' + data.id).text(data.organizationDisplay);
                $('#divOutput_Org_' + data.id).show();

                //UserType
                $(e).find('#divInput_UserType_').attr('id', 'divInput_UserType_' + data.id);
                $(e).find('#hidUserTypeId_').attr('id', 'hidUserTypeId_' + data.id);
                $(e).find('#inputUserType_').attr('id', 'inputUserType_' + data.id);
                $(e).find('#divOutput_UserType_').attr('id', 'divOutput_UserType_' + data.id);
                $(e).find('#spanUserType_').attr('id', 'spanUserType_' + data.id);

                $('#divInput_UserType_' + data.id).hide();
                $('#spanUserType_' + data.id).text(data.userTypeDisplay);
                $('#divOutput_UserType_' + data.id).show();

                //NumberUser
                $(e).find('#divInput_NumberUser_').attr('id', 'divInput_NumberUser_' + data.id);
                $(e).find('#inputNumberUser_').attr('id', 'inputNumberUser_' + data.id);
                $(e).find('#divOutput_NumberUser_').attr('id', 'divOutput_NumberUser_' + data.id);
                $(e).find('#spanNumberUser_').attr('id', 'spanNumberUser_' + data.id);

                $('#divInput_NumberUser_' + data.id).hide();
                $('#spanNumberUser_' + data.id).text(data.numberUser);
                $('#divOutput_NumberUser_' + data.id).show();

                //UnitUser
                $(e).find('#divInput_UnitUser_').attr('id', 'divInput_UnitUser_' + data.id);
                $(e).find('#inputUnitUser_').attr('id', 'inputUnitUser_' + data.id);
                $(e).find('#divOutput_UnitUser_').attr('id', 'divOutput_UnitUser_' + data.id);
                $(e).find('#spanUnitUser_').attr('id', 'spanUnitUser_' + data.id);

                $('#divInput_UnitUser_' + data.id).hide();
                $('#spanUnitUser_' + data.id).text(data.unitUser);
                $('#divOutput_UnitUser_' + data.id).show();

                //WasteInstallIncome
                $(e).find('#divInput_WasteInstallIncome_').attr('id', 'divInput_WasteInstallIncome_' + data.id);
                $(e).find('#inputWasteInstallIncome_').attr('id', 'inputWasteInstallIncome_' + data.id);
                $(e).find('#divOutput_WasteInstallIncome_').attr('id', 'divOutput_WasteInstallIncome_' + data.id);
                $(e).find('#spanWasteInstallIncome_').attr('id', 'spanWasteInstallIncome_' + data.id);

                $('#divInput_WasteInstallIncome_' + data.id).hide();
                $('#spanWasteInstallIncome_' + data.id).text(data.wasteInstallIncome);
                $('#divOutput_WasteInstallIncome_' + data.id).show();

                //WasteBranchIncome
                $(e).find('#divInput_WasteBranchIncome_').attr('id', 'divInput_WasteBranchIncome_' + data.id);
                $(e).find('#inputWasteBranchIncome_').attr('id', 'inputWasteBranchIncome_' + data.id);
                $(e).find('#divOutput_WasteBranchIncome_').attr('id', 'divOutput_WasteBranchIncome_' + data.id);
                $(e).find('#spanWasteBranchIncome_').attr('id', 'spanWasteBranchIncome_' + data.id);

                $('#divInput_WasteBranchIncome_' + data.id).hide();
                $('#spanWasteBranchIncome_' + data.id).text(data.wasteBranchIncome);
                $('#divOutput_WasteBranchIncome_' + data.id).show();

                //WasteNote3Income
                $(e).find('#divInput_WasteNote3Income_').attr('id', 'divInput_WasteNote3Income_' + data.id);
                $(e).find('#inputWasteNote3Income_').attr('id', 'inputWasteNote3Income_' + data.id);
                $(e).find('#divOutput_WasteNote3Income_').attr('id', 'divOutput_WasteNote3Income_' + data.id);
                $(e).find('#spanWasteNote3Income_').attr('id', 'spanWasteNote3Income_' + data.id);

                $('#divInput_WasteNote3Income_' + data.id).hide();
                $('#spanWasteNote3Income_' + data.id).text(data.wasteNote3Income);
                $('#divOutput_WasteNote3Income_' + data.id).show();

                //WsNote11Income
                $(e).find('#divInput_WsNote11Income_').attr('id', 'divInput_WsNote11Income_' + data.id);
                $(e).find('#inputWsNote11Income_').attr('id', 'inputWsNote11Income_' + data.id);
                $(e).find('#divOutput_WsNote11Income_').attr('id', 'divOutput_WsNote11Income_' + data.id);
                $(e).find('#spanWsNote11Income_').attr('id', 'spanWsNote11Income_' + data.id);

                $('#divInput_WsNote11Income_' + data.id).hide();
                $('#spanWsNote11Income_' + data.id).text(data.wsNote11Income);
                $('#divOutput_WsNote11Income_' + data.id).show();



                //Buttons
                $(e).find('#btnEdit_').data('id', data.id);
                $(e).find('#btnDelete_').data('id', data.id);
                $(e).find('#btnSaveEdit_').data('id', data.id);
                $(e).find('#btnCancelEdit_').data('id', data.id);
                $(e).find('#btnSaveCreate_').data('id', data.id);
                $(e).find('#btnCancelCreate_').data('id', data.id);

                $(e).find('#btnEdit_').attr('id', 'btnEdit_' + data.id);
                $(e).find('#btnDelete_').attr('id', 'btnDelete_' + data.id);
                $(e).find('#btnSaveEdit_').attr('id', 'btnSaveEdit_' + data.id);
                $(e).find('#btnCancelEdit_').attr('id', 'btnCancelEdit_' + data.id);
                $(e).find('#btnSaveCreate_').attr('id', 'btnSaveCreate_' + data.id);
                $(e).find('#btnCancelCreate_').attr('id', 'btnCancelCreate_' + data.id);

                $('#btnSaveCreate_' + data.id).hide();
                $('#btnCancelCreate_' + data.id).hide();
                $('#btnEdit_' + data.id).show();
                $('#btnDelete_' + data.id).show();

                $('#inputOrg_' + data.id).select2();
                $(e).css('background-color', 'rgb(245 245 246)');
                isNewRow = false;
            },
            error: function (request, options, err) {
                alert('خطا در بروز رسانی اطلاعات. لطفاً دوباره سعی نمایید!');
            }
        });
    }

    function addNewRow() {
        if (isNewRow) return;

        resetTableBackColor("my-table");


        var template = $('#rowTemplate').clone()
            .appendTo($('#my-table tbody'))
            .attr('id', 'newRow')
            .css('background-color', 'rgb(230 247 228)')
            .show();

        $('.selectOrganization:last').select2({
            dir: 'rtl'
        });


        $('.input-keyup').keyup(function (event) {
            event.preventDefault();
            if (event.keyCode === 13) {
                let row = $(this).closest('tr');
                saveNewRow(row);
            }
        });

        let newRowElement = document.getElementById('newRow');
        newRowElement.scrollIntoView();
        $('.default-input').focus();

        isNewRow = true;
    }

    function cancelNewRow(e) {
        $(e).closest('tr').remove();
        isNewRow = false;
    }

    function deleteRow(e, id) {
        console.log(e);

        $.ajax({
            url: '@Url.Action(IncomeForcastController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
                if (data.hasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data.message}</span>`,
                        type: 'error',
                        confirmButtonColor: '#2F8BE6',
                        animation: false,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                $(e).closest('tr').remove();
            },
            error: function (request, options, err) {
                console.log(err);
                alert('خطا در بروز رسانی اطلاعات. لطفاً دوباره سعی نمایید!');
            }
        });
    }

    function resetTableBackColor(id) {
        var table = document.getElementById(id);
        var rows = table.getElementsByTagName("tr");
        for (i = 2; i < rows.length - 1; i++) {
            rows[i].style = "";
        }
    }

</script>