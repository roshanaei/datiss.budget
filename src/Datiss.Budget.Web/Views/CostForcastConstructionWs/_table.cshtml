@model CostForcastConstructionWsIndexViewModel
<div class="table-responsive">
    <table style="width:100%" id="my-table" class="table table-hover table-bordered m-0 my-font table-overflow">
        <thead class="thead-light">
            <tr>

                <th style="min-width:180px ; font-size:smaller">سازمان</th>
                <th style="min-width:210px; font-size:smaller">شرح پروژه های عمرانی</th>
                <th style="min-width:150px; font-size:smaller">عنوان هزینه سرمایه ای</th>
                <th style="min-width:150px; font-size:smaller">مرکز هزینه</th>
                <th style="min-width:150px; font-size:smaller">حوزه بهره بردار در ستاد</th>
                <th style="min-width:150px; font-size:smaller">درصد پیشرفت فیزیکی</th>
                <th style="min-width:150px; font-size:smaller">هزینه انجام شده (هزار ریال)</th>
                <th style="min-width:150px; font-size:smaller">واحد</th>
                <th style="min-width:150px; font-size:smaller">قیمت واحد(هزار ریال)</th>
                <th style="min-width:150px; font-size:smaller">مقدار</th>
                <th style="min-width:150px; font-size:smaller">(هزار ریال)کل هزینه اجرایی پروژه</th>
                <th style="min-width:150px; font-size:smaller">محل تامین اعتبار</th>
                <th style="min-width:150px; font-size:smaller">این پروژه در سال بودجه به بهره برداری رسیده؟</th>
                <th style="min-width:150px; font-size:smaller">سرفصل کلی در بودجه پیشنهادی</th>
                <th width="10%">مدیریت</th>

            </tr>
        </thead>
        <tbody>
            <tr id="rowTemplate" style="display: none">
                <td>
                    <div id="divInput_Org_">
                        <input id="hidOrgId_" type="hidden" />
                        <select class="form-control selectOrganization" id="inputOrg_" asp-items="Model.InputOrganizationSource">
                        </select>
                        <script>
                            $('select#inputOrg_ option[value=' + $('#organizationId').val() + ']').attr('selected', true);
                        </script>
                    </div>
                    <div id="divOutput_Org_">
                        <span id="spanOrg_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_ProjectDescription_">
                        <input class="form-control input-keyup default-input" id="inputProjectDescription_" type="text" />
                    </div>
                    <div id="divOutput_ProjectDescription_" style="display: none">
                        <span id="spanProjectDescription_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_WasteInvestorsType_">
                        <input id="hidWasteInvestorsTypeId_" type="hidden" />
                        <select class="form-control" id="inputWasteInvestorsType_" asp-items="Model.WasteInvestorsTypeSource">
                        </select>
                    </div>
                    <div id="divOutput_WasteInvestorsType_" style="display: none">
                        <span id="spanWasteInvestorsType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_CostCenterType_">
                        <input id="hidCostCenterTypeId_" type="hidden" />
                        <select class="form-control" id="inputCostCenterType_" asp-items="Model.CostCenterTypeSource">
                        </select>
                    </div>
                    <div id="divOutput_CostCenterType_" style="display: none">
                        <span id="spanCostCenterType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_ExploitationAreaType_">
                        <input id="hidExploitationAreaTypeId_" type="hidden" />
                        <select class="form-control" id="inputExploitationAreaType_" asp-items="Model.ExploitationAreaTypeSource">
                        </select>
                    </div>
                    <div id="divOutput_ExploitationAreaType_" style="display: none">
                        <span id="spanExploitationAreaType_"> </span>
                    </div>
                </td>

                <td>
                    <div id="divInput_ProgressPercent_">
                        <input class="form-control input-keyup" id="inputProgressPercent_" type="number" />
                    </div>
                    <div id="divOutput_ProgressPercent_" style="display: none">
                        <span id="spanProgressPercent_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_CostDone_">
                        <input class="form-control input-keyup" id="inputCostDone_" type="number" />
                    </div>
                    <div id="divOutput_CostDone_" style="display: none">
                        <span id="spanCostDone_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_MeasurementType_">
                        <input id="hidMeasurementTypeId_" type="hidden" />
                        <select class="form-control" id="inputMeasurementType_" asp-items="Model.MeasurementTypeSource">
                        </select>
                    </div>
                    <div id="divOutput_MeasurementType_" style="display: none">
                        <span id="spanMeasurementType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_UnitPrice_">
                        <input class="form-control input-keyup" id="inputUnitPrice_" type="number" />
                    </div>
                    <div id="divOutput_UnitPrice_" style="display: none">
                        <span id="spanUnitPrice_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_Amount_">
                        <input class="form-control input-keyup" id="inputAmount_" type="number" />
                    </div>
                    <div id="divOutput_Amount_" style="display: none">
                        <span id="spanAmount_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_TotalCost_">
                        <input class="form-control input-keyup" id="inputTotalCost_" type="number" />
                    </div>
                    <div id="divOutput_TotalCost_" style="display: none">
                        <span id="spanTotalCost_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_CreditType_">
                        <input id="hidCreditTypeId_" type="hidden" />
                        <select class="form-control" id="inputCreditType_" asp-items="Model.CreditTypeSource">
                        </select>
                    </div>
                    <div id="divOutput_CreditType_" style="display: none">
                        <span id="spanCreditType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_ExtensionType_">
                        <input id="hidExtensionTypeId_" type="hidden" />
                        <select class="form-control selectExtensionType" id="inputExtensionType_" asp-items="Model.ExtensionTypeSource" onchange="RelatedDropDown(this,event)">
                        </select>
                    </div>
                    <div id="divOutput_ExtensionType_" style="display: none">
                        <span id="spanExtensionType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_SuggestedBudgetTopicType_">
                        <input id="hidSuggestedBudgetTopicTypeId_" type="hidden" />
                        <select class="form-control selectSuggestedBudgetTopicType" id="inputSuggestedBudgetTopicType_">
                        </select>
                    </div>
                    <div id="divOutput_SuggestedBudgetTopicType_" style="display: none">
                        <span id="spanSuggestedBudgetTopicType_"> </span>
                    </div>
                </td>
                <td>
                    <a id="btnEdit_" class="edit-row btn bg-light-info btn-info mr-1 my-font" style="display: none">
                        <i class="fa ft-edit fa-1x"></i>
                    </a>

                    <a id="btnDelete_" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font" style="display: none">
                        <i class="fa ft-trash-2"></i>
                    </a>

                    <a id="btnSaveEdit_" class="save-edit-row btn btn-success my-font mr-1" style="display: none">
                        <i class="fa ft-check-square"></i>
                    </a>
                    <a id="btnCancelEdit_" class="cancel-edit-row btn btn-secondary my-font" style="display: none">
                        <i class="fa ft-x-square"></i>
                    </a>

                    <a id="btnSaveCreate_" class="save-new-row btn btn-success my-font mr-1">
                        <i class="fa ft-check-square"></i>
                    </a>

                    <a id="btnCancelCreate_" class="cancel-new-row btn btn-danger my-font">
                        <i class="fa ft-x-square"></i>
                    </a>

                </td>
            </tr>
            @foreach (var item in Model.Items)
            {
                <tr id="row_@item.Id">
                    <td>
                        <div id="divInput_Org_@item.Id" style="display: none">
                            <input id="hidOrgId_@item.Id" type="hidden" value="@item.OrganizationId" />
                            <select class="form-control selectOrganization" id="inputOrg_@item.Id" asp-items="Model.InputOrganizationSource">
                            </select>
                            <script>
                                $('select#inputOrg_' + @item.Id + ' option[value=' + @item.OrganizationId + ']').attr('selected', true);
                                $('#inputOrg_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_Org_@item.Id">
                            <span id="spanOrg_@item.Id">@item.OrganizationDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_ProjectDescription_@item.Id" style="display: none">
                            <input class="form-control" id="inputProjectDescription_@item.Id" value="@item.ProjectDescription" type="text" />
                        </div>
                        <div id="divOutput_ProjectDescription_@item.Id">
                            <span id="spanProjectDescription_@item.Id">@item.ProjectDescription </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_WasteInvestorsType_@item.Id" style="display: none">
                            <input id="hidWasteInvestorsTypeId_@item.Id" type="hidden" value="@item.WasteInvestorsTypeId" />
                            <select class="form-control selectWasteInvestorsType" id="inputWasteInvestorsType_@item.Id" asp-items="Model.WasteInvestorsTypeSource">
                            </select>
                            <script>
                                $('select#inputWasteInvestorsType_' + @item.Id + ' option[value=' + @item.WasteInvestorsTypeId + ']').attr('selected', true);
                                $('#inputWasteInvestorsType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_WasteInvestorsType_@item.Id">
                            <span id="spanWasteInvestorsType_@item.Id">@item.WasteInvestorsDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_CostCenterType_@item.Id" style="display: none">
                            <input id="hidCostCenterTypeId_@item.Id" type="hidden" value="@item.CostCenterTypeId" />
                            <select class="form-control selectCostCenterType" id="inputCostCenterType_@item.Id" asp-items="Model.CostCenterTypeSource">
                            </select>
                            <script>
                                $('select#inputCostCenterType_' + @item.Id + ' option[value=' + @item.CostCenterTypeId + ']').attr('selected', true);
                                $('#inputCostCenterType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_CostCenterType_@item.Id">
                            <span id="spanCostCenterType_@item.Id">@item.CostCenterDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_ExploitationAreaType_@item.Id" style="display: none">
                            <input id="hidExploitationAreaTypeId_@item.Id" type="hidden" value="@item.ExploitationAreaTypeId" />
                            <select class="form-control selectExploitationAreaType" id="inputExploitationAreaType_@item.Id" asp-items="Model.ExploitationAreaTypeSource">
                            </select>
                            <script>
                                $('select#inputExploitationAreaType_' + @item.Id + ' option[value=' + @item.ExploitationAreaTypeId + ']').attr('selected', true);
                                $('#inputExploitationAreaType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_ExploitationAreaType_@item.Id">
                            <span id="spanExploitationAreaType_@item.Id">@item.ExploitationAreaDisplay </span>
                        </div>
                    </td>

                    <td>
                        <div id="divInput_ProgressPercent_@item.Id" style="display: none">
                            <input class="form-control" id="inputProgressPercent_@item.Id" value="@item.ProgressPercent" type="number" />
                        </div>
                        <div id="divOutput_ProgressPercent_@item.Id">
                            <span id="spanProgressPercent_@item.Id">@item.ProgressPercentDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_CostDone_@item.Id" style="display: none">
                            <input class="form-control" id="inputCostDone_@item.Id" value="@item.CostDone" type="number" />
                        </div>
                        <div id="divOutput_CostDone_@item.Id">
                            <span id="spanCostDone_@item.Id">@item.CostDoneDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_MeasurementType_@item.Id" style="display: none">
                            <input id="hidMeasurementTypeId_@item.Id" type="hidden" value="@item.MeasurementTypeId" />
                            <select class="form-control selectMeasurementType" id="inputMeasurementType_@item.Id" asp-items="Model.MeasurementTypeSource">
                            </select>
                            <script>
                                $('select#inputMeasurementType_' + @item.Id + ' option[value=' + @item.MeasurementTypeId + ']').attr('selected', true);
                                $('#inputMeasurementType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_MeasurementType_@item.Id">
                            <span id="spanMeasurementType_@item.Id">@item.MeasurementDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_UnitPrice_@item.Id" style="display: none">
                            <input class="form-control" id="inputUnitPrice_@item.Id" value="@item.UnitPrice" type="number" />
                        </div>
                        <div id="divOutput_UnitPrice_@item.Id">
                            <span id="spanUnitPrice_@item.Id">@item.UnitPriceDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_Amount_@item.Id" style="display: none">
                            <input class="form-control" id="inputAmount_@item.Id" value="@item.Amount" type="number" />
                        </div>
                        <div id="divOutput_Amount_@item.Id">
                            <span id="spanAmount_@item.Id">@item.AmountDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_TotalCost_@item.Id" style="display: none">
                            <input class="form-control" id="inputTotalCost_@item.Id" value="@item.TotalCost" type="number" />
                        </div>
                        <div id="divOutput_TotalCost_@item.Id">
                            <span id="spanTotalCost_@item.Id">@item.TotalCostDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_CreditType_@item.Id" style="display: none">
                            <input id="hidCreditTypeId_@item.Id" type="hidden" value="@item.CreditTypeId" />
                            <select class="form-control selectCreditType" id="inputCreditType_@item.Id" asp-items="Model.CreditTypeSource">
                            </select>
                            <script>
                                $('select#inputCreditType_' + @item.Id + ' option[value=' + @item.CreditTypeId + ']').attr('selected', true);
                                $('#inputCreditType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_CreditType_@item.Id">
                            <span id="spanCreditType_@item.Id">@item.CreditDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_ExtensionType_@item.Id" style="display: none">
                            <input id="hidExtensionTypeId_@item.Id" type="hidden" value="@item.ExtensionTypeId" />
                            <select class="form-control selectExtensionType" id="inputExtensionType_@item.Id" asp-items="Model.ExtensionTypeSource" onchange="RelatedDropDown(this, event)">
                            </select>
                            <script>
                                $('select#inputExtensionType_' + @item.Id + ' option[value=' + @item.ExtensionTypeId + ']').attr('selected', true);
                                $('#inputExtensionType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_ExtensionType_@item.Id">
                            <span id="spanExtensionType_@item.Id">@item.ExtensionDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_SuggestedBudgetTopicType_@item.Id" style="display: none">
                            <input id="hidSuggestedBudgetTopicTypeId_@item.Id" type="hidden" value="@item.SuggestedBudgetTopicTypeId" />
                            <select class="form-control selectSuggestedBudgetTopicType" id="inputSuggestedBudgetTopicType">
                            </select>
                            <script>
                                $('#inputSuggestedBudgetTopicType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_SuggestedBudgetTopicType_@item.Id">
                            <span id="spanSuggestedBudgetTopicType_@item.Id">@item.SuggestedBudgetTopicDisplay </span>
                        </div>
                    </td>
                    <td>
                        <a id="btnEdit_@item.Id" data-id="@item.Id" class="edit-row btn bg-light-info btn-info mr-1 my-font">
                            <i class="fa ft-edit fa-1x"></i>
                        </a>

                        <a id="btnDelete_@item.Id" data-id="@item.Id" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                            <i class="fa ft-trash-2"></i>
                        </a>

                        <a id="btnSaveEdit_@item.Id" data-id="@item.Id" class="save-edit-row btn btn-success my-font mr-1" style="display: none">
                            <i class="fa ft-check-square"></i>
                        </a>

                        <a id="btnCancelEdit_@item.Id" data-id="@item.Id" class="cancel-edit-row btn btn-secondary my-font" style="display: none">
                            <i class="fa ft-x-square"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="rowACJSB" style="margin-top:20px">
    <!--Tools-->
    <div class="rowACJS">
        <form id="toolForm"
              enctype="multipart/form-data"
              method="post"
              asp-antiforgery="true">
            <input name="filterYearId" type="hidden" value="@Model.Filter.YearId" />
            <input name="filterOrganizationId" type="hidden" value="@Model.Filter.OrganizationId" />

            <span data-toggle="modal" data-target="#backdrop">
                <button data-toggle="tooltip" data-placement="top" title="ورود اطلاعات از اکسل" type="button" name="btnExcelImport" onclick="openImportExcelForm();" class="btn btn-secondary bg-light-secondary mr-1 my-font">
                    <i _ngcontent-dpj-c129="" class="fa fa-cloud-upload"></i>
                </button>
            </span>
            <span data-toggle="modal" data-target="#CopyModal">
                <button data-toggle="tooltip" data-placement="top" title="کپی اطلاعات" type="button" name="btnCopy" class="btn btn-warning bg-light-warning mr-1 my-font openCopy">
                    <i _ngcontent-dpj-c129="" class="fa fa-copy"></i>
                </button>
            </span>
            <button data-toggle="tooltip" data-placement="top" title="حذف اطلاعات" type="button" onclick="return hardDelete(this.click);" name="btnDelete" class="btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                <i _ngcontent-dpj-c129="" class="fa fa-trash"></i>
            </button>
            <button id="btnCreate" data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" class="btn btn-success bg-light-success my-font">
                <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
            </button>
            <span data-toggle="modal" data-target="#CalculationModal">
                <button data-toggle="tooltip" data-placement="top" title="اطلاعات محاسبات" type="button" name="btnCalculaton" class="btn btn-info calculation-button bg-light-info mr-1 my-font">
                    <i _ngcontent-dpj-c129="" class="fa fa-calculator"></i>
                </button>
            </span>
        </form>

    </div>
    <div class="rowAC">
        <div class="my-font">کل رکوردها: <b class="font-medium-2">@Model.TotalCount</b></div>
        <div class="my-font ml-2">(صفحه <b class="font-medium-2">@Model.PageNumber</b> از <b class="font-medium-2">@Model.PagesCount</b>)</div>
    </div>
    <!--Pagination-->
    <vc:pager model="Model.ToPager()" controller-name="@CostForcastConstructionWsController.Name" action-name="@CostForcastConstructionWsController.ACTION_Index"></vc:pager>
</div>