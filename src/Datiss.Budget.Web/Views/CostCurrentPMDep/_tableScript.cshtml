<script type="text/javascript">

    let isNewRow = false;
    let rowData = {};

    function editRow(id) {


        resetTableBackColor("my-table");

        let row = $('#row_' + id);

        //Hide output elements
        $('#divOutput_Year_' + id).hide();
        $('#divOutput_Org_' + id).hide();
        $('#divOutput_CCPMDepType_' + id).hide();
        $('#divOutput_ActivityType_' + id).hide();
        $('#divOutput_RecordType_' + id).hide();
        $('#divOutput_CostCenter_' + id).hide();
        $('#divOutput_FinancePMCost_' + id).hide();
        $('#divOutput_RFinancePMCost_D_' + id).hide();
        $('#divOutput_FinanceDepCost_' + id).hide();
        $('#divOutput_RFinanceDepCost_D_' + id).hide();

        //show input elements
        $('#divInput_Year_' + id).show();
        $('#divInput_Org_' + id).show();
        $('#divInput_CCPMDepType_' + id).show();
        $('#divInput_ActivityType_' + id).show();
        $('#divInput_RecordType_' + id).show();
        $('#divInput_CostCenter_' + id).show();
        $('#divInput_FinancePMCost_' + id).show();
        $('#divInput_RFinancePMCost_D_' + id).show();
        $('#divInput_FinanceDepCost_' + id).show();
        $('#divInput_RFinanceDepCost_D_' + id).show();

        $('#btnEdit_' + id).hide();
        $('#btnDelete_' + id).hide();
        $('#btnSaveEdit_' + id).show();
        $('#btnCancelEdit_' + id).show();

        rowData = {};
        rowData.yearId = $('#inputYear_' + id).val();
        rowData.organizationId = $('#inputOrg_' + id).val();
        rowData.cCPMDepTypeId = $('#inputCCPMDepType_' + id).val();
        rowData.activityType = $('#inputActivityType_' + id).val();
        rowData.recordType = $('#inputRecordType_' + id).val();
        rowData.costCenter = $('#inputCostCenter_' + id).val();
        rowData.financePMCost = $('#inputFinancePMCost_' + id).val();
        rowData.rFinancePMCost_D = $('#inputRFinancePMCost_D_' + id).val();
        rowData.financeDepCost = $('#inputFinanceDepCost_' + id).val();
        rowData.rFinanceDepCost_D = $('#inputRFinanceDepCost_D_' + id).val();
    }

    function cancelEditRow(id) {
        let row = $('#row_' + id);
        //row.css('background-color', '');

        //Hide input elements
        $('#divInput_Year_' + id).hide();
        $('#divInput_Org_' + id).hide();
        $('#divInput_CCPMDepType_' + id).hide();
        $('#divInput_ActivityType_' + id).hide();
        $('#divInput_RecordType_' + id).hide();
        $('#divInput_CostCenter_' + id).hide();
        $('#divInput_FinancePMCost_' + id).hide();
        $('#divInput_RFinancePMCost_D_' + id).hide();
        $('#divInput_FinanceDepCost_' + id).hide();
        $('#divInput_RFinanceDepCost_D_' + id).hide();

        //Reverting to OriginalData
        if(rowData != null) {
            console.log('reverting to original data.');
            console.log(rowData);
            $('#inputYear_' + id).val(rowData.yearId);
            $('#inputOrg_' + id).val(rowData.organizationId);
            $('#inputCCPMDepType_' + id).val(rowData.cCPMDepTypeId);
            $('#inputActivityType_' + id).val(rowData.activityType);
            $('#inputRecordType_' + id).val(rowData.recordType);
            $('#inputCostCenter_' + id).val(rowData.costCenter);
            $('#inputFinancePMCost_' + id).val(rowData.financePMCost);
            $('#inputRFinancePMCost_D_' + id).val(rowData.rFinancePMCost_D);
            $('#inputFinanceDepCost_' + id).val(rowData.financeDepCost);
            $('#inputRFinanceDepCost_D_' + id).val(rowData.rFinanceDepCost_D);
        }

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_Org_' + id).show();
        $('#divOutput_CCPMDepType_' + id).show();
        $('#divOutput_ActivityType_' + id).show();
        $('#divOutput_RecordType_' + id).show();
        $('#divOutput_CostCenter_' + id).show();
        $('#divOutput_FinancePMCost_' + id).show();
        $('#divOutput_RFinancePMCost_D_' + id).show();
        $('#divOutput_FinanceDepCost_' + id).show();
        $('#divOutput_RFinanceDepCost_D_' + id).show();

        $('#btnEdit_' + id).show();
        $('#btnDelete_' + id).show();
        $('#btnSaveEdit_' + id).hide();
        $('#btnCancelEdit_' + id).hide();
        $('th,tr td').hide();
        showingColmuns.split(',').forEach((value, index) => {
            if (value !== '') {
                $(`th:nth-child(${value}), tr td:nth-child(${value})`).show();
            }
        })
        $(`th:last-child, tr td:last-child`).show();

    }

    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.cCPMDepTypeId = $('#inputCCPMDepType_' + id).val();
        model.activityType = $('#inputActivityType_' + id).val();
        model.recordType = $('#inputRecordType_' + id).val();
        model.costCenter = $('#inputCostCenter_' + id).val();
        model.financePMCost = $('#inputFinancePMCost_' + id).val();
        model.rFinancePMCost_D = $('#inputRFinancePMCost_D_' + id).val();
        model.financeDepCost = $('#inputFinanceDepCost_' + id).val();
        model.rFinanceDepCost_D = $('#inputRFinanceDepCost_D_' + id).val();

        console.log(model);

        $.ajax({
            url: '@Url.Action(CostCurrentPMDepController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }
                console.log(data);

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanCCPMDepType_' + id).text(data.cCPMDepTypeDisplay);
                $('#spanActivityType_' + id).text(data.activityType);
                $('#spanRecordType_' + id).text(data.recordType);
                $('#spanCostCenter_' + id).text(data.costCenter);
                $('#spanFinancePMCost_' + id).text(data.financePMCost);
                $('#spanRFinancePMCost_D_' + id).text(data.rFinancePMCost_D);
                $('#spanFinanceDepCost_' + id).text(data.financeDepCost);
                $('#spanRFinanceDepCost_D_' + id).text(data.rFinanceDepCost_D);
                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function resetTableBackColor(id) {
        var table = document.getElementById(id);
        var rows = table.getElementsByTagName("tr");
        for (i = 2; i < rows.length - 1; i++) {
            rows[i].style = "";
        }
    }

</script>