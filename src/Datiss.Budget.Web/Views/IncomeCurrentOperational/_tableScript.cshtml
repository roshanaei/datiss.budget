            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }
                console.log(data);


                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.userTypeId = model.userTypeId;
                rowData.usageLayerTypeId = model.usageLayerId;
                rowData.countH = model.countH;
                rowData.priceH = model.priceH;
                rowData.costH = model.costH;
                rowData.countNH = model.countNH;
                rowData.priceNH = model.priceNH;
                rowData.costNH = model.costNH;
                rowData.totalCount = model.totalCount;
                rowData.totalCost = model.totalCost;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanActivityType_' + id).text(data.activityTypeDisplay);
                $('#spanICOType_' + id).text(data.icoTypeTitle);
                $('#spanCountH_' + id).text(data.countH);
                $('#spanPriceH_' + id).text(data.priceH);
                $('#spanCostH_' + id).text(data.costH);
                $('#spanCountNH_' + id).text(data.countNH);
                $('#spanPriceNH_' + id).text(data.priceNH);
                $('#spanCostNH_' + id).text(data.costNH);
