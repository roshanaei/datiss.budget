    function addNewRow() {
        if (isNewRow) return;

        resetTableBackColor("my-table");

        let activitytype = $('#inputActivityType_').val();
        FillDropDown(activitytype);
        

        var template = $('#rowTemplate').clone()
            .appendTo($('#my-table tbody'))
            .attr('id', 'newRow')
            .css('background-color', 'rgb(230 247 228)')
            .show();

        $('.selectOrganization:last').select2({
            dir: 'rtl'
        });

        $('.input-keyup').keyup(function (event) {
            event.preventDefault();
            if (event.keyCode === 13) {
                let row = $(this).closest('tr');
                saveNewRow(row);
            }
        });

        let newRowElement = document.getElementById('newRow');
        newRowElement.scrollIntoView();
        $('.default-input:last').focus();

        isNewRow = true;
    }

    function cancelNewRow(e) {
        $(e).closest('tr').remove();
        isNewRow = false;
    }

    function deleteRow(e, id) {
        console.log(e);

        $.ajax({
            url: '@Url.Action(IncomeCurrentOperationalController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
                if (data.hasError) {
                    alert(data.message);
                    return;
                }

                $(e).closest('tr').remove();
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function resetTableBackColor(id) {
        var table = document.getElementById(id);
        var rows = table.getElementsByTagName("tr");
        for (i = 2; i < rows.length - 1; i++) {
            rows[i].style = "";
        }
    }

    function RelatedDropDown(e, event) {
        let activityType = event.target.value;
        FillDropDown(activityType);
    }

    function FillDropDown(at, selectval = null) {
        
        let key;
        if (at == 0) {
            key = 0;
        }
        else {
            key = 1
        }

        $.ajax({
            url: '@Url.Action("GetICOTypeAsync")',
            type: 'POST',
            dataType: 'json',
            data: {
                'key': key
                }
        }).done(function (data) {
            var options = $('.selectICOType');
            options.empty();
            $.each(data,
                function (i, item) {
                    options.append($('<option />')
                        .val(item.id)
                        .text(item.title));
                });
            if (selectval != null) {
                options.val(selectval);
            }
        }).fail(function (error) {
            alert(error);
        });
    }


