                    </td>
                    <td>
                        <div id="divInput_PriceNH_@item.Id" style="display: none">
                            <input class="form-control" id="inputPriceNH_@item.Id" value="@item.PriceNH" type="number" />
                        </div>
                        <div id="divOutput_PriceNH_@item.Id">
