<script type="text/javascript">

    let isNewRow = false;
    let rowData = {};

    function editRow(id) {


        resetTableBackColor("my-table");

        let row = $('#row_' + id);

        //Hide output elements
        $('#divOutput_Year_' + id).hide();
        $('#divOutput_Org_' + id).hide();
        $('#divOutput_UserType_' + id).hide();
        $('#divOutput_WNumber_' + id).hide();
        $('#divOutput_WUnit_' + id).hide();
        $('#divOutput_WsNumber_' + id).hide();
        $('#divOutput_WsUnit_' + id).hide();
        $('#divOutput_WNumber_2_' + id).hide();
        $('#divOutput_WUnit_2_' + id).hide();
        $('#divOutput_WsNumber_2_' + id).hide();
        $('#divOutput_WsUnit_2_' + id).hide();

        //show input elements
        $('#divInput_Year_' + id).show();
        $('#divInput_Org_' + id).show();
        $('#divInput_UserType_' + id).show();
        $('#divInput_WNumber_' + id).show();
        $('#divInput_WUnit_' + id).show();
        $('#divInput_WsNumber_' + id).show();
        $('#divInput_WsUnit_' + id).show();
        $('#divInput_WNumber_2_' + id).show();
        $('#divInput_WUnit_2_' + id).show();
        $('#divInput_WsNumber_2_' + id).show();
        $('#divInput_WsUnit_2_' + id).show();

        $('#btnEdit_' + id).hide();
        $('#btnDelete_' + id).hide();
        $('#btnSaveEdit_' + id).show();
        $('#btnCancelEdit_' + id).show();

        rowData = {};
        rowData.yearId = $('#inputYear_' + id).val();
        rowData.organizationId = $('#inputOrg_' + id).val();
        rowData.userTypeId = $('#inputUserType_' + id).val();
        rowData.wNumber = $('#inputWNumber_' + id).val();
        rowData.wUnit = $('#inputWUnit_' + id).val();
        rowData.wsNumber = $('#inputWsNumber_' + id).val();
        rowData.wsUnit = $('#inputWsUnit_' + id).val();
        rowData.wNumber_2 = $('#inputWNumber_2_' + id).val();
        rowData.wUnit_2 = $('#inputWUnit_2_' + id).val();
        rowData.wsNumber_2 = $('#inputWsNumber_2_' + id).val();
        rowData.wsUnit_2 = $('#inputWsUnit_2_' + id).val();
    }

    function cancelEditRow(id) {
        let row = $('#row_' + id);

        //Hide input elements
        $('#divInput_Year_' + id).hide();
        $('#divInput_Org_' + id).hide();
        $('#divInput_UserType_' + id).hide();
        $('#divInput_WNumber_' + id).hide();
        $('#divInput_WUnit_' + id).hide();
        $('#divInput_WsNumber_' + id).hide();
        $('#divInput_WsUnit_' + id).hide();
        $('#divInput_WNumber_2_' + id).hide();
        $('#divInput_WUnit_2_' + id).hide();
        $('#divInput_WsNumber_2_' + id).hide();
        $('#divInput_WsUnit_2_' + id).hide();

        //Retriving to OrginalData
        if (rowData != null) {
            $('#inputYear_' + id).val(rowData.yearId);
            $('#inputOrg_' + id).val(rowData.organizationId);
            $('#inputUserType_' + id).val(rowData.userTypeId);
            $('#inputWNumber_' + id).val(rowData.wNumber);
            $('#inputWUnit_' + id).val(rowData.wUnit);
            $('#inputWsNumber_' + id).val(rowData.wsNumber);
            $('#inputWsUnit_' + id).val(rowData.wsUnit);
            $('#inputWNumber_2_' + id).val(rowData.wNumber_2);
            $('#inputWUnit_2_' + id).val(rowData.wUnit_2);
            $('#inputWsNumber_2_' + id).val(rowData.wsNumber_2);
            $('#inputWsUnit_2_' + id).val(rowData.wsUnit_2);
        }

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_Org_' + id).show();
        $('#divOutput_UserType_' + id).show();
        $('#divOutput_WNumber_' + id).show();
        $('#divOutput_WUnit_' + id).show();
        $('#divOutput_WsNumber_' + id).show();
        $('#divOutput_WsUnit_' + id).show();
        $('#divOutput_WNumber_2_' + id).show();
        $('#divOutput_WUnit_2_' + id).show();
        $('#divOutput_WsNumber_2_' + id).show();
        $('#divOutput_WsUnit_2_' + id).show();

        $('#btnEdit_' + id).show();
        $('#btnDelete_' + id).show();
        $('#btnSaveEdit_' + id).hide();
        $('#btnCancelEdit_' + id).hide();
        $('th,tr td').hide();
        showingColmuns.split(',').forEach((value, index) => {
            if (value !== '') {
                $(`th:nth-child(${value}), tr td:nth-child(${value})`).show();
            }
        })
        $(`th:last-child, tr td:last-child`).show();

    }

    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.userTypeId = $('#inputUserType_' + id).val();
        model.wNumber = $('#inputWNumber_' + id).val();
        model.wUnit = $('#inputWUnit_' + id).val();
        model.wsNumber = $('#inputWsNumber_' + id).val();
        model.wsUnit = $('#inputWsUnit_' + id).val();
        model.wNumber_2 = $('#inputWNumber_2_' + id).val();
        model.wUnit_2 = $('#inputWUnit_2_' + id).val();
        model.wsNumber_2 = $('#inputWsNumber_2_' + id).val();
        model.wsUnit_2 = $('#inputWsUnit_2_' + id).val();

        $.ajax({
            url: '@Url.Action(SalesSplitTotalController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.userTypeId = model.userTypeId;
                rowData.wNumber = model.wNumber;
                rowData.wUnit = model.wUnit;
                rowData.wsNumber = model.wsNumber;
                rowData.wsUnit = model.wsUnit;
                rowData.wNumber_2 = model.wNumber_2;
                rowData.wUnit_2 = model.wUnit_2;
                rowData.wsNumber_2 = model.wsNumber_2;
                rowData.wsUnit_2 = model.wsUnit_2;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanUserType_' + id).text(data.userTypeDisplay);
                $('#spanWNumber_' + id).text(data.wNumber);
                $('#spanWUnit_' + id).text(data.wUnit);
                $('#spanWsNumber_' + id).text(data.wsNumber);
                $('#spanWsUnit_' + id).text(data.wsUnit);
                $('#spanWNumber_2_' + id).text(data.wNumber_2);
                $('#spanWUnit_2_' + id).text(data.wUnit_2);
                $('#spanWsNumber_2_' + id).text(data.wsNumber_2);
                $('#spanWsUnit_2_' + id).text(data.wsUnit_2);
                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401) {
                    if (request.status == 401 || request.status == 403) {
                        ShowPermissionErorr();
                        return;
                    }
                    ShowCommonErorr();
                }
            }
        });
    }

    function saveNewRow(e) {

        resetTableBackColor("my-table");

        var model = {};
        model.yearId = $(e).find('#inputYear_').val();
        model.organizationId = $(e).find('#inputOrg_').val();
        model.userTypeId = $(e).find('#inputUserType_').val();
        model.wNumber = $(e).find('#inputWNumber_').val();
        if (model.wNumber == "") {
            model.wNumber = 0;
        }
        model.wUnit = $(e).find('#inputWUnit_').val();
        if (model.wUnit == "") {
            model.wUnit = 0;
        }
        model.wsNumber = $(e).find('#inputWsNumber_').val();
        if (model.wsNumber == "") {
            model.wsNumber = 0;
        }
        model.wsUnit = $(e).find('#inputWsUnit_').val();
        if (model.wsUnit == "") {
            model.wsUnit = 0;
        }
        model.wNumber_2 = $(e).find('#inputWNumber_2_').val();
        if (model.wNumber_2 == "") {
            model.wNumber_2 = 0;
        }
        model.wUnit_2 = $(e).find('#inputWUnit_2_').val();
        if (model.wUnit_2 == "") {
            model.wUnit_2 = 0;
        }
        model.wsNumber_2 = $(e).find('#inputWsNumber_2_').val();
        if (model.wsNumber_2 == "") {
            model.wsNumber_2 = 0;
        }
        model.wsUnit_2 = $(e).find('#inputWsUnit_2_').val();
        if (model.wsUnit_2 == "") {
