                $('#divOutput_WsNumber_' + data.id).show();

                //WsUnit
                $(e).find('#divInput_WsUnit_').attr('id', 'divInput_WsUnit_' + data.id);
                $(e).find('#inputWsUnit_').attr('id', 'inputWsUnit_' + data.id);
                $(e).find('#divOutput_WsUnit_').attr('id', 'divOutput_WsUnit_' + data.id);
                $(e).find('#spanWsUnit_').attr('id', 'spanWsUnit_' + data.id);

                $('#divInput_WsUnit_' + data.id).hide();
