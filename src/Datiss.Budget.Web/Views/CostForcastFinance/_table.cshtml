@model CostForcastFinanceIndexViewModel

<div class="table-responsive">
    <table style="width:100%" id="my-table" class="table table-hover table-bordered m-0 my-font table-overflow">
        <thead class="thead-light">
            <tr>

                <th style="min-width:140px">سال</th>
                <th style="min-width:180px">سازمان</th>
                <th style="min-width:180px">مرکز هزینه</th>
                <th style="min-width:160px">عنوان دارایی</th>
                <th style="min-width:150px;font-size:x-small">مانده دارایی در سال پایه</th>
                <th style="min-width:150px;font-size:x-small">دارایی ایجاد شده در نیمه اول سال ماقبل</th>
                <th style="min-width:150px;font-size:x-small">پیش بینی دارایی ایجاد شده در نیمه دوم</th>
                <th style="min-width:150px;font-size:x-small">پیش بینی دارایی ایجاد شده در سال</th>
                <th style="min-width:150px;font-size:x-small">کل دارایی ایجاد شده در پایان سال</th>
                <th width="10%">مدیریت</th>

            </tr>
        </thead>
        <tbody>
            <tr id="rowTemplate" style="display: none">
                <td>
                    <div id="divInput_Year_">
                        <input id="hidYearId_" type="hidden" />
                        <select class="form-control selectYear" id="inputYear_" asp-items="Model.YearSource">
                        </select>
                        <script>
                            $('select#inputYear_ option[value=' + $('#yearId').val() + ']').attr('selected', true);
                            $('#inputYear_').attr('disabled', 'disabled');
                        </script>
                    </div>
                    <div id="divOutput_Year_" style="display: none">
                        <span id="spanYear_"></span>
                    </div>
                </td>
                <td>
                    <div id="divInput_Org_">
                        <input id="hidOrgId_" type="hidden" />
                        <select class="form-control selectOrganization" id="inputOrg_" asp-items="Model.InputOrganizationSource">
                        </select>
                        <script>
                            $('select#inputOrg_ option[value=' + $('#organizationId').val() + ']').attr('selected', true);
                        </script>
                    </div>
                    <div id="divOutput_Org_">
                        <span id="spanOrg_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_CostCenterType_">
                        <input id="hidCostCenterTypeId_" type="hidden" />
                        <select class="form-control selectCostCenterType" id="inputCostCenterType_" asp-items="Model.CostCenterTypeSource">
                        </select>
                    </div>
                    <div id="divOutput_CostCenterType_" style="display: none">
                        <span id="spanCostCenterType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_FinanceSubjectType_">
                        <input id="hidFinanceSubjectTypeId_" type="hidden" />
                        <select class="form-control selectFinanceSubjectType" id="inputFinanceSubjectType_" asp-items="Model.FinanceSubjectTypeSource">
                        </select>
                    </div>
                    <div id="divOutput_FinanceSubjectType_" style="display: none">
                        <span id="spanFinanceSubjectType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_RemainingAssets_">
                        <input class="form-control input-keyup default-input" id="inputRemainingAssets_" type="number" />
                    </div>
                    <div id="divOutput_RemainingAssets_" style="display: none">
                        <span id="spanRemainingAssets_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_AssetsCreated6_1_">
                        <input class="form-control input-keyup" id="inputAssetsCreated6_1_" type="number" />
                    </div>
                    <div id="divOutput_AssetsCreated6_1_" style="display: none">
                        <span id="spanAssetsCreated6_1_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_AssetsCreated6_2_">
                        <input class="form-control input-keyup" id="inputAssetsCreated6_2_" type="number" />
                    </div>
                    <div id="divOutput_AssetsCreated6_2_" style="display: none">
                        <span id="spanAssetsCreated6_2_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_ForcastAssets_D_">
                        <input class="form-control input-keyup" id="inputForcastAssets_D_" type="number" />
                    </div>
                    <div id="divOutput_ForcastAssets_D_" style="display: none">
                        <span id="spanForcastAssets_D_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_TotalAssetsCreated_D_">
                        <input class="form-control input-keyup" id="inputTotalAssetsCreated_D_" type="number" />
                    </div>
                    <div id="divOutput_TotalAssetsCreated_D_" style="display: none">
                        <span id="spanTotalAssetsCreated_D_"> </span>
                    </div>
                </td>
                <td>
                    <a id="btnEdit_" class="edit-row btn bg-light-info btn-info mr-1 my-font" style="display: none">
                        <i class="fa ft-edit fa-1x"></i>
                    </a>

                    <a id="btnDelete_" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font" style="display: none">
                        <i class="fa ft-trash-2"></i>
                    </a>

                    <a id="btnSaveEdit_" class="save-edit-row btn btn-success my-font mr-1" style="display: none">
                        <i class="fa ft-check-square"></i>
                    </a>
                    <a id="btnCancelEdit_" class="cancel-edit-row btn btn-secondary my-font" style="display: none">
                        <i class="fa ft-x-square"></i>
                    </a>

                    <a id="btnSaveCreate_" class="save-new-row btn btn-success my-font mr-1">
                        <i class="fa ft-check-square"></i>
                    </a>

                    <a id="btnCancelCreate_" class="cancel-new-row btn btn-danger my-font">
                        <i class="fa ft-x-square"></i>
                    </a>

                </td>
            </tr>
            @foreach (var item in Model.Items)
            {
                <tr id="row_@item.Id">
                    <td>
                        <div id="divInput_Year_@item.Id" style="display: none">
                            <input id="hidYearId_@item.Id" type="hidden" value="@item.YearId" />
                            <select class="form-control selectYear" id="inputYear_@item.Id" asp-items="Model.YearSource">
                            </select>
                            <script>
                                $('select#inputYear_' + @item.Id + ' option[value=' + @item.YearId + ']').attr('selected', true);
                                $('#inputYear_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_Year_@item.Id">
                            <span id="spanYear_@item.Id">@item.Year.ToString()</span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_Org_@item.Id" style="display: none">
                            <input id="hidOrgId_@item.Id" type="hidden" value="@item.OrganizationId" />
                            <select class="form-control selectOrganization" id="inputOrg_@item.Id" asp-items="Model.InputOrganizationSource">
                            </select>
                            <script>
                                $('select#inputOrg_' + @item.Id + ' option[value=' + @item.OrganizationId + ']').attr('selected', true);
                                $('#inputOrg_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_Org_@item.Id">
                            <span id="spanOrg_@item.Id">@item.OrganizationDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_CostCenterType_@item.Id" style="display: none">
                            <input id="hidCostCenterTypeId_@item.Id" type="hidden" value="@item.CostCenterTypeId" />
                            <select class="form-control selectCostCenterType" id="inputCostCenterType_@item.Id" asp-items="Model.CostCenterTypeSource">
                            </select>
                            <script>
                                $('select#inputCostCenterType_' + @item.Id + ' option[value=' + @item.CostCenterTypeId + ']').attr('selected', true);
                                $('#inputCostCenterType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_CostCenterType_@item.Id">
                            <span id="spanCostCenterType_@item.Id">@item.CostCenterTypeDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_FinanceSubjectType_@item.Id" style="display: none">
                            <input id="hidFinanceSubjectTypeId_@item.Id" type="hidden" value="@item.FinanceSubjectTypeId" />
                            <select class="form-control" id="inputFinanceSubjectType_@item.Id" asp-items="Model.FinanceSubjectTypeSource">
                            </select>
                            <script>
                                $('select#inputFinanceSubjectType_' + @item.Id + ' option[value=' + @item.FinanceSubjectTypeId + ']').attr('selected', true);
                                $('#inputFinanceSubjectType_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_FinanceSubjectType_@item.Id">
                            <span id="spanFinanceSubjectType_@item.Id">@item.FinanceSubjectTypeDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_RemainingAssets_@item.Id" style="display: none">
                            <input class="form-control" id="inputRemainingAssets_@item.Id" value="@item.RemainingAssets" type="number" />
                        </div>
                        <div id="divOutput_RemainingAssets_@item.Id">
                            <span id="spanRemainingAssets_@item.Id">@item.RemainingAssetsDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_AssetsCreated6_1_@item.Id" style="display: none">
                            <input class="form-control" id="inputAssetsCreated6_1_@item.Id" value="@item.AssetsCreated6_1" type="number" />
                        </div>
                        <div id="divOutput_AssetsCreated6_1_@item.Id">
                            <span id="spanAssetsCreated6_1_@item.Id">@item.AssetsCreated6_1Display </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_AssetsCreated6_2_@item.Id" style="display: none">
                            <input class="form-control" id="inputAssetsCreated6_2_@item.Id" value="@item.AssetsCreated6_2" type="number" />
                        </div>
                        <div id="divOutput_AssetsCreated6_2_@item.Id">
                            <span id="spanAssetsCreated6_2_@item.Id">@item.AssetsCreated6_2Display </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_ForcastAssets_D_@item.Id" style="display: none">
                            <input class="form-control" id="inputForcastAssets_D_@item.Id" value="@item.ForcastAssets_D" type="number" />
                        </div>
                        <div id="divOutput_ForcastAssets_D_@item.Id">
                            <span id="spanForcastAssets_D_@item.Id">@item.ForcastAssets_DDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_TotalAssetsCreated_D_@item.Id" style="display: none">
                            <input class="form-control" id="inputTotalAssetsCreated_D_@item.Id" value="@item.TotalAssetsCreated_D" type="number" />
                        </div>
                        <div id="divOutput_TotalAssetsCreated_D_@item.Id">
                            <span id="spanTotalAssetsCreated_D_@item.Id">@item.TotalAssetsCreated_DDisplay </span>
                        </div>
                    </td>
                    <td>
                        <a id="btnEdit_@item.Id" data-id="@item.Id" class="edit-row btn bg-light-info btn-info mr-1 my-font">
                            <i class="fa ft-edit fa-1x"></i>
                        </a>

                        <a id="btnDelete_@item.Id" data-id="@item.Id" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                            <i class="fa ft-trash-2"></i>
                        </a>

                        <a id="btnSaveEdit_@item.Id" data-id="@item.Id" class="save-edit-row btn btn-success my-font mr-1" style="display: none">
                            <i class="fa ft-check-square"></i>
                        </a>

                        <a id="btnCancelEdit_@item.Id" data-id="@item.Id" class="cancel-edit-row btn btn-secondary my-font" style="display: none">
                            <i class="fa ft-x-square"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="rowACJSB" style="margin-top:20px">
    <!--Tools-->
    <div class="rowACJS">
        <form id="toolForm"
              enctype="multipart/form-data"
              method="post"
              asp-antiforgery="true">
            <input name="filterYearId" type="hidden" value="@Model.Filter.YearId" />
            <input name="filterOrganizationId" type="hidden" value="@Model.Filter.OrganizationId" />

            <span data-toggle="modal" data-target="#backdrop">
                <button data-toggle="tooltip" data-placement="top" title="ورود اطلاعات از اکسل" type="button" name="btnExcelImport" onclick="openImportExcelForm();" class="btn btn-secondary bg-light-secondary mr-1 my-font">
                    <i _ngcontent-dpj-c129="" class="fa fa-cloud-upload"></i>
                </button>
            </span>
            <span data-toggle="modal" data-target="#CopyModal">
                <button data-toggle="tooltip" data-placement="top" title="کپی اطلاعات" type="button" name="btnCopy" class="btn btn-warning bg-light-warning mr-1 my-font openCopy">
                    <i _ngcontent-dpj-c129="" class="fa fa-copy"></i>
                </button>
            </span>
            <button data-toggle="tooltip" data-placement="top" title="حذف اطلاعات" type="button" onclick="return hardDelete(this.click);" name="btnDelete" class="btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                <i _ngcontent-dpj-c129="" class="fa fa-trash"></i>
            </button>
            <button id="btnCreate" data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" class="btn btn-success bg-light-success my-font">
                <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
            </button>
        </form>

    </div>
    <!--Pagination-->
    <div class="rowAC">
        <div class="my-font">کل رکوردها: <b class="font-medium-2">@Model.TotalCount</b></div>
        <div class="my-font ml-2">
            (صفحه <b class="font-medium-2">@Model.PageNumber</b> از
            <b class="font-medium-2">
                @if (Model.PagesCount == 0)
                {<span>1</span>}
                else
                {<span>@Model.PagesCount</span>}
            </b>)
        </div>
    </div>
    <!--Pagination-->
    <vc:pager model="Model.ToPager()" controller-name="@CostForcastFinanceController.Name" action-name="@CostForcastFinanceController.ACTION_Index"></vc:pager>
</div>