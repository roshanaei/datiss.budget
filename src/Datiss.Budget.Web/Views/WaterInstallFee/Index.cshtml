@model WaterInstallFeeIndexViewModel
@{ ViewData["Title"] = "تعرفه نصب انشعاب آب"; }

<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            @*<i class="ft-settings mr-1"></i>*@
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">

                @if (ViewData["message"] != null) {
                    <div class="alert bg-light-@(ViewData["type"] ?? CssClassNames.Default) alert-dismissible m-2" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                        </button>
                        <span>@ViewData["message"]</span>
                    </div>
                }

                <div class="card-content">
                    <div class="card-body">
                        <!--Filters-->
                        <form method="post"
                              id="filterForm"
                              asp-controller="@WaterInstallFeeController.Name"
                              asp-action="@WaterInstallFeeController.ACTION_Index"
                              asp-antiforgery="true">

                            <div class="class=" rowACJSB"">
                                <fieldset class="form-group mt-3">
                                    <label asp-for="Filter.YearId" class="my-font">
                                        سال:
                                        <select asp-for="Filter.YearId"
                                                asp-items="Model.Filter.YearSource"
                                                class="form-control d-inline-block width-100" 
                                                id="yearId">
                                        </select>
                                    </label>
                                    <label asp-for="Filter.OrganizationId" class="my-font" style="margin-right:20px">
                                        سازمان:
                                        <select asp-for="Filter.OrganizationId"
                                                asp-items="Model.Filter.OrganizationSource"
                                                class="form-control d-inline-block width-300" 
                                                id="organizationId"  >
                                        </select>
                                    </label>
                                    <input asp-for="Filter.OrderBy" type="hidden" />
                                    <input asp-for="Filter.OrderDesc" type="hidden" />
                                </fieldset>
                                <fieldset>
                                    <div class="rowACJE">
                                        <button data-toggle="tooltip" data-placement="top" title="فیلتر" type="submit" name="btnFilter" class="btn btn-info bg-light-info  mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-filter"></i>
                                        </button>
                                        <button id="btnCreate" data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" class="btn btn-success bg-light-success my-font">
                                            <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
                                        </button>
                                    </div>
                                </fieldset>
                            </div>

                            <hr />
                            <!--SearchBox-->
                            <div class="rowACJSB">
                                <div class="rowAC" style="flex:1">
                                    <fieldset class="form-group">
                                        <label for="ngx-filter-ref" class="my-font">
                                            جستجو:
                                            <input asp-for="Filter.Search" id="ngx-filter-ref" type="text" placeholder="..." class="form-control form-control-sm d-inline-block width-200">
                                        </label>
                                    </fieldset>
                                    <fieldset class="form-group" style="margin-right:10px">
                                        <label class="my-font rowAC">
                                            <span>نمایش</span>

                                            <select asp-for="Filter.PageSize"
                                                    style="margin-right:10px"
                                                    class="form-control"
                                                    onchange="changePageSize();"
                                                    id="ddlPageSize">
                                                <option>10</option>
                                                <option>20</option>
                                                <option>30</option>
                                            </select>
                                            <span style="margin-right:10px">رکورد</span>

                                        </label>
                                    </fieldset>
                                </div>
                                <fieldset>
                                    <div class="rowACJE">
                                        <a data-toggle="tooltip" data-placement="top" title="دانلود اطلاعات جدول" name="btnExportExcel" asp-action="@WaterInstallFeeController.ACTION_ExportExcel" class="btn btn-secondary bg-light-secondary mr-1 my-font">
                                            <i _ngcontent-dpj-c129="" class="fa ft-database"></i>
                                        </a>
                                        <a data-toggle="tooltip" data-placement="top" asp-action="@WaterInstallFeeController.ACTION_DownloadExcelTemplate" title="دانلود فرمت اکسل" name="btnDownloadExcelTemp" class="btn btn-warning bg-light-warning my-font">
                                            <i _ngcontent-dpj-c129="" class="fa ft-download-cloud"></i>
                                        </a>
                                    </div>
                                </fieldset>
                            </div>
                        </form>

                        <!--DataTable-->
                        <partial name="_table" model="Model" />

                    </div>

                </div>
            </div>
        </div>
    </div>

</section>



@section footSection {

    <partial name="_excelModal" model="new ImportExcelViewModel()" />
    <div id="divCreate">

    </div>

    <div id="divCopy">

    </div>

    <partial name="_tableScript" />

    <script type="text/javascript">
        function hardDelete(e) {
            Swal.fire({
                title: 'برای حذف اطمینان دارید؟',
                text: "توجه داشته باشید که این عملیات قابل برگشت نیست!",
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#2F8BE6',
                animation: false,
                customClass: 'animated flipInX',
                cancelButtonColor: '#F55252',
                cancelButtonText: 'انصراف',
                confirmButtonText: 'حذف اطلاعات!',

                confirmButtonClass: 'btn btn-warning my-font',
                cancelButtonClass: 'btn btn-danger  my-font ml-1',
                buttonsStyling: false,
            }).then(function (result) {
                if (result.value) {
                    $('#toolForm').attr('action', '@Url.Action("Delete")');
                    $('#toolForm').submit();

                    return true;
                }
                else {

                    return false;
                }
            });
        }

        function calculation(e) {
            $('#toolForm').attr('action', '@Url.Action("Calculation")');
            $('#toolForm').submit();

            return true;
        }

        function loadCreateLink() {
            var a = document.getElementById("createLink");
            var organizationId = document.getElementById('organizationId').value;

            var yearId = document.getElementById('yearId').value;

            var url = 'waterinstallfee/create'

            a.href = url + "/" + organizationId + "/" + yearId;
        }

        function openImportExcelForm() {
            $('#importExcelForm').attr(
                'action',
                '@Url.Action(WaterInstallFeeController.ACTION_ImportExcel)'
            );
            $('#ExcellModal').modal('show');
        }


        $(document).on('click', '#btnCreate', function () {
            addNewRow();
        });

        $(document).on('click', '.edit-row', function () {
            let id = $(this).data('id');
            let input = document.getElementById('inputWInstallFee_' + id);
            let btnSaveEdit = document.getElementById('btnSaveEdit_' + id);
            input.addEventListener("keyup", function (event) {
                event.preventDefault();
                // Number 13 is the "Enter" key on the keyboard
                if (event.keyCode === 13) {
                    btnSaveEdit.click();
                }
            });
            editRow(id);
        });

        $(document).on('click', '.delete-row', function () {
            let id = $(this).data('id');
            let btn = this;

            Swal.fire({
                title: 'برای حذف اطمینان دارید؟',
                text: "توجه داشته باشید که این عملیات قابل برگشت نیست!",
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#2F8BE6',
                animation: false,
                customClass: 'animated flipInX',
                cancelButtonColor: '#F55252',
                cancelButtonText: 'انصراف',
                confirmButtonText: 'حذف اطلاعات!',

                confirmButtonClass: 'btn btn-warning my-font',
                cancelButtonClass: 'btn btn-danger  my-font ml-1',
                buttonsStyling: false,
            }).then(function (result) {
                if (result.value) {
                    deleteRow(btn, id);

                    return true;
                }
                else {

                    return false;
                }
            });
        });

        $(document).on('click', '.cancel-edit-row', function () {
            let id = $(this).data('id');
            cancelEditRow(id);
        });

        $(document).on('click', '.save-edit-row', function () {
            let id = $(this).data('id');
            $(this).prop('disabled', true);
            saveEditRow(id);
            $(this).prop('disabled', false);
        });

        $(document).on('click', '.save-new-row', function () {
            let row = $(this).closest('tr');
            saveNewRow(row);
        });

        $(document).on('click', '.cancel-new-row', function () {
            cancelNewRow(this);
        });

        $(document).on('click', '.openCopy', function() {

            $.ajax({
                type: 'GET',
                url: '@Url.Action("Copy")',
                success: function (data, status, settings) {
                    $('#divCopy').html('');
                    $("#divCopy").html(data);
                    $('#CopyModal').modal('show');
                },
                error: function (request, options, err) {
                    console.log(err);
                    $("#divCopy").html('Failed to load more content');
                }
            });

        });

        $(document).on('click', '#btnDoCopy', function () {
            let model = {};
            model.sourceYearId = $('#SourceYearId option:selected').val();
            model.sourceOrgId = $('#SourceOrgId').val();
            model.targetYearId = $('#TargetYearId option:selected').val();

            console.log(model);

            $.ajax({
                type: 'POST',
                url: '@Url.Action(WaterInstallFeeController.ACTION_Copy)',
                data: model,
                dataType: 'json',
                success: function (data, status, settings) {
                    if (data._HasError) {
                        Swal.fire({
                            title: 'خطا',
                            text: data._ErrorMessage,
                            type: 'warning',
                            confirmButtonColor: '#2F8BE6',
                            animation: false,
                            customClass: 'animated flipInX',
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-warning my-font',
                            buttonsStyling: false,
                        });
                        return;
                    }

                    Swal.fire({
                        title: 'عملیات موفق',
                        text: "عملیات کپی اطلاعات با موفقیت انجام شد.",
                        type: 'info',
                        confirmButtonColor: '#2F8BE6',
                        animation: false,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-warning my-font',
                        buttonsStyling: false,
                    });
                },
                error: function (request, options, err) {
                    console.log(err);
                    alert('عملیات کپی با خطا مواجه شد.');
                }
            });
        });


        function changePageSize() {
            let pageSize = $('#ddlPageSize').attr('value');
            console.log(pageSize);
            $('#filterForm').submit();
        }

         function exportExcel() {

            $.ajax({
                type: 'POST',
                url: '@Url.Action(WaterInstallFeeController.ACTION_ExportExcel)',
                success: function (data, status, settings) {
                    console.log(data);
                },
                error: function (ajaxrequest, ajaxOptions, thrownError) {
                    console.log('erorr');
                }
            });
        };

    </script>

}

