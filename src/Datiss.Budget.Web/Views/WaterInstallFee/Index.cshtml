@model WaterInstallFeeIndexViewModel

<div>
    <form asp-controller="WaterInstallFee" asp-action="Index" asp-antiforgery="true">
        <label asp-for="Filter.YearId">Year</label> : <
    </form>
</div>

<table>
    <thead>
        <tr>
            <th>Year</th>
            <th>Organization</th>
            <th>DWaterType</th>
            <th>Fee</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model.Model.Items) {
            <tr>
                <td>@item.Year.ToString()</td>
                <td>@item.OrganizationDisplay </td>
                <td>@item.DWaterTypeDisplay </td>
                <td>@item.WInstallFee.ToString() </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <p>
            Total count : @Model.TotalCount - Page @Model.PageNumber of @Model.PagesCount
        </p>
    </tfoot>
</table>
