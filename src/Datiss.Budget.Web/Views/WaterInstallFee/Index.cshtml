@model WaterInstallFeeIndexViewModel


@{ ViewData["Title"] = "تعرفه نصب انشعاب آب"; }



<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title my-font">@ViewData["Title"]</h4>
                </div>
                <div class="card-content">
                    <div class="card-body">
                        <fieldset class="form-group">
                            <label for="ngx-filter-ref" class="my-font">
                                جستجو:
                                <input id="ngx-filter-ref" type="text" placeholder="..." class="form-control form-control-sm d-inline-block width-200">
                            </label>
                        </fieldset>
                        <fieldset class="form-group">
                            <label for="Filter.YearId" class="my-font">
                                سال:
                                <select class="form-control form-control-sm d-inline-block width-200" id="Filter.YearId" placeholder="انتخاب کنید...">
                                </select>
                            </label>
                            <label for="Filter.OrganizationId" class="my-font">
                                سازمان:
                                <select class="form-control form-control-sm d-inline-block width-200" id="Filter.OrganizationId" placeholder="انتخاب کنید...">
                                </select>
                            </label>
                        </fieldset>

                        <div class="col-12 d-flex flex-sm-row flex-column justify-content-end mt-3 mt-sm-2">
                            <button type="submit" name="btnFilter" class="btn btn-primary bg-light-primary mr-1 mb-1 my-font">فیلتر</button>
                            <button type="submit" name="btnCreate" class="btn btn-info bg-light-info mb-1 my-font">جدید</button>
                        </div>
                        <div>
                            <form method="post" asp-controller="WaterInstallFee" asp-action="Index" asp-antiforgery="true">
                                <label asp-for="Filter.YearId">Year</label> :
                                <select id="yearId" asp-for="Filter.YearId" asp-items="Model.Filter.YearSource" onchange="loadCreateLink()"></select>

                                <label asp-for="Filter.OrganizationId">Organizzation:</label>
                                <select id="organizationId" asp-for="Filter.OrganizationId" asp-items="Model.Filter.OrganizationSource" onchange="loadCreateLink()"></select>

                                <input asp-for="Filter.OrderBy" type="hidden" />
                                <input asp-for="Filter.OrderDesc" type="hidden" />

                                <button type="submit" name="btnFilter">Filter</button>
                                <button type="submit" name="btnCreate">Create</button>
                            </form>
                        </div>

                        <div style="padding-top: 50px">
                            <a id="createLink">Create</a>
                        </div>




                        <div class="table-responsive">
                            <table id="" class="table table-hover table-bordered m-0 my-font">
                                <thead class="thead-light">
                                    <tr>
                                        <th>سال</th>
                                        <th>سازمان</th>
                                        <th>کاربری</th>
                                        <th>قیمت</th>
                                        <th>مدیریت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Model.Items)
                                    {
                                        <tr>
                                            <td>@item.Year.ToString()</td>
                                            <td>@item.OrganizationDisplay </td>
                                            <td>@item.DWaterTypeDisplay </td>
                                            <td>@item.WInstallFee.ToString() </td>
                                            <td>
                                                <a asp-controller="WaterInstallFee" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                               
                            </table>


                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Year</th>
                                    <th>Organization</th>
                                    <th>DWaterType</th>
                                    <th>Fee</th>
                                    <th>Edit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Model.Items)
                                {
                                    <tr>
                                        <td>@item.Year.ToString()</td>
                                        <td>@item.OrganizationDisplay </td>
                                        <td>@item.DWaterTypeDisplay </td>
                                        <td>@item.WInstallFee.ToString() </td>
                                        <td>
                                            <a asp-controller="WaterInstallFee" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <p>
                                    Total count : @Model.Model.TotalCount - Page @Model.Model.PageNumber of @Model.Model.PagesCount
                                </p>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            </div>
        </div>
</section>
@section footSection {
    <script>

        function loadCreateLink() {
            var a = document.getElementById("createLink");
            var organizationId = document.getElementById('organizationId').value;

            var yearId = document.getElementById('yearId').value;

            var url = 'waterinstallfee/create'

            a.href = url + "/" + organizationId + "/" + yearId;
        }

        loadCreateLink();
    </script>

}

