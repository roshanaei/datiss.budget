@model CopyViewModel
 <!--Modals-->
<div class="modal fade text-left" id="CopyModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel2" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title my-font" id="myModalLabel2">کپی اطلاعات</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                </button>
            </div>
            <form asp-controller="WaterInstallFee"
                  asp-action="Copy"
                  asp-antiforgery="true">
                <div class="modal-body">
                    <p class="my-font-bold">انتخاب اطلاعات مبدا</p>

                    <div class="my-font col-md-6 col-12">
                        <fieldset class="form-group">
                            <label class="my-font">
                                سال مبدا:
                                <select asp-for="SourceYearId"
                                        asp-items="Model.YearSource"
                                        class="form-control form-control-sm d-inline-block width-100">
                                </select>
                            </label>
                        </fieldset>
                    </div>
                    <div class="my-font col-md-6 col-12">
                        <fieldset class="form-group">
                            <label>
                                سازمان مبدا:
                                <select asp-for="SourceOrgId"
                                        asp-items="Model.OrganizationSource"
                                        class="form-control form-control-sm d-inline-block width-100">
                                </select>
                            </label>
                        </fieldset>
                    </div>


                    <hr>
                    <p class="my-font-bold">انتخاب اطلاعات مقصد</p>
                    <div class="my-font col-md-6 col-12">
                        <fieldset class="form-group">
                            <label class="my-font">
                                سال مقصد:
                                <select asp-for="TargetYearId"
                                        asp-items="Model.YearSource"
                                        class="form-control form-control-sm d-inline-block width-100">
                                </select>
                            </label>
                        </fieldset>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-warning bg-light-warning mr-1 my-font">ثبت</button>
                </div>
            </form>
            
        </div>
    </div>
</div>
<!--Modals-->