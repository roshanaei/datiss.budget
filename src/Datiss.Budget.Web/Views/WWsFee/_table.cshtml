@model WWsFeeIndexViewModel
<div class="table-responsive">
    <table style="width:100%" id="my-table" class="table table-hover table-bordered m-0 my-font table-overflow">
        <thead class="thead-light">
            <tr>

                <th style="min-width:150px">سال</th>
                <th style="min-width:250px">سازمان</th>
                <th style="min-width:150px">حوزه فعالیت</th>
                <th style="min-width:200px">کاربری</th>
                <th style="min-width:200px">طبقات مصرف مسکونی</th>
                <th style="min-width:250px">پارامتر اول تعرفه بهای خدمات</th>
                <th style="min-width:250px">پارامتر دوم تعرفه بهای خدمات</th>
                <th style="min-width:230px">پارامتر اول خدمات تبصره 3</th>
                <th style="min-width:230px">پارامتر دوم خدمات تبصره 3</th>
                <th style="min-width:230px">پارامتر اول خدمات تبصره 7</th>
                <th style="min-width:230px">پارامتر دوم خدمات تبصره 7</th>
                <th style="min-width:200px">مدیریت</th>

            </tr>
        </thead>
        <tbody>
            <tr id="rowTemplate" style="display: none">
                <td>
                    <div id="divInput_Year_">
                        <input id="hidYearId_" type="hidden" />
                        <select class="form-control selectYear" id="inputYear_" asp-items="Model.YearSource">
                        </select>
                        <script>
                            $('select#inputYear_ option[value=' + $('#yearId').val() + ']').attr('selected', true);
                            $('#inputYear_').attr('disabled', 'disabled');
                        </script>
                    </div>
                    <div id="divOutput_Year_" style="display: none">
                        <span id="spanYear_"></span>
                    </div>
                </td>
                <td>
                    <div id="divInput_Org_">
                        <input id="hidOrgId_" type="hidden" />
                        <select class="form-control selectOrganization" id="inputOrg_" asp-items="Model.InputOrganizationSource">
                        </select>
                        <script>
                            $('select#inputOrg_ option[value=' + $('#organizationId').val() + ']').attr('selected', true);
                        </script>
                    </div>
                    <div id="divOutput_Org_">
                        <span id="spanOrg_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_ActivityType_">
                        <input id="hidActivityType_" type="hidden" />
                        <select class="form-control selectUserType" id="inputActivityType_" asp-items="Model.ActivityTypeSource">
                        </select>
                    </div>
                    <div id="divOutput_ActivityType_" style="display: none">
                        <span id="spanActivityType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_UserType_">
                        <input id="hidUserTypeId_" type="hidden" />
                        <select class="form-control selectUserType" id="inputUserType_" asp-items="Model.UserTypeSource" onchange="RelatedDropDown(this,event)">
                        </select>
                    </div>
                    <div id="divOutput_UserType_" style="display: none">
                        <span id="spanUserType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_UsageLayerType_">
                        <input id="hidUsageLayerTypeId_" type="hidden" />
                        <select class="form-control selectUsageLayerType" id="inputUsageLayerType_">
                        </select>
                    </div>
                    <div id="divOutput_UsageLayerType_" style="display: none">
                        <span id="spanUsageLayerType_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_P1Fee_">
                        <input class="form-control input-keyup default-input" id="inputP1Fee_" type="number" min="0"/>
                    </div>
                    <div id="divOutput_P1Fee_" style="display: none">
                        <span id="spanP1Fee_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_P2Fee_">
                        <input class="form-control input-keyup" id="inputP2Fee_" type="number" min="0"/>
                    </div>
                    <div id="divOutput_P2Fee_" style="display: none">
                        <span id="spanP2Fee_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_P1Note3_">
                        <input class="form-control input-keyup" id="inputP1Note3_" type="number" min="0"/>
                    </div>
                    <div id="divOutput_P1Note3_" style="display: none">
                        <span id="spanP1Note3_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_P1Note7_">
                        <input class="form-control input-keyup" id="inputP1Note7_" type="number" min="0"/>
                    </div>
                    <div id="divOutput_P1Note7_" style="display: none">
                        <span id="spanP1Note7_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_P2Note3_">
                        <input class="form-control input-keyup" id="inputP2Note3_" type="number" min="0"/>
                    </div>
                    <div id="divOutput_P2Note3_" style="display: none">
                        <span id="spanP2Note3_"> </span>
                    </div>
                </td>
                <td>
                    <div id="divInput_P2Note7_">
                        <input class="form-control input-keyup" id="inputP2Note7_" type="number" min="0"/>
                    </div>
                    <div id="divOutput_P2Note7_" style="display: none">
                        <span id="spanP2Note7_"> </span>
                    </div>
                </td>
                <td>
                    <a id="btnEdit_" class="edit-row btn bg-light-info btn-info mr-1 my-font" style="display: none">
                        <i class="fa ft-edit fa-1x"></i>
                    </a>

                    <a id="btnDelete_" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font" style="display: none">
                        <i class="fa ft-trash-2"></i>
                    </a>

                    <a id="btnSaveEdit_" class="save-edit-row btn btn-success my-font mr-1" style="display: none">
                        <i class="fa ft-check-square"></i>
                    </a>
                    <a id="btnCancelEdit_" class="cancel-edit-row btn btn-secondary my-font" style="display: none">
                        <i class="fa ft-x-square"></i>
                    </a>

                    <a id="btnSaveCreate_" class="save-new-row btn btn-success my-font mr-1">
                        <i class="fa ft-check-square"></i>
                    </a>

                    <a id="btnCancelCreate_" class="cancel-new-row btn btn-danger my-font">
                        <i class="fa ft-x-square"></i>
                    </a>

                </td>
            </tr>
            @foreach (var item in Model.Items)
            {
                <tr id="row_@item.Id">
                    <td>
                        <div id="divInput_Year_@item.Id" style="display: none">
                            <input id="hidYearId_@item.Id" type="hidden" value="@item.YearId" />
                            <select class="form-control selectYear" id="inputYear_@item.Id" asp-items="Model.YearSource">
                            </select>
                            <script>
                                $('select#inputYear_' + @item.Id + ' option[value=' + @item.YearId + ']').attr('selected', true);
                                $('#inputYear_' + @item.Id).attr('disabled', 'disabled');
                            </script>
                        </div>
                        <div id="divOutput_Year_@item.Id">
                            <span id="spanYear_@item.Id">@item.Year.ToString()</span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_Org_@item.Id" style="display: none">
                            <input id="hidOrgId_@item.Id" type="hidden" value="@item.OrganizationId" />
                            <select class="form-control selectOrganization" id="inputOrg_@item.Id" asp-items="Model.InputOrganizationSource">
                            </select>
                            <script>
                                $('select#inputOrg_' + @item.Id + ' option[value=' + @item.OrganizationId + ']').attr('selected', true);
                                $('#inputOrg_' + @item.Id).select2({ dir : 'rtl' });
                            </script>
                        </div>
                        <div id="divOutput_Org_@item.Id">
                            <span id="spanOrg_@item.Id">@item.OrganizationDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_ActivityType_@item.Id" style="display: none">
                            <input id="hidActivityType_@item.Id" type="hidden" value="@item.ActivityType" />
                            <select class="form-control selectActivityType" id="inputActivityType_@item.Id" asp-items="Model.ActivityTypeSource">
                            </select>
                            <script>
                                $('select#inputActivityType_' + @item.Id + ' option[value=' + @item.ActivityType + ']').attr('selected', true);
                            </script>
                        </div>
                        <div id="divOutput_ActivityType_@item.Id">
                            <span id="spanActivityType_@item.Id">@item.ActivityTypeDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_UserType_@item.Id" style="display: none">
                            <input id="hidUserTypeId_@item.Id" type="hidden" value="@item.UserTypeId" />
                            <select class="form-control selectUserType" id="inputUserType_@item.Id" asp-items="Model.UserTypeSource" onchange="RelatedDropDown(this, event)">
                            </select>
                            <script>
                                $('select#inputUserType_' + @item.Id + ' option[value=' + @item.UserTypeId + ']').attr('selected', true);
                            </script>
                        </div>
                        <div id="divOutput_UserType_@item.Id">
                            <span id="spanUserType_@item.Id">@item.UserTypeDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_UsageLayerType_@item.Id" style="display: none">
                            <input id="hidUsageLayerTypeId_@item.Id" type="hidden" value="@item.UsageLayerId" />
                            <select class="form-control selectUsageLayerType" id="inputUsageLayerType_@item.Id">
                            </select>
                            <script>
                                $('select#inputUsageLayerType_' + @item.Id + ' option[value=' + @item.UsageLayerId + ']').attr('selected', true);
                            </script>
                        </div>
                        <div id="divOutput_UsageLayerType_@item.Id">
                            <span id="spanUsageLayerType_@item.Id">@item.UsageLayerDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_P1Fee_@item.Id" style="display: none">
                            <input class="form-control" id="inputP1Fee_@item.Id" value="@item.P1Fee" type="number" min="0"/>
                        </div>
                        <div id="divOutput_P1Fee_@item.Id">
                            <span id="spanP1Fee_@item.Id">@item.P1FeeDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_P2Fee_@item.Id" style="display: none">
                            <input class="form-control" id="inputP2Fee_@item.Id" value="@item.P2Fee" type="number" min="0"/>
                        </div>
                        <div id="divOutput_P2Fee_@item.Id">
                            <span id="spanP2Fee_@item.Id">@item.P2FeeDisplay </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_P1Note3_@item.Id" style="display: none">
                            <input class="form-control" id="inputP1Note3_@item.Id" value="@item.P1Note3" type="number" min="0"/>
                        </div>
                        <div id="divOutput_P1Note3_@item.Id">
                            <span id="spanP1Note3_@item.Id">@item.P1Note3Display </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_P1Note7_@item.Id" style="display: none">
                            <input class="form-control" id="inputP1Note7_@item.Id" value="@item.P1Note7" type="number" min="0"/>
                        </div>
                        <div id="divOutput_P1Note7_@item.Id">
                            <span id="spanP1Note7_@item.Id">@item.P1Note7Display </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_P2Note3_@item.Id" style="display: none">
                            <input class="form-control" id="inputP2Note3_@item.Id" value="@item.P2Note3" type="number" min="0"/>
                        </div>
                        <div id="divOutput_P2Note3_@item.Id">
                            <span id="spanP2Note3_@item.Id">@item.P2Note3Display </span>
                        </div>
                    </td>
                    <td>
                        <div id="divInput_P2Note7_@item.Id" style="display: none">
                            <input class="form-control" id="inputP2Note7_@item.Id" value="@item.P2Note7" type="number" min="0"/>
                        </div>
                        <div id="divOutput_P2Note7_@item.Id">
                            <span id="spanP2Note7_@item.Id">@item.P2Note7Display </span>
                        </div>
                    </td>
                    <td>
                        <a id="btnEdit_@item.Id" data-id="@item.Id" class="edit-row btn bg-light-info btn-info mr-1 my-font">
                            <i class="fa ft-edit fa-1x"></i>
                        </a>

                        <a id="btnDelete_@item.Id" data-id="@item.Id" class="delete-row btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                            <i class="fa ft-trash-2"></i>
                        </a>

                        <a id="btnSaveEdit_@item.Id" data-id="@item.Id" class="save-edit-row btn btn-success my-font mr-1" style="display: none">
                            <i class="fa ft-check-square"></i>
                        </a>

                        <a id="btnCancelEdit_@item.Id" data-id="@item.Id" class="cancel-edit-row btn btn-secondary my-font" style="display: none">
                            <i class="fa ft-x-square"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="rowACJSB" style="margin-top:20px">
    <!--Tools-->
    <div class="rowACJS">
        <form id="toolForm"
              enctype="multipart/form-data"
              method="post"
              asp-antiforgery="true">
            <input name="filterYearId" type="hidden" value="@Model.Filter.YearId" />
            <input name="filterOrganizationId" type="hidden" value="@Model.Filter.OrganizationId" />

            @*<input asp-for="ExcelFile" type="file" />*@
            <span data-toggle="modal" data-target="#backdrop">
                <button data-toggle="tooltip" data-placement="top" title="ورود اطلاعات از اکسل" type="button" name="btnExcelImport" onclick="openImportExcelForm();" class="btn btn-secondary bg-light-secondary mr-1 my-font">
                    <i _ngcontent-dpj-c129="" class="fa fa-cloud-upload"></i>
                </button>
            </span>
            <span data-toggle="modal" data-target="#CopyModal">
                <button data-toggle="tooltip" data-placement="top" title="کپی اطلاعات" type="button" name="btnCopy" class="btn btn-warning bg-light-warning mr-1 my-font openCopy">
                    <i _ngcontent-dpj-c129="" class="fa fa-copy"></i>
                </button>
            </span>
            <button data-toggle="tooltip" data-placement="top" title="حذف اطلاعات" type="button" onclick="return hardDelete(this.click);" name="btnDelete" class="btn btn-danger confirm-delete  bg-light-danger mr-1 my-font">
                <i _ngcontent-dpj-c129="" class="fa fa-trash"></i>
            </button>
            <button id="btnCreate" data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="button" class="btn btn-success bg-light-success my-font">
                <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
            </button>
            @*<span data-toggle="modal" data-target="#CalculationModal">
                    <button data-toggle="tooltip" data-placement="top" title="اطلاعات محاسبات" type="button" name="btnCalculaton" class="btn btn-info calculation-button bg-light-info mr-1 my-font">
                        <i _ngcontent-dpj-c129="" class="fa fa-calculator"></i>
                    </button>
                </span>*@
        </form>

    </div>
    <div class="rowAC">
        <div class="my-font">کل رکوردها: <b class="font-medium-2">@Model.TotalCount</b></div>
        <div class="my-font ml-2">(صفحه <b class="font-medium-2">@Model.PageNumber</b> از <b class="font-medium-2">@Model.PagesCount</b>)</div>
    </div>
    <!--Pagination-->
    <vc:pager model="Model.ToPager()"></vc:pager>
</div>