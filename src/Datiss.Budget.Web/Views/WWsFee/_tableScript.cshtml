        model.p1Note3 = $('#inputP1Note3_' + id).val();
        model.p1Note7 = $('#inputP1Note7_' + id).val();
        model.p2Note3 = $('#inputP2Note3_' + id).val();
        model.p2Note7 = $('#inputP2Note7_' + id).val();


        $.ajax({
            url: '@Url.Action(WWsFeeController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.activityType = model.activityType;
                rowData.userTypeId = model.userTypeId;
                rowData.usageLayerId = model.usageLayerId;
                rowData.p1Fee = model.p1Fee;
                rowData.p2Fee = model.p2Fee;
                rowData.p1Note3 = model.p1Note3;
                rowData.p1Note7 = model.p1Note7;
                rowData.p2Note3 = model.p2Note3;
                rowData.p2Note7 = model.p2Note7;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#hidUsageLayerTypeId_' + id).attr('value', model.usageLayerId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanActivityType_' + id).text(data.activityTypeDisplay);
                $('#spanUserType_' + id).text(data.userTypeDisplay);
                $('#spanUsageLayerType_' + id).text(data.usageLayerDisplay);
                $('#spanP1Fee_' + id).text(data.p1Fee);
