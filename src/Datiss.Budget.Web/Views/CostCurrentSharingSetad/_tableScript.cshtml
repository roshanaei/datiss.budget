    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.wUnit = $('#inputWUnit_' + id).val();
        model.incomeCurrentW = $('#inputIncomeCurrentW_' + id).val();
        model.incomeCurrentWSharingCoff = $('#inputIncomeCurrentWSharingCoff_' + id).val();
        model.wsUnit = $('#inputWsUnit_' + id).val();
        model.incomeCurrentWs = $('#inputIncomeCurrentWs_' + id).val();
        model.incomeCurrentWsSharingCoff = $('#inputIncomeCurrentWsSharingCoff_' + id).val();
        model.incomeForcast = $('#inputIncomeForcast_' + id).val();
        model.spsHahrdari = $('#inputSPSHahrdari_' + id).val();
        model.incomeForcastsharing = $('#inputIncomeForcastsharing_' + id).val();

        $.ajax({
            url: '@Url.Action(CostCurrentSharingSetadController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.wUnit = model.wUnit;
                rowData.incomeCurrentW = model.incomeCurrentW;
                rowData.incomeCurrentWSharingCoff = model.incomeCurrentWSharingCoff;
                rowData.wsUnit = model.wsUnit;
                rowData.incomeCurrentWs = model.incomeCurrentWs;
                rowData.incomeCurrentWsSharingCoff = model.incomeCurrentWsSharingCoff;
                rowData.incomeForcast = model.incomeForcast;
                rowData.spsHahrdari = model.spsHahrdari;
                rowData.incomeForcastsharing = model.incomeForcastsharing;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanWUnit_' + id).text(data.wUnit);
                $('#spanIncomeCurrentW_' + id).text(data.incomeCurrentW);
                $('#spanIncomeCurrentWSharingCoff_' + id).text(data.incomeCurrentWSharingCoff);
                $('#spanWsUnit_' + id).text(data.wsUnit);
                $('#spanIncomeCurrentWs_' + id).text(data.incomeCurrentWs);
                $('#spanIncomeCurrentWsSharingCoff_' + id).text(data.incomeCurrentWsSharingCoff);
                $('#spanIncomeForcast_' + id).text(data.incomeForcast);
                $('#spanSPSHahrdari_' + id).text(data.spsHahrdari);
                $('#spanIncomeForcastsharing_' + id).text(data.incomeForcastsharing);

                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

