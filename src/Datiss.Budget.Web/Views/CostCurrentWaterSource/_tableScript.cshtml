<script type="text/javascript">

    let isNewRow = false;
    let rowData = {};

    function editRow(id) {


        resetTableBackColor("my-table");

        let row = $('#row_' + id);
        //row.css('background-color', '#7598f3');

        //Hide output elements
        $('#divOutput_Year_' + id).hide();
        $('#divOutput_Org_' + id).hide();
        $('#divOutput_WaterSourceType_' + id).hide();
        $('#divOutput_ActiveSource_' + id).hide();
        $('#divOutput_BaseProduction_' + id).hide();
        $('#divOutput_LastYearProduction_' + id).hide();
        $('#divOutput_ForcastProduction_' + id).hide();

        //show input elements
        $('#divInput_Year_' + id).show();
        $('#divInput_Org_' + id).show();
        $('#divInput_WaterSourceType_' + id).show();
        $('#divInput_ActiveSource_' + id).show();
        $('#divInput_BaseProduction_' + id).show();
        $('#divInput_LastYearProduction_' + id).show();
        $('#divInput_ForcastProduction_' + id).show();

        $('#btnEdit_' + id).hide();
        $('#btnDelete_' + id).hide();
        $('#btnSaveEdit_' + id).show();
        $('#btnCancelEdit_' + id).show();

        rowData = {};
        rowData.yearId = $('#inputYear_' + id).val();
        rowData.organizationId = $('#inputOrg_' + id).val();
        rowData.waterSourceTypeId = $('#inputWaterSourceType_' + id).val();
        rowData.activeSource = $('#inputActiveSource_' + id).val();
        rowData.baseProduction = $('#inputBaseProduction_' + id).val();
        rowData.lastYearProduction = $('#inputLastYearProduction_' + id).val();
        rowData.forcastProduction = $('#inputForcastProduction_' + id).val();
    }

    function cancelEditRow(id) {
        let row = $('#row_' + id);
        //row.css('background-color', '');

        //Hide input elements
        $('#divInput_Year_' + id).hide();
        $('#divInput_Org_' + id).hide();
        $('#divInput_WaterSourceType_' + id).hide();
        $('#divInput_ActiveSource_' + id).hide();
        $('#divInput_BaseProduction_' + id).hide();
        $('#divInput_LastYearProduction_' + id).hide();
        $('#divInput_ForcastProduction_' + id).hide();

        //Reverting to OriginalData
        if(rowData != null) {
            console.log('reverting to original data.');
            console.log(rowData);
            $('#inputYear_' + id).val(rowData.yearId);
            $('#inputOrg_' + id).val(rowData.organizationId);
            $('#inputWaterSourceType_' + id).val(rowData.waterSourceTypeId);
            $('#inputActiveSource_' + id).val(rowData.activeSource);
            $('#inputBaseProduction_' + id).val(rowData.baseProduction);
            $('#inputLastYearProduction_' + id).val(rowData.lastYearProduction);
            $('#inputForcastProduction_' + id).val(rowData.forcastProduction);
        }

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_Org_' + id).show();
        $('#divOutput_WaterSourceType_' + id).show();
        $('#divOutput_ActiveSource_' + id).show();
        $('#divOutput_BaseProduction_' + id).show();
        $('#divOutput_LastYearProduction_' + id).show();
        $('#divOutput_ForcastProduction_' + id).show();

        $('#btnEdit_' + id).show();
        $('#btnDelete_' + id).show();
        $('#btnSaveEdit_' + id).hide();
        $('#btnCancelEdit_' + id).hide();
        $('th,tr td').hide();
        showingColmuns.split(',').forEach((value, index) => {
            if (value !== '') {
                $(`th:nth-child(${value}), tr td:nth-child(${value})`).show();
            }
        })
        $(`th:last-child, tr td:last-child`).show();

    }

    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.waterSourceTypeId = $('#inputWaterSourceType_' + id).val();
        model.activeSource = $('#inputActiveSource_' + id).val();
        model.baseProduction = $('#inputBaseProduction_' + id).val();
        model.lastYearProduction = $('#inputLastYearProduction_' + id).val();
        model.forcastProduction = $('#inputForcastProduction_' + id).val();

        $.ajax({
            url: '@Url.Action(CostCurrentWaterSourceController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.waterSourceTypeId = model.waterSourceTypeId;
                rowData.activeSource = model.activeSource;
                rowData.baseProduction = model.baseProduction;
                rowData.lastYearProduction = model.lastYearProduction;
                rowData.forcastProduction = model.forcastProduction;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanWaterSourceType_' + id).text(data.waterSourceTypeDisplay);
                $('#spanActiveSource_' + id).text(data.activeSource);
                $('#spanBaseProduction_' + id).text(data.baseProduction);
                $('#spanLastYearProduction_' + id).text(data.lastYearProduction);
                $('#spanForcastProduction_' + id).text(data.forcastProduction);

                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function saveNewRow(e) {

        resetTableBackColor("my-table");

        var model = {};
        model.yearId = $(e).find('#inputYear_').val();
        model.organizationId = $(e).find('#inputOrg_').val();
        model.waterSourceTypeId = $(e).find('#inputWaterSourceType_').val();
        model.activeSource = $(e).find('#inputActiveSource_').val();
        if (model.activeSource == "") {
            model.activeSource = 0;
        }
        model.baseProduction = $(e).find('#inputBaseProduction_').val();
        if (model.baseProduction == "") {
            model.baseProduction = 0;
        }
        model.lastYearProduction = $(e).find('#inputLastYearProduction_').val();
        if (model.lastYearProduction == "") {
            model.lastYearProduction = 0;
        }
        model.forcastProduction = $(e).find('#inputForcastProduction_').val();
        if (model.forcastProduction == "") {
            model.forcastProduction = 0;
        }

        console.log(model);

        $.ajax({
            url: '@Url.Action(CostCurrentWaterSourceController.ACTION_Create)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data._ErrorMessage}</span>`,
                        type: 'error',
                        animation: false,
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                //Year
                $(e).find('#divInput_Year_').attr('id', 'divInput_Year_' + data.id);
                $(e).find('#hidYearId_').attr('id', 'hidYearId_' + data.id);
                $(e).find('#inputYear_').attr('id', 'inputYear_' + data.id);
                $(e).find('#divOutput_Year_').attr('id', 'divOutput_Year_' + data.id);
                $(e).find('#spanYear_').attr('id', 'spanYear_' + data.id);

                $('#divInput_Year_' + data.id).hide();
                $('#spanYear_' + data.id).text(data.year);
                $('#divOutput_Year_' + data.id).show();

                //Organization
                $(e).find('#divInput_Org_').attr('id', 'divInput_Org_' + data.id);
                $(e).find('#hidOrgId_').attr('id', 'hidOrgId_' + data.id);
                $(e).find('#inputOrg_').attr('id', 'inputOrg_' + data.id);
                $(e).find('#divOutput_Org_').attr('id', 'divOutput_Org_' + data.id);
                $(e).find('#spanOrg_').attr('id', 'spanOrg_' + data.id);

                $('#divInput_Org_' + data.id).hide();
                $('#spanOrg_' + data.id).text(data.organizationDisplay);
                $('#divOutput_Org_' + data.id).show();

                //WaterSourceType
                $(e).find('#divInput_WaterSourceType_').attr('id', 'divInput_WaterSourceType_' + data.id);
                $(e).find('#hidWaterSourceTypeId_').attr('id', 'hidWaterSourceTypeId_' + data.id);
                $(e).find('#inputWaterSourceType_').attr('id', 'inputWaterSourceType_' + data.id);
                $(e).find('#divOutput_WaterSourceType_').attr('id', 'divOutput_WaterSourceType_' + data.id);
                $(e).find('#spanWaterSourceType_').attr('id', 'spanWaterSourceType_' + data.id);

                $('#divInput_WaterSourceType_' + data.id).hide();
                $('#spanWaterSourceType_' + data.id).text(data.waterSourceTypeDisplay);
                $('#divOutput_WaterSourceType_' + data.id).show();

                //ActiveSource
                $(e).find('#divInput_ActiveSource_').attr('id', 'divInput_ActiveSource_' + data.id);
                $(e).find('#inputActiveSource_').attr('id', 'inputActiveSource_' + data.id);
                $(e).find('#divOutput_ActiveSource_').attr('id', 'divOutput_ActiveSource_' + data.id);
                $(e).find('#spanActiveSource_').attr('id', 'spanActiveSource_' + data.id);

                $('#divInput_ActiveSource_' + data.id).hide();
                $('#spanActiveSource_' + data.id).text(data.activeSource);
                $('#divOutput_ActiveSource_' + data.id).show();

                //BaseProduction
                $(e).find('#divInput_BaseProduction_').attr('id', 'divInput_BaseProduction_' + data.id);
                $(e).find('#inputBaseProduction_').attr('id', 'inputBaseProduction_' + data.id);
                $(e).find('#divOutput_BaseProduction_').attr('id', 'divOutput_BaseProduction_' + data.id);
                $(e).find('#spanBaseProduction_').attr('id', 'spanBaseProduction_' + data.id);

                $('#divInput_BaseProduction_' + data.id).hide();
                $('#spanBaseProduction_' + data.id).text(data.baseProduction);
                $('#divOutput_BaseProduction_' + data.id).show();

                //LastYearProduction
                $(e).find('#divInput_LastYearProduction_').attr('id', 'divInput_LastYearProduction_' + data.id);
                $(e).find('#inputLastYearProduction_').attr('id', 'inputLastYearProduction_' + data.id);
                $(e).find('#divOutput_LastYearProduction_').attr('id', 'divOutput_LastYearProduction_' + data.id);
                $(e).find('#spanLastYearProduction_').attr('id', 'spanLastYearProduction_' + data.id);

                $('#divInput_LastYearProduction_' + data.id).hide();
                $('#spanLastYearProduction_' + data.id).text(data.lastYearProduction);
                $('#divOutput_LastYearProduction_' + data.id).show();

                //ForcastProduction
                $(e).find('#divInput_ForcastProduction_').attr('id', 'divInput_ForcastProduction_' + data.id);
                $(e).find('#inputForcastProduction_').attr('id', 'inputForcastProduction_' + data.id);
                $(e).find('#divOutput_ForcastProduction_').attr('id', 'divOutput_ForcastProduction_' + data.id);
                $(e).find('#spanForcastProduction_').attr('id', 'spanForcastProduction_' + data.id);

                $('#divInput_ForcastProduction_' + data.id).hide();
                $('#spanForcastProduction_' + data.id).text(data.forcastProduction);
                $('#divOutput_ForcastProduction_' + data.id).show();

                //Buttons
                $(e).find('#btnEdit_').data('id', data.id);
                $(e).find('#btnDelete_').data('id', data.id);
                $(e).find('#btnSaveEdit_').data('id', data.id);
                $(e).find('#btnCancelEdit_').data('id', data.id);
                $(e).find('#btnSaveCreate_').data('id', data.id);
                $(e).find('#btnCancelCreate_').data('id', data.id);

                $(e).find('#btnEdit_').attr('id', 'btnEdit_' + data.id);
                $(e).find('#btnDelete_').attr('id', 'btnDelete_' + data.id);
                $(e).find('#btnSaveEdit_').attr('id', 'btnSaveEdit_' + data.id);
                $(e).find('#btnCancelEdit_').attr('id', 'btnCancelEdit_' + data.id);
                $(e).find('#btnSaveCreate_').attr('id', 'btnSaveCreate_' + data.id);
                $(e).find('#btnCancelCreate_').attr('id', 'btnCancelCreate_' + data.id);

                $('#btnSaveCreate_' + data.id).hide();
                $('#btnCancelCreate_' + data.id).hide();
                $('#btnEdit_' + data.id).show();
                $('#btnDelete_' + data.id).show();

                $('#inputOrg_' + data.id).select2();
                $(e).css('background-color', 'rgb(245 245 246)');
                isNewRow = false;
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function addNewRow() {
        if (isNewRow) return;

        resetTableBackColor("my-table");


        var template = $('#rowTemplate').clone()
            .appendTo($('#my-table tbody'))
            .attr('id', 'newRow')
            .css('background-color', 'rgb(230 247 228)')
            .show();
        
        $('.selectOrganization:last').select2({
            dir: 'rtl'
        });

        $('.selectwaterSourceType:last').select2({
            dir : 'rtl'
        });

        $('.default-input:last').keyup(function (event) {
            event.preventDefault();
            if (event.keyCode === 13) {
                let row = $(this).closest('tr');
                saveNewRow(row);
            }
        });

        let newRowElement = document.getElementById('newRow');
        newRowElement.scrollIntoView();
        $('.default-input:last').focus();

        isNewRow = true;
    }

    function cancelNewRow(e) {
        $(e).closest('tr').remove();
        isNewRow = false;
    }

    function deleteRow(e, id) {
        console.log(e);

        $.ajax({
            url: '@Url.Action(CostCurrentWaterSourceController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
                if (data.hasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data.message}</span>`,
                        type: 'error',
                        confirmButtonColor: '#2F8BE6',
                        animation: false,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                $(e).closest('tr').remove();
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function resetTableBackColor(id) {
        var table = document.getElementById(id);
        var rows = table.getElementsByTagName("tr");
        for (i = 2; i < rows.length - 1; i++) {
            rows[i].style = "";
        }
    }

</script>