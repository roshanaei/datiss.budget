<script type="text/javascript">

    let isNewRow = false;
    let rowData = {};

    function editRow(id) {

        resetTableBackColor("my-table");

        let row = $('#row_' + id);

        //Hide output elements
        $('#divOutput_Year_' + id).hide();
        $('#divOutput_CostCenterType_' + id).hide();
        $('#divOutput_CCOtherCostsType_' + id).hide();
        $('#divOutput_Fee_' + id).hide();

        //show input elements
        $('#divInput_Year_' + id).show();
        $('#divInput_CostCenterType_' + id).show();
        $('#divInput_CCOtherCostsType_' + id).show();
        $('#divInput_Fee_' + id).show();

        $('#btnEdit_' + id).hide();
        $('#btnDelete_' + id).hide();
        $('#btnSaveEdit_' + id).show();
        $('#btnCancelEdit_' + id).show();

        rowData = {};
        rowData.yearId = $('#inputYear_' + id).val();
        rowData.costCenterTypeId = $('#inputCostCenterType_' + id).val();
        rowData.ccOtherCostsTypeId = $('#inputCCOtherCostsType_' + id).val();
        rowData.baseFee = $('#inputFee_' + id).val();
    }

    function cancelEditRow(id) {
        let row = $('#row_' + id);

        //Hide input elements
        $('#divInput_Year_' + id).hide();
        $('#divInput_CostCenterType_' + id).hide();
        $('#divInput_CCOtherCostsType_' + id).hide();
        $('#divInput_Fee_' + id).hide();

        //Reverting to OriginalData
        if (rowData != null) {
            $('#inputYear_' + id).val(rowData.yearId);
            $('#inputCostCenterType_' + id).val(rowData.costCenterTypeId);
            $('#inputCCOtherCostsType_' + id).val(rowData.ccOtherCostsTypeId);
            $('#inputFee_' + id).val(rowData.baseFee);
        }

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_CostCenterType_' + id).show();
        $('#divOutput_CCOtherCostsType_' + id).show();
        $('#divOutput_Fee_' + id).show();

        $('#btnEdit_' + id).show();
        $('#btnDelete_' + id).show();
        $('#btnSaveEdit_' + id).hide();
        $('#btnCancelEdit_' + id).hide();
        $('th,tr td').hide();
        showingColmuns.split(',').forEach((value, index) => {
            if (value !== '') {
                $(`th:nth-child(${value}), tr td:nth-child(${value})`).show();
            }
        })
        $(`th:last-child, tr td:last-child`).show();

    }

    function saveEditRow(id) {


        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.costCenterTypeId = $('#inputCostCenterType_' + id).val();
        model.ccOtherCostsTypeId = $('#inputCCOtherCostsType_' + id).val();
        model.fee = $('#inputFee_' + id).val();

        $.ajax({
            url: '@Url.Action(CostCurrentOtherCofficientController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.costCenterTypeId = model.costCenterTypeId;
                rowData.ccOtherCostsTypeId = model.ccOtherCostsTypeId;
                rowData.fee = model.fee;

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#spanYear_' + id).text(data.year);
                $('#spanCostCenterType_' + id).text(data.costCenterTypeDisplay);
                $('#spanCCOtherCostsType_' + id).text(data.ccOtherCostsTypeDisplay);
                $('#spanFee_' + id).text(data.fee);


                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function saveNewRow(e) {

        resetTableBackColor("my-table");

        var model = {};
        model.yearId = $(e).find('#inputYear_').val();
        model.costCenterTypeId = $(e).find('#inputCostCenterType_').val();
        model.ccOtherCostsTypeId = $(e).find('#inputCCOtherCostsType_').val();
        model.fee = $(e).find('#inputFee_').val();
        if(model.fee == "")
            model.fee = 0;

        console.log(model);

        $.ajax({
            url: '@Url.Action(CostCurrentOtherCofficientController.ACTION_Create)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data._ErrorMessage}</span>`,
                        type: 'error',
                        animation: false,
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                //Year
                $(e).find('#divInput_Year_').attr('id', 'divInput_Year_' + data.id);
                $(e).find('#hidYearId_').attr('id', 'hidYearId_' + data.id);
                $(e).find('#inputYear_').attr('id', 'inputYear_' + data.id);
                $(e).find('#divOutput_Year_').attr('id', 'divOutput_Year_' + data.id);
                $(e).find('#spanYear_').attr('id', 'spanYear_' + data.id);

                $('#divInput_Year_' + data.id).hide();
                $('#spanYear_' + data.id).text(data.year);
                $('#divOutput_Year_' + data.id).show();

                //CostCenterType
                $(e).find('#divInput_CostCenterType_').attr('id', 'divInput_CostCenterType_' + data.id);
                $(e).find('#hidCostCenterTypeId_').attr('id', 'hidCostCenterTypeId_' + data.id);
                $(e).find('#inputCostCenterType_').attr('id', 'inputCostCenterType_' + data.id);
                $(e).find('#divOutput_CostCenterType_').attr('id', 'divOutput_CostCenterType_' + data.id);
                $(e).find('#spanCostCenterType_').attr('id', 'spanCostCenterType_' + data.id);

                $('#divInput_CostCenterType_' + data.id).hide();
                $('#spanCostCenterType_' + data.id).text(data.costCenterTypeDisplay);
                $('#divOutput_CostCenterType_' + data.id).show();

                //CCOtherCostsTypeType
                $(e).find('#divInput_CCOtherCostsType_').attr('id', 'divInput_CCOtherCostsType_' + data.id);
                $(e).find('#hidCCOtherCostsTypeId_').attr('id', 'hidCCOtherCostsTypeId_' + data.id);
                $(e).find('#inputCCOtherCostsType_').attr('id', 'inputCCOtherCostsType_' + data.id);
                $(e).find('#divOutput_CCOtherCostsType_').attr('id', 'divOutput_CCOtherCostsType_' + data.id);
                $(e).find('#spanCCOtherCostsType_').attr('id', 'spanCCOtherCostsType_' + data.id);

                $('#divInput_CCOtherCostsType_' + data.id).hide();
                $('#spanCCOtherCostsType_' + data.id).text(data.ccOtherCostsTypeDisplay);
                $('#divOutput_CCOtherCostsType_' + data.id).show();

                //BaseFee
                $(e).find('#divInput_Fee_').attr('id', 'divInput_Fee_' + data.id);
                $(e).find('#inputFee_').attr('id', 'inputFee_' + data.id);
                $(e).find('#divOutput_Fee_').attr('id', 'divOutput_Fee_' + data.id);
                $(e).find('#spanFee_').attr('id', 'spanFee_' + data.id);

                $('#divInput_Fee_' + data.id).hide();
                $('#spanFee_' + data.id).text(data.fee);
                $('#divOutput_Fee_' + data.id).show();

               
                //Buttons
                $(e).find('#btnEdit_').data('id', data.id);
                $(e).find('#btnDelete_').data('id', data.id);
                $(e).find('#btnSaveEdit_').data('id', data.id);
                $(e).find('#btnCancelEdit_').data('id', data.id);
                $(e).find('#btnSaveCreate_').data('id', data.id);
                $(e).find('#btnCancelCreate_').data('id', data.id);

                $(e).find('#btnEdit_').attr('id', 'btnEdit_' + data.id);
                $(e).find('#btnDelete_').attr('id', 'btnDelete_' + data.id);
                $(e).find('#btnSaveEdit_').attr('id', 'btnSaveEdit_' + data.id);
                $(e).find('#btnCancelEdit_').attr('id', 'btnCancelEdit_' + data.id);
                $(e).find('#btnSaveCreate_').attr('id', 'btnSaveCreate_' + data.id);
                $(e).find('#btnCancelCreate_').attr('id', 'btnCancelCreate_' + data.id);

                $('#btnSaveCreate_' + data.id).hide();
                $('#btnCancelCreate_' + data.id).hide();
                $('#btnEdit_' + data.id).show();
                $('#btnDelete_' + data.id).show();

                $('#inputOrg_' + data.id).select2();

                $(e).css('background-color', 'rgb(245 245 246)');
                isNewRow = false;
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function addNewRow() {
        if (isNewRow) return;

        var template = $('#rowTemplate').clone()
            .appendTo($('#my-table tbody'))
            .attr('id', 'newRow')
            .css('background-color', 'rgb(230 247 228)')
            .show();

        $('.selectOrganization:last').select2({
            dir: 'rtl'
        });

        $('.input-keyup').keyup(function (event) {
            event.preventDefault();
            if (event.keyCode === 13) {
                let row = $(this).closest('tr');
                saveNewRow(row);
            }
        });

        let newRowElement = document.getElementById('newRow');
        newRowElement.scrollIntoView();
        $('.default-input:last').focus();

        isNewRow = true;
    }

    function cancelNewRow(e) {
        $(e).closest('tr').remove();
        isNewRow = false;
    }

    function deleteRow(e, id) {
        console.log(e);

        $.ajax({
            url: '@Url.Action(CostCurrentOtherController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
                if (data.hasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data.message}</span>`,
                        type: 'error',
                        confirmButtonColor: '#2F8BE6',
                        animation: false,
                        customClass: 'animated flipInX',
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                $(e).closest('tr').remove();
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function resetTableBackColor(id) {
        var table = document.getElementById(id);
        var rows = table.getElementsByTagName("tr");
        for (i = 2; i < rows.length - 1; i++) {
            rows[i].style = "";
        }
    }

</script>