@{
    ViewData["Title"] = "طراحی گزارش";
}

<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            <i class="fa fa-print mr-1"></i>
            <span class="my-font">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-content">
                                        <div id="viewer" class="col-md-12" style="padding: 0px; direction: ltr; height: 800px;">
                                            @Html.StiNetCoreDesigner(new StiNetCoreDesignerOptions()
                                            {
                                                Actions =
                                                {
                                                    GetReport = "GetReport",
                                                    DesignerEvent = "DesignerEvent"
                                                }
                                            })

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</section>