@model ReportDisplayViewModel
@{
    ViewData["Title"] = $"گزاش {Model.Report.Title}";
}
<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            <i class="ft-settings mr-1"></i>
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>
<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <p>
                        @Html.Raw(Model.Report.Description)
                    </p>
                    <div class="card-body">

                        @*<form id="my-form"
                                asp-controller="@Report1Controller.Name"
                                asp-action="@Report1Controller.ACTION_Report"
                                method="POST"
                                data-ajax="true"
                                data-ajax-begin="dataAjaxBegin"
                                data-ajax-success="waiting('body', 'hide');"
                                data-ajax-failure="dataAjaxFailure"
                                data-ajax-update="#viewer">*@
                            <form id="my-form">
                            <input name="Id" type="hidden" value="@Model.Report.Id" />
                            <div class="form-row">
                                <div class="col-md-6 col-12">
                                    <h5>
                                       <i class="fa fa-bookmark"></i>
                                        پارامترهای گزارش
                                    </h5>
                                    @foreach(var p in Model.Report.Params) {
                                        <div class="form-group">
                                            <label class="control-label my-font">
                                                @p.Title
                                            </label>

                                            @if(p.ParamType == ReportParamType.Year) {
                                                <select name="@p.Name" class="form-control my-font" asp-items="Model.YearSource">
                                                </select>
                                            }
                                            else if(p.ParamType == ReportParamType.Organization) {
                                                <select name="@p.Name" class="form-control my-font" asp-items="Model.OrganizationSource">
                                                </select>
                                            }
                                            else if(p.ParamType == ReportParamType.County) {
                                                <select name="@p.Name" class="form-control my-font" asp-items="Model.CountySource">
                                                </select>
                                            }
                                            else if(p.ParamType == ReportParamType.City) {
                                                <select name="@p.Name" class="form-control my-font" asp-items="Model.CitySource">
                                                </select>
                                            }
                                            else if(p.ParamType == ReportParamType.Village) {
                                                <select name="@p.Name" class="form-control my-font" asp-items="Model.VillageSource">
                                                </select>
                                            }
                                    </div>
                                
                                }
                                </div>
                                <input type="hidden" name="show_report" value="@Model.DisplayReport" />
                                <div class="col-md-6 col-12">
                                    <button id="btnReport" 
                                            type="submit" 
                                            form="my-form" 
                                            class="btn btn-success my-font" 
                                            style="left: 40px;">
                                        <i class="fa fa-bolt"></i> گزارش
                                    </button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <h5>گزارش</h5>
                    <div id="viewer" class="col-md-12" style="padding: 0px; direction: ltr; height: 800px;">

                    </div>
                </div>
            </div>
        </div>
    </div>
    
</section>

@section footSection {

    <script type="text/javascript">

        $(document).ready(function() {
            $('#my-form').submit(function(e) {
                e.preventDefault();
                var form_data = $('#my-form').serialize();
                $.ajax({
                    url: '@Url.Action(ReportController.ACTION_Report, ReportController.Name, new { id = Model.Report.Id })' ,
                    type: 'POST',
                    data: form_data,
                    success: function(data, status, settings) {
                        $('#viewer').html(data);
                    },
                    error: function() {

                    }
                })
            });
        });

    </script>

}