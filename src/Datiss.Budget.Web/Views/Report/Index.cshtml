@model ReportIndexViewModel
@{
    ViewData["Title"] = "گزارشات سامانه";
    int i = ((@Model.PageNumber-1)*@Model.PageSize)+1;
}
<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            @*<i class="ft-settings mr-1"></i>*@
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>

<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <form id="my-form"
                              asp-controller="@ReportController.Name"
                              asp-action="@ReportController.ACTION_Index"
                              asp-antiforgery="true">

                            <input type="hidden" asp-for="Filter.PageNumber" />
                                <fieldset class="form-group position-relative has-icon-left">
                                    <input asp-for="Filter.Search" id="ngx-filter-ref" type="text" placeholder="جستجو..." class="form-control-lg form-control d-inline-block my-custom-input my-font">
                                    <div class="form-control-position">
                                        <i class="ft-search font-medium-4"></i>
                                    </div>
                                </fieldset>
                        </form>

                        <div class="row table-responsive">
                            <table style="width: 100%;" id="my-table" class="table table-hover table-card-bordered m-0 my-font">
                                @*<thead class="thead-light">

                                    </thead>*@
                                @foreach (var item in Model.Items) {
                                    <tr>
                                        <td class="text-nowrap">
                                            <span>@i -  </span>
                                            @{
                                                i = i + 1;
                                            }
                                            <span>
                                               @item.Title
                                            </span>
                                        </td>
                                        <td class="text-nowrap last-td-transparent">
                                            <a asp-controller="@ReportController.Name"
                                           asp-action="@ReportController.ACTION_Report"
                                           asp-route-id="@item.Id"
                                           class="btn bg-light-info btn-info" >
                                                <i class=""></i> مشاهده گزارش
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </table>
                          <div class="rowACJSB" style="margin-top:20px">
                                <div class="rowAC">
                                    <div class="my-font">کل رکوردها: <b class="font-medium-2">@Model.TotalCount</b></div>
                                    <div class="my-font ml-2">
                                        (صفحه <b class="font-medium-2">@Model.PageNumber</b> از
                                        <b class="font-medium-2">
                                            @if (Model.PagesCount == 0)
                                            {
                                                <span>1</span>
                                            }
                                            else
                                            {
                                                <span>@Model.PagesCount</span>
                                            }
                                        </b>)
                                    </div>
                                </div>
                                <!--Pagination-->
                                <vc:pager model="Model.ToPager()" controller-name="@ReportController.Name" action-name="@ReportController.ACTION_Index"></vc:pager>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


