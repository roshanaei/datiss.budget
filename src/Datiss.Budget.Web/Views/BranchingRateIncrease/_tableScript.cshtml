    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.userTypeId = $('#inputUserType_' + id).val();
        model.waterRateIncrease = $('#inputWaterRateIncrease_' + id).val();
        model.wasteRateIncrease = $('#inputWasteRateIncrease_' + id).val();
        model.wastePersentIncrease = $('#inputWastePersentIncrease_' + id).val();
        model.fixAmountBusiness = $('#inputFixAmountBusiness_' + id).val();
        model.capacityFixAmount = $('#inputCapacityFixAmount_' + id).val();
        model.waterInstallRateIncrease = $('#inputWaterInstallRateIncrease_' + id).val();
        model.wsInstalIncrease = $('#inputWsInstalIncrease_' + id).val();
        model.waterFixNote2 = $('#inputWaterFixNote2_' + id).val();
        model.wasteFixNote2 = $('#inputWasteFixNote2_' + id).val();

        console.log(model);

        $.ajax({
            url: '@Url.Action(WaterInstallFeeController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }
                console.log(data);

                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanUserType_' + id).text(data.userTypeDisplay);
                $('#spanWaterRateIncrease_' + id).text(data.waterRateIncrease);
                $('#spanWasteRateIncrease_' + id).text(data.wasteRateIncrease);
                $('#spanWastePersentIncrease_' + id).text(data.wastePersentIncrease);
                $('#spanFixAmountBusiness_' + id).text(data.fixAmountBusiness);
                $('#spanCapacityFixAmount_' + id).text(data.capacityFixAmount);
                $('#spanWaterInstallRateIncrease_' + id).text(data.waterInstallRateIncrease);
                $('#spanWsInstalIncrease_' + id).text(data.wsInstalIncrease);
                $('#spanWaterFixNote2_' + id).text(data.waterFixNote2);
                $('#inputWasteFixNote2_' + id).text(data.wasteFixNote2);

                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                alert('خطا در بروز رسانی اطلاعات. لطفاً دوباره سعی نمایید!');
            }
        });
    }

