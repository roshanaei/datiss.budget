@model CreateFinanceYearViewModel


<!--Modals-->
<div class="modal fade text-left" id="CreateModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel2" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title my-font" id="myModalLabel2">سال مالی جدید</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="ft-x font-medium-2 text-bold-700"></i></span>
                </button>
            </div>
            <form id="financeYearForm">
                <div class="modal-body">
                    <div class="rowAC">
                        @*<div class="my-font">
                                <fieldset class="form-group">
                                    <label class="my-font rowAC">
                                        <span style="margin-left:5px"> عنوان:</span>
                                        <input asp-for="Title" type="text" class="form-control form-control-sm d-inline-block" />
                                    </label>
                                </fieldset>
                            </div>*@
                        <div class="my-font" style="flex:0.25" />
                        <fieldset class="form-group">
                            <label class="my-font rowAC">
                                <span style="margin-left:5px">سال به عدد:</span>
                                <input asp-for="Year" type="number" class="form-control form-control-sm d-inline-block" />
                            </label>
                        </fieldset>
                    </div>
                    <div class="rowAC">
                        <div class="my-font">
                            <fieldset class="form-group">
                                <label class="my-font rowAC">
                                    <span style="margin-left:5px">شروع سال:</span>
                                    <input asp-for="StartPersianDate" class="form-control form-control-sm d-inline-block" autocomplete="off" datepicker="datepicker" />
                                </label>
                            </fieldset>
                        </div>
                        <div class="my-font" style="flex:0.25" />
                        <div class="form-group">
                            <label class="my-font rowAC">
                                <span style="margin-left:5px">شروع سال:</span>
                                <input asp-for="EndPrsianDate" class="form-control form-control-sm d-inline-block" autocomplete="off" datepicker="datepicker" />
                            </label>
                        </div>
                    </div>


                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary bg-light-secondary mr-1 my-font" data-dismiss="modal">انصراف</button>
                    <button id="btnDoCreate" type="button" class="btn btn-warning bg-light-warning mr-1 my-font">ثبت</button>
                </div>
            </form>

        </div>
    </div>
</div>
<!--Modals-->

<script type="text/javascript">

    $(document).ready(function () {
        $("#financeYearForm [datepicker]").datepicker({
            isRTL: true,
            dateFormat: "yy/m/d"
        });
    });
</script>