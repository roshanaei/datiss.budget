@model FinanceYearIndexViewModel
@{ ViewData["Title"] = "سال"; }

<!--Title-->
<div class="row">
    <div class="col-12">
        <div class="content-header">
            @*<i class="ft-settings mr-1"></i>*@
            <span class="my-font-bold">@ViewData["Title"]</span>
        </div>
    </div>
</div>
<section>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-content">
                    <div class="card-body">
                        <form method="post" class="rowACJSB" asp-controller="FinanceYear" asp-action="Index" asp-antiforgery="true">
                            <fieldset class="form-group mt-3">
                                @*<input asp-for="Filter.OrderBy" type="hidden" />
                                <input asp-for="Filter.OrderDesc" type="hidden" />*@
                            </fieldset>
                            <fieldset>
                                <div class="rowACJE">
                                    <button data-toggle="tooltip" data-placement="top" title="رکورد جدید" type="submit" name="btnCreate" class="btn btn-success bg-light-success my-font">
                                        <i _ngcontent-dpj-c129="" class="fa fa-plus-square"></i>
                                    </button>
                                </div>
                            </fieldset>
                        </form>
                        <hr />
                        <!--SearchBox-->
                        <div class="rowACJSB">
                            <div class="rowAC" style="flex:1">
                                <fieldset class="form-group">
                                    <label for="ngx-filter-ref" class="my-font">
                                        جستجو:
                                        <input id="ngx-filter-ref" type="text" placeholder="..." class="form-control form-control-sm d-inline-block width-200">
                                    </label>
                                </fieldset>
                                <fieldset class="form-group" style="margin-right:10px">
                                    <label class="my-font rowAC">
                                        <span>نمایش</span>

                                        <select style="margin-right:10px" class="form-control" id="basicSelect">
                                            <option>10</option>
                                            <option>20</option>
                                            <option>30</option>
                                        </select>
                                        <span style="margin-right:10px">رکورد</span>

                                    </label>
                                </fieldset>
                            </div>
                        </div>
                        <!--DataTable-->
                        <div class="table-responsive">
                             <table id="" class=" table table-hover table-bordered m-0 my-font">
                                <thead class="thead-light">
                                    <tr>
                                        <th>عنوان</th>
                                        <th>سال</th>
                                        <th>تاریخ شروع</th>
                                        <th>تاریخ پایان</th>
                                        <th>وضعیت</th>
                                        <th>مدیریت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @*@foreach (var item in Model.Model.Items){
                                        <tr>
                                            <td>@item.Title</td>
                                            <td>@item.Year.ToString()</td>
                                            <td>@item.StartDate.ToString() </td>
                                            <td>@item.EndDate.ToString() </td>
                                            <td>@item.Status.ToString() </td>
                                            <td>
                                                <a asp-controller="FinanceYear" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a>
                                            </td>
                                        </tr> }*@
                                </tbody>
                             </table>
                             <div class="rowACJSB" style="margin-top:20px">
                                 <!--Tools-->
                                 <div class="rowACJS">
                                        <form id="toolForm"
                                              enctype="multipart/form-data"
                                              method="post"
                                              asp-antiforgery="true">
                                        </form>
                                    </div>
                                 <!--Pagination-->
                                 @*<p>Total count : @Model.Model.TotalCount - Page @Model.Model.PageNumber of @Model.Model.PagesCount</p>*@
                                 @if (Model.Model.PagesCount > 1) 
                                  {
                                      <nav aria-label="Page navigation">
                                          <ul class="pagination justify-content-center">
                                              @if (Model.Model.PageNumber > 1){
                                                   <li class="page-item">
                                                       <a class="page-link"
                                                           asp-controller="FinanceYear"
                                                           asp-action="Index"
                                                           asp-route-page="@Model.Model.PreviousPage"
                                                           aria-label="Previous">«
                                                       </a>
                                                   </li>}
                                               @for (int i = 1; i <= Model.Model.PagesCount; i++) {
                                                    if (i == Model.Model.PageNumber)
                                                    {
                                                        <li class="page-item active">
                                                            <a class="page-link" href="#">@i.ToString() </a>
                                                        </li>
                                                    }
                                                    else
                                                    {
                                                        <li class="page-item">
                                                            <a class="page-link"
                                                               asp-controller="FinanceYear"
                                                               asp-action="Index"
                                                               asp-route-page="@i">@i.ToString() </a>
                                                        </li>
                                                    }
                                                }
                                                @if (Model.Model.PageNumber < Model.Model.PagesCount)
                                                {
                                                    <li class="page-item">
                                                        <a class="page-link"
                                                           asp-controller="FinanceYear"
                                                           asp-action="Index"
                                                           asp-route-page="@Model.Model.NextPage"
                                                           aria-label="Next">»</a>
                                                    </li>
                                                }
                                            </ul>
                                      </nav>
                                  }
                             </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>