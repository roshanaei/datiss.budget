                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanUserType_' + id).text(data.userTypeDisplay);
                $('#spanUsageLayerType_' + id).text(data.usageLayerDisplay);
                $('#spanNumberUser_' + id).text(data.numberUser);
                $('#spanUnitUser_' + id).text(data.unitUser);
                $('#spanCost_' + id).text(data.cost);
                $('#spanAvgConsumeUser_' + id).text(data.avgConsumeUser);
                $('#spanConsumptionUser_' + id).text(data.consumptionUser);
                $('#spanIncome_' + id).text(data.income);
                $('#spanSubscriptionIncome_' + id).text(data.subscriptionIncome);
                $('#spanSeasonalIncome_' + id).text(data.seasonalIncome);
                $('#spanTIncome_' + id).text(data.tIncome);
                $('#spanNote3Price_' + id).text(data.note3Price);
                $('#spanNote3Income_' + id).text(data.note3Income);
                $('#spanDiff_ConsWsVolume_' + id).text(data.diff_ConsWsVolume);
                $('#spanNote2Income_' + id).text(data.note2Income);
