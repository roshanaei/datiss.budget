        model.note3Income = $('#inputNote3Income_' + id).val();
        model.diff_ConsWsVolume = $('#inputDiff_ConsWsVolume_' + id).val();
        model.note2Income = $('#inputNote2Income_' + id).val();
        model.wasteVolume = $('#inputWasteVolume_' + id).val();



        $.ajax({
            url: '@Url.Action(IncomeCurrentWHController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }

                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.userTypeId = model.userTypeId;
                rowData.usageLayerId = model.usageLayerId;
                rowData.numberUser = model.numberUser;
                rowData.unitUser = model.unitUser;
                rowData.cost = model.cost;
                rowData.avgConsumeUser = model.avgConsumeUser;
                rowData.consumptionUser = model.consumptionUser;
                rowData.income = model.income;
                rowData.subscriptionIncome = model.subscriptionIncome;
                rowData.seasonalIncome = model.seasonalIncome;
                rowData.tIncome = model.tIncome;
                rowData.note3Price = model.note3Price;
                rowData.note3Income = model.note3Income;
                rowData.diff_ConsWsVolume = model.diff_ConsWsVolume;
                rowData.note2Income = model.note2Income;
                rowData.wasteVolume = model.wasteVolume;

