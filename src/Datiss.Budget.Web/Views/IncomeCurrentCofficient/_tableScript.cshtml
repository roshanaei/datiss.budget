<script type="text/javascript">

    let isNewRow = false;
    let rowData = {};

    function editRow(id) {

        let userTypeId = $('#inputUserType_' + id).val();
        let usageLayerTypeId = $('#inputUsageLayerType_' + id).val();
        console.log(userTypeId);
        console.log(usageLayerTypeId);
        FillDropDown(userTypeId, usageLayerTypeId);
        
        resetTableBackColor("my-table");

        let row = $('#row_' + id);

        //Hide output elements
        $('#divOutput_Year_' + id).hide();
        $('#divOutput_Org_' + id).hide();
        $('#divOutput_UserType_' + id).hide();
        $('#divOutput_UsageLayerType_' + id).hide();
        $('#divOutput_Fee_' + id).hide();
        $('#divOutput_FeeWs_' + id).hide();


        //show input elements
        $('#divInput_Year_' + id).show();
        $('#divInput_Org_' + id).show();
        $('#divInput_UserType_' + id).show();
        $('#divInput_UsageLayerType_' + id).show();
        $('#divInput_Fee_' + id).show();
        $('#divInput_FeeWs_' + id).show();



        $('#btnEdit_' + id).hide();
        $('#btnDelete_' + id).hide();
        $('#btnSaveEdit_' + id).show();
        $('#btnCancelEdit_' + id).show();

        rowData = {};
        rowData.yearId = $('#inputYear_' + id).val();
        rowData.organizationId = $('#inputOrg_' + id).val();
        rowData.userTypeId = $('#inputUserType_' + id).val();
        rowData.usageLayerTypeId = $('#inputUsageLayerType_' + id).val();
        rowData.usageLayerTypeId = $('#inputUsageLayerType_' + id).val();
        rowData.fee = $('#inputFee_' + id).val();
        rowData.feeWs = $('#inputFeeWs_' + id).val();

    }

    function cancelEditRow(id) {
        let row = $('#row_' + id);
        //row.css('background-color', '');

        //Hide input elements
        $('#divInput_Year_' + id).hide();
        $('#divInput_Org_' + id).hide();
        $('#divInput_UserType_' + id).hide();
        $('#divInput_UsageLayerType_' + id).hide();
        $('#divInput_Fee_' + id).hide();
        $('#divInput_FeeWs_' + id).hide();


        //Retriving to OrginalData
        if (rowData != null) {
            $('#inputYear_' + id).val(rowData.yearId);
            $('#inputOrg_' + id).val(rowData.organizationId);
            $('#inputUserType_' + id).val(rowData.userTypeId);
            $('#inputUsageLayerType_' + id).val(rowData.usageLayerTypeId);
            $('#inputFee_' + id).val(rowData.fee);
            $('#inputFeeWs_' + id).val(rowData.feeWs);

        }

        //Show output elements
        $('#divOutput_Year_' + id).show();
        $('#divOutput_Org_' + id).show();
        $('#divOutput_UserType_' + id).show();
        $('#divOutput_UsageLayerType_' + id).show();
        $('#divOutput_Fee_' + id).show();
        $('#divOutput_FeeWs_' + id).show();


        $('#btnEdit_' + id).show();
        $('#btnDelete_' + id).show();
        $('#btnSaveEdit_' + id).hide();
        $('#btnCancelEdit_' + id).hide();
        $('th,tr td').hide();
        showingColmuns.split(',').forEach((value, index) => {
            if (value !== '') {
                $(`th:nth-child(${value}), tr td:nth-child(${value})`).show();
            }
        })
        $(`th:last-child, tr td:last-child`).show();

    }

    function saveEditRow(id) {
        let row = $('#row_' + id);

        var model = {};
        model.id = id;
        model.yearId = $('#inputYear_' + id).val();
        model.organizationId = $('#inputOrg_' + id).val();
        model.userTypeId = $('#inputUserType_' + id).val();
        model.usageLayerId = $('#inputUsageLayerType_' + id).val();
        model.fee = $('#inputFee_' + id).val();
        model.feeWs = $('#inputFeeWs_' + id).val();



        $.ajax({
            url: '@Url.Action(IncomeCurrentCofficientController.ACTION_Edit)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                        Swal.fire({
                            title: '<span class="my-font">خطا</span>',
                            html: `<span class="my-font">${data._ErrorMessage}</span>`,
                            type: 'error',
                            animation: false,
                            confirmButtonText: 'بستن',
                            confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                            buttonsStyling: false,
                        });
                        return;
                }
                console.log(data);


                rowData = {};
                rowData.yearId = model.yearId;
                rowData.organizationId = model.organizationId;
                rowData.userTypeId = model.userTypeId;
                rowData.usageLayerTypeId = model.usageLayerId;
                rowData.fee = model.fee;
                rowData.feeWs = model.feeWs;


                $('#hidYearId_' + id).attr('value', model.yearId);
                $('#hidOrgId_' + id).attr('value', model.organizationId);
                $('#spanOrg_' + id).text(data.organizationDisplay);
                $('#spanYear_' + id).text(data.year);
                $('#spanUserType_' + id).text(data.userTypeTitle);
                $('#spanUsageLayerType_' + id).text(data.usageLayerTitle);
                $('#spanFee_' + id).text(data.fee);
                $('#spanFeeWs_' + id).text(data.feeWs);

                $('#row_' + id).css('background-color', 'rgb(245 245 246)');

                cancelEditRow(id);
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function saveNewRow(e) {

        resetTableBackColor("my-table");

        var model = {};
        model.yearId = $(e).find('#inputYear_').val();
        model.organizationId = $(e).find('#inputOrg_').val();
        model.userTypeId = $(e).find('#inputUserType_').val();
        model.usageLayerId = $(e).find('#inputUsageLayerType_').val();
        model.fee = $(e).find('#inputFee_').val();
        if (model.fee == "") {
            model.fee = 0;
        }

        model.feeWs = $(e).find('#inputFeeWs_').val();
        if (model.feeWs == "") {
            model.feeWs = 0;
        }

        console.log(model);

        $.ajax({
            url: '@Url.Action(IncomeCurrentCofficientController.ACTION_Create)',
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function (data, status, settings) {
                if (data._HasError) {
                    Swal.fire({
                        title: '<span class="my-font">خطا</span>',
                        html: `<span class="my-font">${data._ErrorMessage}</span>`,
                        type: 'error',
                        animation: false,
                        confirmButtonText: 'بستن',
                        confirmButtonClass: 'btn btn-outline-danger mr-1 my-font',
                        buttonsStyling: false,
                    });
                    return;
                }

                console.log(data);

                //Year
                $(e).find('#divInput_Year_').attr('id', 'divInput_Year_' + data.id);
                $(e).find('#hidYearId_').attr('id', 'hidYearId_' + data.id);
                $(e).find('#inputYear_').attr('id', 'inputYear_' + data.id);
                $(e).find('#divOutput_Year_').attr('id', 'divOutput_Year_' + data.id);
                $(e).find('#spanYear_').attr('id', 'spanYear_' + data.id);

                $('#divInput_Year_' + data.id).hide();
                $('#spanYear_' + data.id).text(data.year);
                $('#divOutput_Year_' + data.id).show();

                //Organization
                $(e).find('#divInput_Org_').attr('id', 'divInput_Org_' + data.id);
                $(e).find('#hidOrgId_').attr('id', 'hidOrgId_' + data.id);
                $(e).find('#inputOrg_').attr('id', 'inputOrg_' + data.id);
                $(e).find('#divOutput_Org_').attr('id', 'divOutput_Org_' + data.id);
                $(e).find('#spanOrg_').attr('id', 'spanOrg_' + data.id);

                $('#divInput_Org_' + data.id).hide();
                $('#spanOrg_' + data.id).text(data.organizationDisplay);
                $('#divOutput_Org_' + data.id).show();

                //UserType
                $(e).find('#divInput_UserType_').attr('id', 'divInput_UserType_' + data.id);
                $(e).find('#hidUserTypeId_').attr('id', 'hidUserTypeId_' + data.id);
                $(e).find('#inputUserType_').attr('id', 'inputUserType_' + data.id);
                $(e).find('#divOutput_UserType_').attr('id', 'divOutput_UserType_' + data.id);
                $(e).find('#spanUserType_').attr('id', 'spanUserType_' + data.id);

                $('#divInput_UserType_' + data.id).hide();
                $('#spanUserType_' + data.id).text(data.userTypeTitle);
                $('#divOutput_UserType_' + data.id).show();


                //UsageLayerType
                $(e).find('#divInput_UsageLayerType_').attr('id', 'divInput_UsageLayerType_' + data.id);
                $(e).find('#hidUsageLayerTypeId_').attr('id', 'hidUsageLayerTypeId_' + data.id);
                $(e).find('#inputUsageLayerType_').attr('id', 'inputUsageLayerType_' + data.id);
                $(e).find('#divOutput_UsageLayerType_').attr('id', 'divOutput_UsageLayerType_' + data.id);
                $(e).find('#spanUsageLayerType_').attr('id', 'spanUsageLayerType_' + data.id);

                $('#divInput_UsageLayerType_' + data.id).hide();
                $('#spanUsageLayerType_' + data.id).text(data.usageLayerTitle);
                $('#divOutput_UsageLayerType_' + data.id).show();

                //Fee
                $(e).find('#divInput_Fee_').attr('id', 'divInput_Fee_' + data.id);
                $(e).find('#inputFee_').attr('id', 'inputFee_' + data.id);
                $(e).find('#divOutput_Fee_').attr('id', 'divOutput_Fee_' + data.id);
                $(e).find('#spanFee_').attr('id', 'spanFee_' + data.id);

                $('#divInput_Fee_' + data.id).hide();
                $('#spanFee_' + data.id).text(data.fee);
                $('#divOutput_Fee_' + data.id).show();      
                

                //FeeWs
                $(e).find('#divInput_FeeWs_').attr('id', 'divInput_FeeWs_' + data.id);
                $(e).find('#inputFeeWs_').attr('id', 'inputFeeWs_' + data.id);
                $(e).find('#divOutput_FeeWs_').attr('id', 'divOutput_FeeWs_' + data.id);
                $(e).find('#spanFeeWs_').attr('id', 'spanFeeWs_' + data.id);

                $('#divInput_Fee_' + data.id).hide();
                $('#spanFee_' + data.id).text(data.fee);
                $('#divOutput_Fee_' + data.id).show(); 

                //Buttons
                $(e).find('#btnEdit_').data('id', data.id);
                $(e).find('#btnDelete_').data('id', data.id);
                $(e).find('#btnSaveEdit_').data('id', data.id);
                $(e).find('#btnCancelEdit_').data('id', data.id);
                $(e).find('#btnSaveCreate_').data('id', data.id);
                $(e).find('#btnCancelCreate_').data('id', data.id);

                $(e).find('#btnEdit_').attr('id', 'btnEdit_' + data.id);
                $(e).find('#btnDelete_').attr('id', 'btnDelete_' + data.id);
                $(e).find('#btnSaveEdit_').attr('id', 'btnSaveEdit_' + data.id);
                $(e).find('#btnCancelEdit_').attr('id', 'btnCancelEdit_' + data.id);
                $(e).find('#btnSaveCreate_').attr('id', 'btnSaveCreate_' + data.id);
                $(e).find('#btnCancelCreate_').attr('id', 'btnCancelCreate_' + data.id);

                $('#btnSaveCreate_' + data.id).hide();
                $('#btnCancelCreate_' + data.id).hide();
                $('#btnEdit_' + data.id).show();
                $('#btnDelete_' + data.id).show();

                $('#inputOrg_' + data.id).select2();
                $(e).css('background-color', 'rgb(245 245 246)');
                isNewRow = false;
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function addNewRow() {
        if (isNewRow) return;

        resetTableBackColor("my-table");

        let usertypeid = $('#inputUserType_').val();
        FillDropDown(usertypeid);
        

        var template = $('#rowTemplate').clone()
            .appendTo($('#my-table tbody'))
            .attr('id', 'newRow')
            .css('background-color', 'rgb(230 247 228)')
            .show();

        $('.selectOrganization:last').select2({
            dir: 'rtl'
        });

        $('.input-keyup').keyup(function (event) {
            event.preventDefault();
            if (event.keyCode === 13) {
                let row = $(this).closest('tr');
                saveNewRow(row);
            }
        });

        let newRowElement = document.getElementById('newRow');
        newRowElement.scrollIntoView();
        $('.default-input:last').focus();

        isNewRow = true;
    }

    function cancelNewRow(e) {
        $(e).closest('tr').remove();
        isNewRow = false;
    }

    function deleteRow(e, id) {
        console.log(e);

        $.ajax({
            url: '@Url.Action(IncomeCurrentCofficientController.ACTION_Delete)' + '/' + id,
            type: 'POST',
            success: function (data, status, settings) {
                if (data.hasError) {
                    alert(data.message);
                    return;
                }

                $(e).closest('tr').remove();
            },
            error: function (request, options, err) {
                if (request.status == 401 || request.status == 403) {
                    ShowPermissionErorr();
                    return;
                }
                ShowCommonErorr();
            }
        });
    }

    function resetTableBackColor(id) {
        var table = document.getElementById(id);
        var rows = table.getElementsByTagName("tr");
        for (i = 2; i < rows.length - 1; i++) {
            rows[i].style = "";
        }
    }

    function RelatedDropDown(e, event) {
        let usertypeid = event.target.value;
        FillDropDown(usertypeid);
    }

    function FillDropDown(id, selectval = null) {

        let key = userType_source[id];
        if (key != 'UserType.House') {
            key = 'UsageLayer';
        }

        $.ajax({
            url: '@Url.Action("GetUsageLayerAsync")',
            type: 'POST',
            dataType: 'json',
            data: {
                'key': key
                }
        }).done(function (data) {
            var options = $('.selectUsageLayerType');
            options.empty();
            $.each(data,
                function (i, item) {
                    options.append($('<option />')
                        .val(item.id)
                        .text(item.title));
                });
            if (selectval != null) {
                options.val(selectval);
            }
        }).fail(function (error) {
            alert(error);
        });
    }


</script>